datasource db {
  provider = "sqlite"
  url      = "file:/tmp/prisma_orm_bench.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String
  age      Int
  isActive Boolean @map("is_active")

  @@map("auth_users")
}
