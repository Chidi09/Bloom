---
import { Code } from 'astro:components';
import { Copy, Terminal, FileCode } from 'lucide-preact';

interface Props {
  code: string;
  lang?: 'dart' | 'bash' | 'json' | 'yaml';
  filename?: string;
  className?: string;
}

const { code, lang = 'dart', filename, className = '' } = Astro.props;
---

<div class={`rounded-2xl border border-slate-800/80 bg-[#0B0F19] overflow-hidden shadow-2xl transition-all group ${className}`}>
  <!-- Header Bar -->
  <div class="px-4 py-2.5 bg-[#0e1424] border-b border-slate-800/80 flex items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-2 font-mono text-slate-400">
      {lang === 'bash' ? (
        <Terminal className="w-3.5 h-3.5 text-purple-400 shrink-0" />
      ) : (
        <FileCode className="w-3.5 h-3.5 text-cyan-400 shrink-0" />
      )}
      <span class="font-bold text-slate-200 text-xs font-mono truncate">
        {filename || (lang === 'bash' ? 'Terminal' : `${lang.toUpperCase()} snippet`)}
      </span>
    </div>

    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-slate-800/80 text-purple-300 border border-purple-500/20">
        {lang}
      </span>
      <button
        onclick={`navigator.clipboard.writeText(\`${code.trim()}\`); window.dispatchEvent(new CustomEvent('bloom:toast', { detail: { title: 'Code Copied', message: 'Ready to paste in editor.', type: 'emerald' } }))`}
        class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition font-mono text-[11px] font-medium border border-slate-700/50"
        title="Copy Code"
      >
        <Copy className="w-3 h-3 text-purple-400" />
        <span>Copy</span>
      </button>
    </div>
  </div>

  <!-- Code Body with Shiki -->
  <div class="p-4 font-mono text-xs overflow-x-auto leading-relaxed scrollbar-thin text-slate-100 [&_pre]:!bg-transparent [&_pre]:!p-0 [&_pre]:!m-0 [&_code]:!font-mono [&_code]:!text-[13px] [&_code]:!leading-6">
    <Code code={code.trim()} lang={lang} theme="one-dark-pro" />
  </div>
</div>
