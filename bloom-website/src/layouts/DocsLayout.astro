---
import Layout from './Layout.astro';
import { UI_REGISTRY, UI_CATEGORIES } from '../lib/ui-registry';
import { 
  ChevronRight, 
  Terminal, 
  Layers, 
  Code2, 
  Sparkles, 
  Cpu, 
  Database, 
  Workflow, 
  ShieldCheck, 
  Server, 
  Sliders, 
  Smartphone, 
  FolderTree, 
  Zap,
  Boxes,
  Palette,
  FileText,
  Bot,
  Copy,
  ExternalLink,
  Radio,
  Activity,
  Cloud
} from 'lucide-preact';

interface Props {
  title: string;
  description: string;
  currentSlug?: string;
  category?: string;
  toc?: { id: string; title: string }[];
}

const {
  title,
  description,
  currentSlug = '',
  category = 'Documentation',
  toc = [],
} = Astro.props;

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.replace(/\/$/, '') || '';
const pageMarkdownPath = normalizedPath === '' ? '/index.md' : `${normalizedPath}.md`;

// Determine active scope: 'client' | 'server' | 'cloud' | 'ui'
let activeScope: 'client' | 'server' | 'cloud' | 'ui' = 'client';

if (
  currentPath.startsWith('/ui') ||
  currentPath.startsWith('/blocks') ||
  currentPath.startsWith('/themes') ||
  ['introduction', 'installation', 'theming', 'typography', 'changelog'].includes(currentSlug)
) {
  activeScope = 'ui';
} else if (
  currentPath.startsWith('/docs/server') ||
  currentPath.startsWith('/docs/adapters') ||
  currentSlug.startsWith('server-') ||
  currentSlug.startsWith('adapters-')
) {
  activeScope = 'server';
} else if (
  currentPath.startsWith('/docs/cloud') ||
  currentPath.startsWith('/docs/cli') ||
  currentPath.startsWith('/docs/dev-experience') ||
  currentSlug.startsWith('cloud-') ||
  currentSlug.startsWith('cli') ||
  currentSlug.startsWith('dev-')
) {
  activeScope = 'cloud';
} else {
  activeScope = 'client';
}

const isUIMode = activeScope === 'ui';

// ==========================================
// 1. UI Scope Navigation
// ==========================================
const uiGettingStarted = [
  { title: 'Introduction', href: '/docs/introduction', slug: 'introduction' },
  { title: 'Installation', href: '/docs/installation', slug: 'installation' },
  { title: 'Theming & Tokens', href: '/docs/theming', slug: 'theming' },
  { title: 'Typography', href: '/docs/typography', slug: 'typography' },
  { title: 'Changelog', href: '/docs/changelog', slug: 'changelog' },
];

const uiBlocksAndThemes = [
  { title: 'Application Blocks', href: '/blocks', slug: 'blocks', icon: Boxes },
  { title: 'Theme Generator', href: '/themes', slug: 'themes', icon: Palette },
  { title: 'Components Gallery', href: '/ui', slug: 'ui', icon: Layers },
];

// ==========================================
// 2. Client / App Scope Navigation (Flutter & Web)
// ==========================================
const clientNavSections = [
  {
    title: 'Getting Started',
    items: [
      { title: '5-Minute Quickstart', href: '/docs/framework/quickstart', slug: 'framework-quickstart' },
      { title: 'Project Anatomy', href: '/docs/getting-started/project-anatomy', slug: 'getting-started-project-anatomy' },
      { title: 'bloom.yaml Reference', href: '/docs/getting-started/bloom-yaml-reference', slug: 'getting-started-bloom-yaml-reference' },
    ],
  },
  {
    title: 'Runtime & Architecture',
    items: [
      { title: 'Boot & Lifecycle', href: '/docs/runtime/boot-lifecycle', slug: 'framework-boot' },
      { title: 'Config & Environment', href: '/docs/runtime/config-and-env', slug: 'runtime-config-and-env' },
      { title: 'Filesystem Routing', href: '/docs/runtime/filesystem-routing', slug: 'framework-routing' },
      { title: 'Signals Reactivity', href: '/docs/runtime/signals-and-controllers', slug: 'framework-signals' },
      { title: 'Dependency Injection', href: '/docs/runtime/dependency-injection', slug: 'framework-di' },
      { title: 'Structured Logging', href: '/docs/runtime/logging', slug: 'runtime-logging' },
    ],
  },
  {
    title: 'Client Data Layer & SWR',
    items: [
      { title: 'Data Architecture', href: '/docs/framework/data', slug: 'framework-data' },
      { title: 'Queries & SWR Cache', href: '/docs/data/queries', slug: 'data-queries' },
      { title: 'Mutations & Rollback', href: '/docs/data/mutations', slug: 'data-mutations' },
      { title: 'Cache & Garbage Collection', href: '/docs/data/cache-and-garbage-collection', slug: 'data-cache-and-garbage-collection' },
      { title: 'HTTP Client', href: '/docs/data/http-client', slug: 'data-http-client' },
      { title: 'Offline Queue', href: '/docs/data/offline-queue', slug: 'data-offline-queue' },
      { title: 'Storage Adapters', href: '/docs/data/storage-adapters', slug: 'data-storage-adapters' },
      { title: 'Client Auth Primitives', href: '/docs/data/authentication', slug: 'data-authentication' },
      { title: 'Typed Repositories', href: '/docs/data/repositories', slug: 'data-repositories' },
    ],
  },
  {
    title: 'Native & Prebuild',
    items: [
      { title: 'Prebuild & Native Sync', href: '/docs/native/prebuild-engine', slug: 'framework-native' },
      { title: 'Permissions', href: '/docs/native/permissions', slug: 'native-permissions' },
      { title: 'Deep Links', href: '/docs/native/deep-links', slug: 'native-deep-links' },
      { title: 'Flavors & Schemes', href: '/docs/native/flavors', slug: 'native-flavors' },
      { title: 'Native Plugins', href: '/docs/native/plugins', slug: 'native-plugins' },
    ],
  },
];

// ==========================================
// 3. Bloom Server Scope Navigation (Backend & ORM)
// ==========================================
const serverNavSections = [
  {
    title: 'Server Architecture',
    items: [
      { title: 'Bloom Server Overview', href: '/docs/server/overview', slug: 'server-overview' },
      { title: 'Scaffolding a Server', href: '/docs/server/scaffolding', slug: 'server-scaffolding' },
    ],
  },
  {
    title: 'Database & ORM Layer',
    items: [
      { title: 'ORM & Migrations', href: '/docs/server/orm-and-migrations', slug: 'server-orm-and-migrations' },
    ],
  },
  {
    title: 'Auth, Validation & Security',
    items: [
      { title: 'Server Authentication', href: '/docs/server/auth', slug: 'server-auth' },
      { title: 'Validation & Errors', href: '/docs/server/validation-and-errors', slug: 'server-validation-and-errors' },
      { title: 'i18n & Security Headers', href: '/docs/server/i18n-and-security', slug: 'server-i18n-and-security' },
    ],
  },
  {
    title: 'REST APIs & Realtime',
    items: [
      { title: 'REST ViewSets (DRF-style)', href: '/docs/server/rest-api', slug: 'server-rest-api' },
      { title: 'HTML Admin Panel', href: '/docs/server/admin-panel', slug: 'server-admin-panel' },
      { title: 'Realtime Cluster & WS', href: '/docs/server/realtime', slug: 'server-realtime' },
    ],
  },
  {
    title: 'Operations & Infrastructure',
    items: [
      { title: 'Response & DB Caching', href: '/docs/server/caching', slug: 'server-caching' },
      { title: 'Jobs, Mail & Storage', href: '/docs/server/jobs-mail-and-storage', slug: 'server-jobs-mail-and-storage' },
    ],
  },
  {
    title: 'Backend Adapters',
    items: [
      { title: 'Adapters Overview', href: '/docs/framework/adapters', slug: 'framework-adapters' },
      { title: 'Supabase Adapter', href: '/docs/adapters/supabase', slug: 'adapters-supabase' },
      { title: 'Serverpod Adapter', href: '/docs/adapters/serverpod', slug: 'adapters-serverpod' },
    ],
  },
];

// ==========================================
// 4. Cloud & CLI Scope Navigation
// ==========================================
const cloudNavSections = [
  {
    title: 'CLI Tooling',
    items: [
      { title: 'CLI Overview', href: '/docs/cli', slug: 'cli' },
      { title: 'Master Commands', href: '/docs/cli/commands', slug: 'cli-commands' },
      { title: 'bloom create', href: '/docs/cli/create', slug: 'cli-create' },
      { title: 'bloom dev', href: '/docs/cli/dev', slug: 'cli-dev' },
      { title: 'bloom generate', href: '/docs/cli/generate', slug: 'cli-generate' },
      { title: 'bloom prebuild', href: '/docs/cli/prebuild', slug: 'cli-prebuild' },
      { title: 'bloom deploy', href: '/docs/cli/deploy', slug: 'cli-deploy' },
      { title: 'bloom doctor', href: '/docs/cli/doctor', slug: 'cli-doctor' },
    ],
  },
  {
    title: 'Developer Experience',
    items: [
      { title: 'Bloom Go Companion', href: '/docs/dev-experience/bloom-go', slug: 'dev-bloom-go' },
      { title: 'Dev Server', href: '/docs/dev-experience/dev-server', slug: 'dev-server' },
      { title: 'DevTools Extensions', href: '/docs/dev-experience/devtools-extensions', slug: 'dev-devtools-extensions' },
      { title: 'Cloud OTA Deployment', href: '/docs/framework/ota', slug: 'framework-ota' },
      { title: 'OTA Code Push', href: '/docs/dev-experience/ota-deployments', slug: 'dev-ota-deployments' },
    ],
  },
  {
    title: 'Cloud Platform',
    items: [
      { title: 'Platform Overview', href: '/docs/cloud/overview', slug: 'cloud-overview' },
      { title: 'Build & Release Pipeline', href: '/docs/cloud/build-and-release', slug: 'cloud-build-and-release' },
      { title: 'Secrets, Signing & Git', href: '/docs/cloud/secrets-and-signing', slug: 'cloud-secrets-and-signing' },
      { title: 'Hosting & Observability', href: '/docs/cloud/hosting-and-automation', slug: 'cloud-hosting-and-automation' },
    ],
  },
  {
    title: 'Testing & Diagnostics',
    items: [
      { title: 'Testing Overview', href: '/docs/guides/testing', slug: 'guides-testing' },
      { title: 'Bloom Testing Harness', href: '/docs/testing/harness', slug: 'testing-harness' },
      { title: 'Testing Recipes', href: '/docs/testing/recipes', slug: 'testing-recipes' },
      { title: 'Best Practices', href: '/docs/guides/best-practices', slug: 'guides-best-practices' },
      { title: 'Troubleshooting & FAQ', href: '/docs/guides/troubleshooting', slug: 'guides-troubleshooting' },
      { title: 'Platform Capabilities', href: '/docs/transparency/platform-capabilities', slug: 'transparency-platform-capabilities' },
    ],
  },
];

// Active section helpers
const isSectionActive = (section: { items: { href: string; slug: string }[] }) =>
  section.items.some((item) => currentPath === item.href || currentSlug === item.slug);

const isUICategoryActive = (cat: string) => {
  const items = UI_REGISTRY.filter((c) => c.category === cat);
  return items.some((item) => currentPath === `/ui/${item.slug}` || currentSlug === item.slug);
};

// Select active nav list
let activeNavSections = clientNavSections;
if (activeScope === 'server') {
  activeNavSections = serverNavSections;
} else if (activeScope === 'cloud') {
  activeNavSections = cloudNavSections;
}
---

<Layout
  title={`${title} — Bloom Documentation`}
  description={description}
  hue="bloom"
  petalHighlight="all"
  ogPage="bloom"
>
  <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24">
    <!-- Mobile Docs Navigation Bar (below lg) -->
    <div class="lg:hidden sticky top-16 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2.5 bg-white/95 dark:bg-black/95 backdrop-blur-xl border-b border-slate-200/80 dark:border-zinc-800 mb-6 shadow-sm">
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-1.5 min-w-0 text-xs font-mono">
          <span class="text-slate-500 dark:text-slate-400 truncate">{category}</span>
          <ChevronRight className="w-3 h-3 text-slate-400 shrink-0" />
          <span class="text-slate-900 dark:text-white font-bold truncate">{title}</span>
        </div>
        <button
          id="bloom-docs-nav-toggle"
          type="button"
          onclick="window.toggleBloomDocsNav()"
          aria-expanded="false"
          aria-controls="bloom-docs-nav-panel"
          aria-label="Toggle documentation navigation menu"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-semibold bg-slate-100 dark:bg-zinc-900 text-slate-700 dark:text-slate-300 hover:bg-purple-100 dark:hover:bg-purple-900/30 hover:text-purple-600 dark:hover:text-purple-400 border border-slate-200 dark:border-zinc-800 transition shrink-0"
        >
          <span>Docs Menu</span>
          <ChevronRight id="bloom-docs-nav-chevron" className="w-3.5 h-3.5 transition-transform duration-200" />
        </button>
      </div>

      <!-- Mobile Dropdown Nav Panel -->
      <div
        id="bloom-docs-nav-panel"
        class="hidden mt-3 pt-3 border-t border-slate-200 dark:border-zinc-800 max-h-[70vh] overflow-y-auto scrollbar-thin space-y-6"
      >
        <!-- 3-Scope Switcher Mobile -->
        <div class="grid grid-cols-3 p-1 rounded-2xl bg-slate-100 dark:bg-zinc-900/90 border border-slate-200 dark:border-zinc-800 text-[11px] font-semibold shadow-inner gap-1">
          <a
            href="/docs/framework/quickstart"
            class={`py-2 text-center rounded-xl transition flex items-center justify-center gap-1 ${
              activeScope === 'client'
                ? 'bg-purple-600 text-white shadow-md font-bold'
                : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
            }`}
          >
            <Smartphone className="w-3.5 h-3.5" />
            <span>App / Web</span>
          </a>
          <a
            href="/docs/server/overview"
            class={`py-2 text-center rounded-xl transition flex items-center justify-center gap-1 ${
              activeScope === 'server'
                ? 'bg-pink-600 text-white shadow-md font-bold'
                : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
            }`}
          >
            <Server className="w-3.5 h-3.5" />
            <span>Server</span>
          </a>
          <a
            href="/docs/cli"
            class={`py-2 text-center rounded-xl transition flex items-center justify-center gap-1 ${
              activeScope === 'cloud'
                ? 'bg-blue-600 text-white shadow-md font-bold'
                : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
            }`}
          >
            <Zap className="w-3.5 h-3.5" />
            <span>Cloud &amp; CLI</span>
          </a>
        </div>

        {isUIMode ? (
          <div class="space-y-6">
            <!-- Getting Started (UI) -->
            <div class="space-y-2">
              <h3 class="text-xs font-mono font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider">
                Getting Started
              </h3>
              <ul class="space-y-1">
                {uiGettingStarted.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class={`block px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                        currentPath === item.href || currentSlug === item.slug
                          ? 'bg-purple-600/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 font-bold'
                          : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-zinc-900/50'
                      }`}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Blocks & Themes -->
            <div class="space-y-2">
              <h3 class="text-xs font-mono font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider">
                Studio & Templates
              </h3>
              <ul class="space-y-1">
                {uiBlocksAndThemes.map((item) => {
                  const Icon = item.icon;
                  return (
                    <li>
                      <a
                        href={item.href}
                        class={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                          currentPath === item.href || currentSlug === item.slug
                            ? 'bg-purple-600/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 font-bold'
                            : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-zinc-900/50'
                        }`}
                      >
                        <Icon className="w-3.5 h-3.5 text-purple-400" />
                        <span>{item.title}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
        ) : (
          <div class="space-y-6">
            {activeNavSections.map((section, idx) => {
              const isOpen = isSectionActive(section) || idx === 0;
              return (
                <details open={isOpen} class="group space-y-2">
                  <summary class="flex items-center justify-between text-xs font-mono font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden py-1 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
                    <span class="flex items-center gap-1.5">
                      <ChevronRight className="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 group-open:rotate-90" />
                      <span>{section.title}</span>
                    </span>
                    <span class="text-[10px] text-slate-400 font-mono font-normal">{section.items.length}</span>
                  </summary>
                  <ul class="space-y-1">
                    {section.items.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          class={`block px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                            currentPath === item.href || currentSlug === item.slug
                              ? 'bg-purple-600/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 font-bold'
                              : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-zinc-900/50'
                          }`}
                        >
                          {item.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              );
            })}
          </div>
        )}
      </div>
    </div>

    <!-- Breadcrumb & LLM Quick Actions -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-8 max-w-full">
      <nav class="flex flex-wrap items-center gap-1.5 text-xs font-mono text-slate-500 dark:text-slate-400 max-w-full">
        <a href="/" class="hover:text-purple-400 transition">Hub</a>
        <ChevronRight className="w-3.5 h-3.5 shrink-0" />
        <a
          href={
            activeScope === 'server'
              ? '/docs/server/overview'
              : activeScope === 'cloud'
              ? '/docs/cli'
              : activeScope === 'ui'
              ? '/ui'
              : '/docs/framework/quickstart'
          }
          class="hover:text-purple-400 transition font-bold"
        >
          {activeScope === 'server' ? 'Server (Backend)' : activeScope === 'cloud' ? 'Cloud & CLI' : activeScope === 'ui' ? 'Bloom UI' : 'App (Client)'}
        </a>
        <ChevronRight className="w-3.5 h-3.5 shrink-0" />
        <span class="text-slate-400">{category}</span>
        <ChevronRight className="w-3.5 h-3.5 shrink-0" />
        <span class="text-slate-900 dark:text-white font-bold">{title}</span>
      </nav>

      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          onclick={`window.copyLLMMarkdown('${pageMarkdownPath}')`}
          class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-purple-500/10 hover:bg-purple-500/20 text-purple-600 dark:text-purple-300 border border-purple-500/20 text-xs font-mono font-medium transition cursor-pointer"
          title="Copy full page markdown optimized for LLMs & AI Prompts"
        >
          <Bot className="w-3.5 h-3.5" />
          <span>Copy for LLM</span>
        </button>
        <a
          href={pageMarkdownPath}
          target="_blank"
          class="flex items-center gap-1 px-2 py-1 rounded-lg bg-zinc-100 dark:bg-zinc-900 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-zinc-800 text-xs font-mono transition"
          title="View raw Markdown endpoint (.md)"
        >
          <FileText className="w-3.5 h-3.5" />
          <span>.md</span>
        </a>
      </div>
    </div>

    <!-- Main Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Left Navigation Sidebar -->
      <aside
        id="bloom-docs-sidebar"
        class="hidden lg:block lg:col-span-3 space-y-6 sticky top-20 self-start h-[calc(100vh-5.5rem)] overflow-y-auto pr-4 scrollbar-thin"
      >
        
        <!-- Dedicated 3-Scope Switcher Desktop -->
        <div class="grid grid-cols-3 p-1 rounded-2xl bg-slate-100 dark:bg-zinc-900/90 border border-slate-200 dark:border-zinc-800 text-[11px] font-semibold shadow-inner gap-1">
          <a
            href="/docs/framework/quickstart"
            class={`py-2 text-center rounded-xl transition flex items-center justify-center gap-1 ${
              activeScope === 'client'
                ? 'bg-purple-600 text-white shadow-md font-bold'
                : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
            }`}
          >
            <Smartphone className="w-3.5 h-3.5" />
            <span>App / Web</span>
          </a>
          <a
            href="/docs/server/overview"
            class={`py-2 text-center rounded-xl transition flex items-center justify-center gap-1 ${
              activeScope === 'server'
                ? 'bg-pink-600 text-white shadow-md font-bold'
                : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
            }`}
          >
            <Server className="w-3.5 h-3.5" />
            <span>Server</span>
          </a>
          <a
            href="/docs/cli"
            class={`py-2 text-center rounded-xl transition flex items-center justify-center gap-1 ${
              activeScope === 'cloud'
                ? 'bg-blue-600 text-white shadow-md font-bold'
                : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
            }`}
          >
            <Zap className="w-3.5 h-3.5" />
            <span>Cloud &amp; CLI</span>
          </a>
        </div>

        {isUIMode ? (
          <div class="space-y-6">
            <!-- Getting Started (UI) -->
            <div class="space-y-2">
              <h3 class="text-xs font-mono font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider">
                Getting Started
              </h3>
              <ul class="space-y-1">
                {uiGettingStarted.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class={`block px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                        currentPath === item.href || currentSlug === item.slug
                          ? 'bg-purple-600/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 font-bold'
                          : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-zinc-900/50'
                      }`}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Blocks & Themes -->
            <div class="space-y-2">
              <h3 class="text-xs font-mono font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider">
                Studio & Templates
              </h3>
              <ul class="space-y-1">
                {uiBlocksAndThemes.map((item) => {
                  const Icon = item.icon;
                  return (
                    <li>
                      <a
                        href={item.href}
                        class={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                          currentPath === item.href || currentSlug === item.slug
                            ? 'bg-purple-600/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 font-bold'
                            : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-zinc-900/50'
                        }`}
                      >
                        <Icon className="w-3.5 h-3.5 text-purple-400" />
                        <span>{item.title}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>

            <hr class="border-slate-200 dark:border-zinc-800" />

            <!-- Primitives by Category -->
            {UI_CATEGORIES.map((cat) => {
              const items = UI_REGISTRY.filter((c) => c.category === cat);
              const isOpen = isUICategoryActive(cat);
              return (
                <details open={isOpen} class="group space-y-2">
                  <summary class="flex items-center justify-between text-xs font-mono font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden py-1 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
                    <span class="flex items-center gap-1.5">
                      <ChevronRight className="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 group-open:rotate-90" />
                      <span>{cat}</span>
                    </span>
                    <span class="text-[10px] text-slate-400 font-mono font-normal">{items.length}</span>
                  </summary>
                  <ul class="space-y-1">
                    {items.map((item) => (
                      <li>
                        <a
                          href={`/ui/${item.slug}`}
                          class={`block px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                            currentPath === `/ui/${item.slug}` || currentSlug === item.slug
                              ? 'bg-purple-600/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 font-bold'
                              : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-zinc-900/50'
                          }`}
                        >
                          {item.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              );
            })}
          </div>
        ) : (
          <div class="space-y-6">
            {activeNavSections.map((section, idx) => {
              const isOpen = isSectionActive(section) || idx === 0;
              return (
                <details open={isOpen} class="group space-y-2">
                  <summary class="flex items-center justify-between text-xs font-mono font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden py-1 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
                    <span class="flex items-center gap-1.5">
                      <ChevronRight className="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 group-open:rotate-90" />
                      <span>{section.title}</span>
                    </span>
                    <span class="text-[10px] text-slate-400 font-mono font-normal">{section.items.length}</span>
                  </summary>
                  <ul class="space-y-1">
                    {section.items.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          class={`block px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                            currentPath === item.href || currentSlug === item.slug
                              ? 'bg-purple-600/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 font-bold'
                              : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-zinc-900/50'
                          }`}
                        >
                          {item.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              );
            })}
          </div>
        )}
      </aside>

      <!-- Center / Main Documentation Content Area with Smooth View Transitions -->
      <main id="docs-content-container" transition:name="docs-main-content" transition:animate="fade" class="lg:col-span-7 xl:col-span-7 space-y-10 min-w-0">
        <slot />
      </main>

      <!-- Right On This Page Table of Contents (Desktop XL) -->
      <aside class="hidden xl:block xl:col-span-2 space-y-4 sticky top-20 self-start h-[calc(100vh-5.5rem)] overflow-y-auto pl-4 border-l border-slate-200/60 dark:border-zinc-800 text-xs">
        <div class="font-mono font-bold text-slate-900 dark:text-slate-300 uppercase tracking-wider">
          On This Page
        </div>
        
        {toc.length > 0 ? (
          <ul id="toc-nav" class="space-y-2 text-slate-500 dark:text-slate-400">
            {toc.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  data-toc-target={item.id}
                  class="toc-link block hover:text-purple-600 dark:hover:text-purple-400 transition-all duration-150 py-0.5"
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-slate-400 text-xs italic">No sections on this page</p>
        )}

        <hr class="border-slate-200/60 dark:border-zinc-800 pt-2" />

        <!-- LLM & AI Section -->
        <div class="space-y-2 pt-1">
          <div class="font-mono font-bold text-slate-900 dark:text-slate-300 uppercase tracking-wider text-[11px] flex items-center gap-1.5 text-purple-400">
            <Bot className="w-3.5 h-3.5" />
            <span>LLM & AI Endpoints</span>
          </div>
          <button
            type="button"
            onclick={`window.copyLLMMarkdown('${pageMarkdownPath}')`}
            class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-purple-500/10 hover:bg-purple-500/20 text-purple-600 dark:text-purple-300 border border-purple-500/20 text-xs font-mono font-semibold transition text-left cursor-pointer"
          >
            <span class="flex items-center gap-1.5">
              <Copy className="w-3 h-3" />
              <span>Copy Page Markdown</span>
            </span>
          </button>
          <div class="space-y-1.5 pt-1">
            <a
              href={pageMarkdownPath}
              target="_blank"
              class="flex items-center justify-between text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition py-0.5"
            >
              <span class="flex items-center gap-1.5">
                <FileText className="w-3.5 h-3.5" />
                <span>View Raw .md</span>
              </span>
              <ExternalLink className="w-3 h-3 text-slate-400" />
            </a>
            <a
              href="/llms.txt"
              target="_blank"
              class="flex items-center justify-between text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition py-0.5"
            >
              <span class="flex items-center gap-1.5">
                <Bot className="w-3.5 h-3.5" />
                <span>/llms.txt (Index)</span>
              </span>
              <ExternalLink className="w-3 h-3 text-slate-400" />
            </a>
            <a
              href="/llms-full.txt"
              target="_blank"
              class="flex items-center justify-between text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition py-0.5"
            >
              <span class="flex items-center gap-1.5">
                <FileText className="w-3.5 h-3.5" />
                <span>/llms-full.txt (Full)</span>
              </span>
              <ExternalLink className="w-3 h-3 text-slate-400" />
            </a>
          </div>
        </div>

        <hr class="border-slate-200/60 dark:border-zinc-800 pt-2" />

        <div class="space-y-3 pt-2">
          <a
            href="https://github.com/Chidi09/Bloom"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition"
          >
            <Code2 className="w-3.5 h-3.5" />
            <span>Edit this page on GitHub</span>
          </a>
          <a
            href="https://github.com/Chidi09/Bloom/issues/new"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition"
          >
            <Terminal className="w-3.5 h-3.5" />
            <span>Report an issue</span>
          </a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<!-- Client-side High-Performance ScrollSpy, Mobile Docs Nav & LLM Copy Script -->
<script is:inline>
  window.copyLLMMarkdown = async function(markdownPath) {
    try {
      const res = await fetch(markdownPath);
      if (!res.ok) throw new Error('Failed to fetch markdown');
      const text = await res.text();
      await navigator.clipboard.writeText(text);
      window.dispatchEvent(new CustomEvent('bloom:toast', {
        detail: {
          title: 'LLM Markdown Copied!',
          message: 'Full page markdown ready for ChatGPT, Claude, Gemini, or Cursor.',
          type: 'emerald'
        }
      }));
    } catch (err) {
      const fallbackUrl = window.location.origin + markdownPath;
      await navigator.clipboard.writeText(fallbackUrl);
      window.dispatchEvent(new CustomEvent('bloom:toast', {
        detail: {
          title: 'Markdown URL Copied!',
          message: fallbackUrl,
          type: 'indigo'
        }
      }));
    }
  };
  window.toggleBloomDocsNav = function() {
    const panel = document.getElementById('bloom-docs-nav-panel');
    const btn = document.getElementById('bloom-docs-nav-toggle');
    const chevron = document.getElementById('bloom-docs-nav-chevron');
    if (!panel || !btn) return;
    const isHidden = panel.classList.contains('hidden');
    if (isHidden) {
      panel.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      chevron?.classList.add('rotate-90');
    } else {
      panel.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      chevron?.classList.remove('rotate-90');
    }
  };

  window.closeBloomDocsNav = function() {
    const panel = document.getElementById('bloom-docs-nav-panel');
    const btn = document.getElementById('bloom-docs-nav-toggle');
    const chevron = document.getElementById('bloom-docs-nav-chevron');
    if (!panel || !btn) return;
    panel.classList.add('hidden');
    btn.setAttribute('aria-expanded', 'false');
    chevron?.classList.remove('rotate-90');
  };

  function setupDocsMobileNav() {
    const panel = document.getElementById('bloom-docs-nav-panel');
    if (!panel) return;

    // Close mobile nav when clicking any link inside it
    const links = panel.querySelectorAll('a');
    links.forEach((link) => {
      link.addEventListener('click', () => {
        window.closeBloomDocsNav();
      });
    });
  }

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      window.closeBloomDocsNav();
    }
  });

  function setupScrollSpy() {
    const tocLinks = document.querySelectorAll('.toc-link');
    if (!tocLinks.length) return;

    const sections = [];
    tocLinks.forEach((link) => {
      const targetId = link.getAttribute('data-toc-target');
      if (targetId) {
        const el = document.getElementById(targetId);
        if (el) {
          sections.push({ id: targetId, el, link });
        }
      }
    });

    if (!sections.length) return;

    let ticking = false;

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollPosition = window.scrollY + 120; // 120px offset for sticky header
          let currentActive = sections[0];

          for (let i = 0; i < sections.length; i++) {
            const section = sections[i];
            const top = section.el.offsetTop;
            if (scrollPosition >= top) {
              currentActive = section;
            }
          }

          sections.forEach((s) => {
            if (s === currentActive) {
              s.link.classList.add('text-purple-600', 'dark:text-purple-400', 'font-bold', 'translate-x-1', 'border-l-2', 'border-purple-500', 'pl-2');
              s.link.classList.remove('text-slate-500', 'dark:text-slate-400');
            } else {
              s.link.classList.remove('text-purple-600', 'dark:text-purple-400', 'font-bold', 'translate-x-1', 'border-l-2', 'border-purple-500', 'pl-2');
              s.link.classList.add('text-slate-500', 'dark:text-slate-400');
            }
          });

          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // Run immediately on mount
  }

  // --- Sidebar Scroll & State Preservation Across Page Transitions ---
  function saveSidebarScrollState() {
    const sidebar = document.getElementById('bloom-docs-sidebar');
    if (!sidebar) return;
    try {
      sessionStorage.setItem('bloom_docs_sidebar_scroll', sidebar.scrollTop.toString());
      
      // Save open details states
      const openSummaries = [];
      sidebar.querySelectorAll('details').forEach((det) => {
        if (det.open) {
          const summaryText = det.querySelector('summary span')?.textContent?.trim();
          if (summaryText) openSummaries.push(summaryText);
        }
      });
      sessionStorage.setItem('bloom_docs_sidebar_open_details', JSON.stringify(openSummaries));
    } catch (e) {
      // Ignore quota/storage errors
    }
  }

  function restoreSidebarScrollState() {
    const sidebar = document.getElementById('bloom-docs-sidebar');
    if (!sidebar) return;

    try {
      // 1. Restore open states for details
      const savedDetailsRaw = sessionStorage.getItem('bloom_docs_sidebar_open_details');
      if (savedDetailsRaw) {
        const openSummaries = JSON.parse(savedDetailsRaw);
        if (Array.isArray(openSummaries) && openSummaries.length > 0) {
          sidebar.querySelectorAll('details').forEach((det) => {
            const summaryText = det.querySelector('summary span')?.textContent?.trim();
            if (summaryText && openSummaries.includes(summaryText)) {
              det.open = true;
            }
          });
        }
      }

      // 2. Restore exact scroll position
      const savedScroll = sessionStorage.getItem('bloom_docs_sidebar_scroll');
      if (savedScroll !== null) {
        const top = parseInt(savedScroll, 10);
        if (!isNaN(top)) {
          sidebar.scrollTop = top;
          // Apply on next frame too in case of layout reflow
          requestAnimationFrame(() => {
            sidebar.scrollTop = top;
          });
          return;
        }
      }

      // 3. Fallback: If no saved position, ensure active item is visible in sidebar
      const activeLink = sidebar.querySelector('a.bg-purple-600\\/10') || sidebar.querySelector('a[aria-current="page"]');
      if (activeLink) {
        const sidebarRect = sidebar.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        if (linkRect.top < sidebarRect.top || linkRect.bottom > sidebarRect.bottom) {
          activeLink.scrollIntoView({ block: 'nearest', behavior: 'instant' });
        }
      }
    } catch (e) {
      // Ignore errors
    }
  }

  function attachSidebarListeners() {
    const sidebar = document.getElementById('bloom-docs-sidebar');
    if (!sidebar) return;

    // Track scroll position on user scroll
    let scrollTimeout;
    sidebar.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(saveSidebarScrollState, 80);
    }, { passive: true });

    // Save state on any sidebar link click
    sidebar.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        saveSidebarScrollState();
      });
    });

    // Save state when toggling details
    sidebar.querySelectorAll('details').forEach((det) => {
      det.addEventListener('toggle', () => {
        saveSidebarScrollState();
      });
    });
  }

  // Astro View Transitions lifecycle hooks
  document.addEventListener('astro:before-preparation', saveSidebarScrollState);
  document.addEventListener('astro:before-swap', saveSidebarScrollState);
  document.addEventListener('astro:after-swap', restoreSidebarScrollState);

  // Setup on page load and on view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupScrollSpy();
      setupDocsMobileNav();
      attachSidebarListeners();
      restoreSidebarScrollState();
    });
  } else {
    setupScrollSpy();
    setupDocsMobileNav();
    attachSidebarListeners();
    restoreSidebarScrollState();
  }

  document.addEventListener('astro:page-load', () => {
    setupScrollSpy();
    setupDocsMobileNav();
    attachSidebarListeners();
    restoreSidebarScrollState();
  });
</script>

<style>
  /* Custom scrollbar styling for navigation sidebars */
  .scrollbar-thin::-webkit-scrollbar {
    width: 4px;
  }
  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.2);
    border-radius: 4px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: rgba(148, 163, 184, 0.4);
  }
</style>
