---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import AmbientMesh from '../components/common/AmbientMesh.astro';
import { ScrollProgressRail } from '../components/common/ScrollProgressRail';
import { ToastSystem } from '../components/common/ToastSystem';
import { CommandPalette } from '../components/common/CommandPalette';
import BackToTop from '../components/common/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  hue?: 'hub' | 'build' | 'ship' | 'bloom';
  petalHighlight?: 'all' | 'purple' | 'blue' | 'pink' | 'cyan' | 'orange';
  nextChapterTitle?: string;
  nextChapterLink?: string;
  nextChapterSubtitle?: string;
  ogPage?: 'hub' | 'build' | 'ship' | 'bloom';
}

const {
  title = 'Bloom — BUILD • SHIP • BLOOM',
  description = 'Bloom is the opinionated application platform for Dart & Flutter. Framework, Cloud OTA, and UI.',
  hue = 'hub',
  petalHighlight = 'all',
  nextChapterTitle,
  nextChapterLink,
  nextChapterSubtitle,
  ogPage = 'hub',
} = Astro.props;

const vercelProductionUrl = process.env.VERCEL_PROJECT_PRODUCTION_URL;
const vercelUrl = process.env.VERCEL_URL;
const siteUrl = vercelProductionUrl 
  ? `https://${vercelProductionUrl}` 
  : (vercelUrl ? `https://${vercelUrl}` : 'https://bloom-platform-ten.vercel.app');

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = `${siteUrl}/og/${ogPage}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Bloom',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'iOS, Android',
  url: siteUrl,
  description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: 'Bloom Platform Inc.',
    url: siteUrl,
  },
  keywords: 'Flutter, Dart, mobile framework, OTA updates, Shorebird, signals state, go_router',
};
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#030509" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Bloom Platform Inc." />
    <meta name="keywords" content="Flutter framework, Dart, mobile app platform, Shorebird OTA, signals state, go_router, bloom CLI" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — Bloom Platform`} />
    <meta property="og:site_name" content="Bloom" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${title} — Bloom Platform`} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- View Transitions API -->
    <ClientRouter />

    <!-- Theme Initialization Script -->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem('bloom-theme');
        if (savedTheme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.remove('light');
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen relative overflow-x-hidden antialiased selection:bg-purple-500/30">
    
    <!-- Background System -->
    <AmbientMesh hue={hue} />

    <!-- Desktop Story Rail -->
    <ScrollProgressRail client:idle />

    <!-- Main Navigation Header -->
    <Navbar petalHighlight={petalHighlight} />

    <!-- Main Page Content -->
    <main id="top" class="relative z-10">
      <slot />
    </main>

    <!-- Page Footer with Narrative Cross-Link -->
    <Footer
      nextChapterTitle={nextChapterTitle}
      nextChapterLink={nextChapterLink}
      nextChapterSubtitle={nextChapterSubtitle}
    />

    <!-- Shell Interactive Islands -->
    <ToastSystem client:load />
    <CommandPalette client:load />
    <BackToTop />

    <!-- Mouse Tracking & Scroll Reveal Observer Script -->
    <script>
      function initInteractiveEffects() {
        // Mouse glow positioning on cards (desktop fine pointer only)
        if (window.matchMedia('(pointer: fine)').matches) {
          document.addEventListener('mousemove', (e) => {
            document.querySelectorAll('.mouse-glow-card').forEach((card) => {
              const rect = (card as HTMLElement).getBoundingClientRect();
              const x = e.clientX - rect.left;
              const y = e.clientY - rect.top;
              (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
              (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
            });
          });
        }

        // IntersectionObserver for Blur-Fade Scroll Reveals
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target); // Unobserve once revealed to free GPU/CPU memory
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );

        document.querySelectorAll('.scroll-reveal').forEach((el) => {
          revealObserver.observe(el);
        });
      }

      // Initialize on load and on Astro view transition swap
      initInteractiveEffects();
      document.addEventListener('astro:page-load', initInteractiveEffects);
    </script>
  </body>
</html>
