---
import Layout from '../layouts/Layout.astro';
import Section from '../components/common/Section.astro';
import GlassPanel from '../components/common/GlassPanel.astro';
import OrchestrationFlow from '../components/common/OrchestrationFlow.astro';
import { UIStudioPicker } from '../components/interactive/UIStudioPicker';
import HeroVideoBg from '../components/common/HeroVideoBg.astro';
import { Sparkles, Layers, ShieldCheck, ArrowRight, CheckCircle2, Smartphone, LayoutGrid } from 'lucide-preact';
---

<Layout
  title="BLOOM — UI Studio & Interactive Mobile Component System"
  description="shadcn-inspired composable primitives built natively for Flutter Mobile & Tablet with live interactive design token controls."
  hue="bloom"
  petalHighlight="all"
  nextChapterTitle="BUILD — Framework & DX"
  nextChapterLink="/build"
  nextChapterSubtitle="Return to chapter 01 to explore opinionated file-based routing and reactive signals."
  ogPage="bloom"
>
  <!-- Hero Section -->
  <Section reveal={false} className="pt-16 pb-12 lg:pt-24 lg:pb-16 relative">
    <HeroVideoBg mode="bloom" />
    <div class="text-center max-w-4xl mx-auto space-y-6 relative z-10">
      
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.1]">
        Bloom UI Studio.<br />
        <span class="bg-gradient-to-r from-slate-900 via-slate-700 to-slate-500 dark:from-white dark:via-slate-200 dark:to-slate-400 bg-clip-text text-transparent">shadcn/ui for Flutter Mobile.</span>
      </h1>

      <p class="text-slate-600 dark:text-slate-400 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed">
        Beautifully designed, accessible mobile components. Customize design tokens below and watch buttons, inputs, wallet cards, badges, and bottom bars update in real time.
      </p>
    </div>
  </Section>

  <!-- Deep Interactive UI Studio Mobile Component Gallery -->
  <Section id="studio-picker" className="pt-0">
    <div class="max-w-[90rem] mx-auto flex justify-center">
      <UIStudioPicker client:load />
    </div>
  </Section>

  <!-- Visual Pipeline Flow (STEP 1 - STEP 5) -->
  <Section id="pipeline-flow">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-panel text-xs font-mono font-bold text-slate-600 dark:text-slate-400">
        <LayoutGrid className="w-3.5 h-3.5" />
        Framework Pipeline Flow
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
        Standardize → Wrap → Generate → Orchestrate
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        How Bloom takes mature Dart & Flutter infrastructure and delivers a seamless mobile experience.
      </p>
    </div>

    <OrchestrationFlow />
  </Section>

  <!-- System Features Grid -->
  <Section>
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
        Production-Ready Mobile Architecture
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        Built natively for Flutter Mobile, Tablet & Web with zero compromise on accessibility or performance.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <GlassPanel variant="interactive" className="p-8">
        <Layers className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">shadcn Architecture</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Copy-paste source code directly into your Flutter project. You own every line of code with complete styling control.
        </p>
      </GlassPanel>

      <GlassPanel variant="interactive" className="p-8">
        <ShieldCheck className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Accessible Primitives</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Keyboard navigation, focus traps, screen reader semantics, and WCAG AA contrast built in out of the box.
        </p>
      </GlassPanel>

      <GlassPanel variant="interactive" className="p-8">
        <Sparkles className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Fluid Micro-Animations</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Subtle spring physics, hover glows, and press states crafted with 60fps Flutter Impeller rendering.
        </p>
      </GlassPanel>
    </div>
  </Section>
</Layout>
