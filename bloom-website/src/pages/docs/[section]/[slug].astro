---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { getAllFrameworkDocs, type DocPage } from '../../../lib/framework-docs';
import { 
  ArrowLeft, 
  ArrowRight, 
  BookOpen, 
  ExternalLink,
  ChevronRight,
  Terminal,
  Sparkles
} from 'lucide-preact';

export function getStaticPaths() {
  const allDocs = getAllFrameworkDocs();
  return allDocs.map((doc, index) => {
    const prevDoc = index > 0 ? allDocs[index - 1] : null;
    const nextDoc = index < allDocs.length - 1 ? allDocs[index + 1] : null;

    return {
      params: {
        section: doc.section,
        slug: doc.slug,
      },
      props: {
        doc,
        prevDoc,
        nextDoc,
      },
    };
  });
}

interface Props {
  doc: DocPage;
  prevDoc: DocPage | null;
  nextDoc: DocPage | null;
}

const { doc, prevDoc, nextDoc } = Astro.props;
---

<DocsLayout
  title={doc.title}
  description={doc.description}
  currentSlug={`${doc.section}-${doc.slug}`}
  category={doc.category}
  toc={doc.toc}
>
  <div class="space-y-10 min-w-0">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">
          {doc.category}
        </span>
        <span class="text-xs font-mono text-slate-500">
          {doc.section}/{doc.slug}.md
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        {doc.title}
      </h1>

      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg leading-relaxed max-w-3xl">
        {doc.description}
      </p>
    </div>

    <!-- Rendered Markdown HTML Body with Tailored Styles -->
    <div 
      class="prose prose-slate dark:prose-invert max-w-none 
        prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-white
        prose-h2:text-2xl prose-h2:border-b prose-h2:border-slate-200 dark:prose-h2:border-slate-800 prose-h2:pb-3 prose-h2:mt-10
        prose-h3:text-xl prose-h3:mt-6
        prose-p:text-slate-700 dark:prose-p:text-slate-300 prose-p:leading-relaxed prose-p:text-sm
        prose-code:text-purple-600 dark:prose-code:text-purple-400 prose-code:bg-purple-500/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-xs
        prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-800 prose-pre:rounded-2xl prose-pre:p-5 prose-pre:font-mono prose-pre:text-xs prose-pre:text-slate-200
        prose-table:w-full prose-table:text-left prose-table:text-xs prose-table:font-mono prose-table:my-6
        prose-th:bg-slate-100 dark:prose-th:bg-slate-900 prose-th:p-3 prose-th:border-b prose-th:border-slate-200 dark:prose-th:border-slate-800 prose-th:text-slate-700 dark:prose-th:text-slate-300
        prose-td:p-3 prose-td:border-b prose-td:border-slate-100 dark:prose-td:border-slate-800/60
        prose-ul:list-disc prose-ul:pl-5 prose-ul:space-y-1 prose-ul:text-sm prose-ul:text-slate-700 dark:prose-ul:text-slate-300
        prose-ol:list-decimal prose-ol:pl-5 prose-ol:space-y-1 prose-ol:text-sm prose-ol:text-slate-700 dark:prose-ol:text-slate-300
        prose-blockquote:border-l-4 prose-blockquote:border-purple-500 prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-slate-600 dark:prose-blockquote:text-slate-400
        prose-a:text-purple-600 dark:prose-a:text-purple-400 prose-a:font-semibold hover:prose-a:underline"
      set:html={doc.htmlContent}
    />

    <!-- Prev / Next Navigation Footer -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-10 border-t border-slate-200 dark:border-slate-800">
      {prevDoc ? (
        <a
          href={`/docs/${prevDoc.section}/${prevDoc.slug}`}
          class="flex items-center gap-3 p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 hover:border-purple-500/50 transition group"
        >
          <ArrowLeft className="w-4 h-4 text-purple-500 transform group-hover:-translate-x-1 transition-transform" />
          <div>
            <div class="text-[10px] font-mono text-slate-500 uppercase">{prevDoc.category}</div>
            <div class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-purple-400 transition">
              {prevDoc.title}
            </div>
          </div>
        </a>
      ) : <div />}

      {nextDoc ? (
        <a
          href={`/docs/${nextDoc.section}/${nextDoc.slug}`}
          class="flex items-center justify-between p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 hover:border-purple-500/50 transition group text-right"
        >
          <div>
            <div class="text-[10px] font-mono text-slate-500 uppercase">{nextDoc.category}</div>
            <div class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-purple-400 transition">
              {nextDoc.title}
            </div>
          </div>
          <ArrowRight className="w-4 h-4 text-purple-500 transform group-hover:translate-x-1 transition-transform" />
        </a>
      ) : <div />}
    </div>
  </div>
</DocsLayout>
