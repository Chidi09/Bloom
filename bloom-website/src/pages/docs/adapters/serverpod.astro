---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Server, ArrowRight, ShieldCheck, Cpu } from 'lucide-preact';

const serverpodClientCode = `// lib/adapters/serverpod.dart
import 'package:bloom_framework/bloom.dart';
import 'package:my_client/my_client.dart';

class ServerpodAdapter {
  static void register(BloomContainer container) {
    final client = Client(
      'http://localhost:8080/',
    )..connectivityMonitor = FlutterConnectivityMonitor();

    container.provideSingleton<Client>((c) => client);
  }
}`;
---

<DocsLayout
  title="Serverpod Adapter"
  description="Full-stack Dart integration with Serverpod typed RPC clients and live streaming subscriptions."
  currentSlug="adapters-serverpod"
  category="Backend Adapters"
  toc={[
    { id: 'setup', title: 'Serverpod Client Registration' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono font-bold">
        <Server className="w-3.5 h-3.5" />
        Serverpod
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Serverpod Adapter
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Share typed Dart models end-to-end between server and client with zero code drift.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="setup" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Serverpod Client Registration
      </h2>
      <CodeBlock code={serverpodClientCode} lang="dart" filename="lib/adapters/serverpod.dart" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/adapters/supabase"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Supabase Adapter</span>
      </a>
      <a
        href="/docs/testing/harness"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Testing Harness</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
