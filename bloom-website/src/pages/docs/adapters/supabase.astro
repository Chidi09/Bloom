---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Server, ArrowRight, ShieldCheck, Database } from 'lucide-preact';

const supabaseFullCode = `// lib/adapters/supabase.dart
import 'package:bloom_framework/bloom.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

class SupabaseAdapter {
  static Future<void> initialize(BloomContainer container) async {
    await Supabase.initialize(
      url: const String.fromEnvironment('SUPABASE_URL'),
      anonKey: const String.fromEnvironment('SUPABASE_ANON_KEY'),
    );

    container.provideSingleton<SupabaseClient>((c) => Supabase.instance.client);
  }
}`;
---

<DocsLayout
  title="Supabase Adapter"
  description="Turnkey authentication, PostgreSQL queries, and realtime stream integration with Supabase."
  currentSlug="adapters-supabase"
  category="Backend Adapters"
  toc={[
    { id: 'setup', title: 'Supabase Initialization' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-bold">
        <Server className="w-3.5 h-3.5" />
        Supabase
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Supabase Adapter
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Connect Supabase Auth, PostgreSQL storage, and Realtime subscriptions into reactive Bloom signals with zero boilerplate.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="setup" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Supabase Initialization
      </h2>
      <CodeBlock code={supabaseFullCode} lang="dart" filename="lib/adapters/supabase.dart" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/dev-experience/ota-deployments"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: OTA Deployments</span>
      </a>
      <a
        href="/docs/adapters/serverpod"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Serverpod Adapter</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
