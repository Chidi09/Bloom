---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/common/CodeBlock.astro';
import { Terminal, Code2, ArrowRight, Copy } from 'lucide-preact';

const initCmd = `bloom ui init --style nova --yes`;

const addCmd = `# Add single or multiple components
bloom ui add button card dialog chart

# Or install all 60+ components at once
bloom ui add all`;

const listCmd = `bloom ui list`;

const diffCmd = `bloom ui diff button`;
---

<DocsLayout
  title="CLI Reference"
  description="Command-line interface for managing Bloom UI components and design tokens."
  currentSlug="cli"
  category="Getting Started"
  toc={[
    { id: 'init', title: 'bloom ui init' },
    { id: 'add', title: 'bloom ui add' },
    { id: 'list', title: 'bloom ui list' },
    { id: 'diff', title: 'bloom ui diff' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-zinc-800 pb-8">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        CLI Reference
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Use the <code class="font-mono text-purple-400">bloom ui</code> CLI to initialize projects, install components, inspect local diffs, and configure design tokens.
      </p>
    </div>

    <!-- Init -->
    <section id="init" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white font-mono">
        bloom ui init
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Initializes your Flutter project with the base design token system, color schemes, and configuration file.
      </p>

      <CodeBlock code={initCmd} lang="bash" filename="Terminal" />

      <div class="space-y-2">
        <h3 class="text-xs font-bold uppercase text-slate-400 font-mono">Options</h3>
        <ul class="space-y-2 text-xs text-slate-300 font-mono">
          <li class="p-3 rounded-lg bg-slate-900 border border-slate-800">
            <span class="text-purple-400 font-bold">--style &lt;name&gt;</span>: Preferred style preset (nova, vega, maia, lyra, mira, luma, sera, rhea). Default is <code class="text-slate-400">nova</code>.
          </li>
          <li class="p-3 rounded-lg bg-slate-900 border border-slate-800">
            <span class="text-purple-400 font-bold">--yes / -y</span>: Skip interactive prompts and accept default configuration.
          </li>
        </ul>
      </div>
    </section>

    <!-- Add -->
    <section id="add" class="space-y-4 pt-4 border-t border-slate-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white font-mono">
        bloom ui add
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Copies the specified component(s) and any required internal primitives into your <code class="font-mono text-purple-400">lib/bloom_ui/primitives/</code> directory.
      </p>

      <CodeBlock code={addCmd} lang="bash" filename="Terminal" />

      <div class="space-y-2">
        <h3 class="text-xs font-bold uppercase text-slate-400 font-mono">Options</h3>
        <ul class="space-y-2 text-xs text-slate-300 font-mono">
          <li class="p-3 rounded-lg bg-slate-900 border border-slate-800">
            <span class="text-purple-400 font-bold">--overwrite / -o</span>: Overwrite existing local component files if they already exist.
          </li>
          <li class="p-3 rounded-lg bg-slate-900 border border-slate-800">
            <span class="text-purple-400 font-bold">--path &lt;custom-dir&gt;</span>: Custom destination directory for the component files.
          </li>
        </ul>
      </div>
    </section>

    <!-- List -->
    <section id="list" class="space-y-4 pt-4 border-t border-slate-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white font-mono">
        bloom ui list
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Lists all available primitives in the Bloom registry along with their installation status in your current project.
      </p>
      <CodeBlock code={listCmd} lang="bash" filename="Terminal" />
    </section>

    <!-- Diff -->
    <section id="diff" class="space-y-4 pt-4 border-t border-slate-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white font-mono">
        bloom ui diff
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Compares your local component implementation against the upstream registry to view improvements and updates.
      </p>
      <CodeBlock code={diffCmd} lang="bash" filename="Terminal" />
    </section>

    <!-- Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-zinc-800 flex justify-between">
      <a
        href="/docs/theming"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-zinc-800 transition"
      >
        <span>Previous: Theming & Tokens</span>
      </a>
      <a
        href="/docs/typography"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Typography</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
