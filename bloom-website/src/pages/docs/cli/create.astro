---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Terminal, ArrowRight, ShieldCheck } from 'lucide-preact';

const createCmd = `bloom create my_app --template standard --org com.mycompany`;
---

<DocsLayout
  title="bloom create"
  description="Scaffolding new Bloom applications with templates, organization identifiers, and dependencies."
  currentSlug="cli-create"
  category="CLI Tooling"
  toc={[
    { id: 'usage', title: 'Command Usage & Flags' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white font-mono">
        bloom create
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Scaffolds a production-ready Bloom project configured with Signals, DI, filesystem routing, and native manifests.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="usage" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Command Usage &amp; Flags
      </h2>
      <CodeBlock code={createCmd} lang="bash" filename="Terminal" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/cli/commands"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Master Commands</span>
      </a>
      <a
        href="/docs/cli/dev"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: bloom dev</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
