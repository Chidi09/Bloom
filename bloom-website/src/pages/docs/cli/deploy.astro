---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Send, ArrowRight, ShieldCheck, Terminal } from 'lucide-preact';

const deployCmd = `# Deploy full App Store / Play Store binary release
bloom deploy release --platform ios
bloom deploy release --platform android

# Deploy instant delta bytecode patch over the air
bloom deploy patch --platform ios --message "Fix dark mode crash"
bloom deploy patch --platform android --message "Fix dark mode crash"`;
---

<DocsLayout
  title="bloom deploy"
  description="Build binary app releases and push instant over-the-air patches."
  currentSlug="cli-deploy"
  category="CLI Tooling"
  toc={[
    { id: 'usage', title: 'Deployment Commands' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-zinc-800 pb-8">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white font-mono">
        bloom deploy
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Automate binary builds and instant OTA bytecode patches with Shorebird cloud integration.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="usage" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Deployment Commands
      </h2>
      <CodeBlock code={deployCmd} lang="bash" filename="Terminal" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-zinc-800 flex justify-between">
      <a
        href="/docs/cli/prebuild"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-zinc-800 transition"
      >
        <span>Previous: bloom prebuild</span>
      </a>
      <a
        href="/docs/cli/doctor"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: bloom doctor</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
