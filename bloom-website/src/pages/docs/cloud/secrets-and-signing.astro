---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { KeyRound, FileKey, Route, ArrowRight, ExternalLink } from 'lucide-preact';

const secretsCmd = `# Set a secret for an environment (never printed back to the terminal)
bloom cloud secrets set STRIPE_SECRET_KEY --environment production

# List keys (values always masked)
bloom cloud secrets list --environment production`;

const signingKinds = [
  { name: 'Android Keystore', desc: 'Upload a .jks/.keystore with alias and passwords for signed release builds.' },
  { name: 'iOS Certificate', desc: 'Distribution certificate (.p12) for App Store / TestFlight builds.' },
  { name: 'Provisioning Profile', desc: 'Paired with a certificate to authorize device installs and capabilities.' },
  { name: 'API Key', desc: 'App Store Connect / Google Play service account keys used by the build farm to publish.' },
];
---

<DocsLayout
  title="Secrets, Signing & Git"
  description="Versioned secrets vault, signing identity management, and Git provider connections."
  currentSlug="cloud-secrets-and-signing"
  category="Cloud Platform"
  toc={[
    { id: 'secrets', title: 'Secrets Vault' },
    { id: 'signing', title: 'Signing Identities' },
    { id: 'git', title: 'Git Connections' },
  ]}
>
  <div class="space-y-12">
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-zinc-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono font-bold">
        <KeyRound className="w-3.5 h-3.5" />
        Secrets, Signing & Git
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Secrets, Signing & Git
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Everything the build farm needs to compile and sign your app, stored so that nothing sensitive is ever re-exposed by accident.
      </p>
      <a
        href="https://cloud.bloom.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Open Cloud Dashboard</span>
        <ExternalLink className="w-4 h-4" />
      </a>
    </div>

    <section id="secrets" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Secrets Vault
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Secrets are scoped per environment and versioned&mdash;saving a new value creates a new version rather than mutating the old one, so you can roll back a secret the same way you'd roll back a release:
      </p>
      <CodeBlock code={secretsCmd} lang="bash" filename="Terminal" />
      <div class="flex items-start gap-3 p-4 rounded-2xl bg-purple-500/5 border border-purple-500/20">
        <KeyRound className="w-4 h-4 text-purple-400 shrink-0 mt-0.5" />
        <p class="text-xs text-slate-400 leading-relaxed">
          The dashboard never renders a previously-saved value. "Reveal" performs a fresh, on-demand fetch and the plaintext never persists across a page reload.
        </p>
      </div>
    </section>

    <section id="signing" class="space-y-4 pt-6 border-t border-slate-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Signing Identities
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Upload once per app and every build on the matching platform picks it up automatically. Identities within 30 days of expiry are flagged, expired ones are blocked from new builds:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
        {signingKinds.map((kind) => (
          <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-1">
            <h3 class="text-sm font-bold text-white font-mono">{kind.name}</h3>
            <p class="text-xs text-slate-400 leading-relaxed">{kind.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-slate-600 dark:text-slate-400 text-xs leading-relaxed">
        Downloading a signing identity is restricted to Release Manager and above.
      </p>
    </section>

    <section id="git" class="space-y-4 pt-6 border-t border-slate-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Git Connections
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Connect GitHub, GitLab, or Bitbucket at the organization level, then link individual apps to a repository. Branch deploy policies map a branch pattern (e.g. <code class="font-mono text-purple-400">release/*</code>) to an environment, so pushing to the right branch is enough to trigger a build.
      </p>
      <div class="flex items-start gap-3 p-4 rounded-2xl bg-purple-500/5 border border-purple-500/20">
        <Route className="w-4 h-4 text-purple-400 shrink-0 mt-0.5" />
        <p class="text-xs text-slate-400 leading-relaxed">
          Every inbound webhook delivery is logged with its event type and status, and can be replayed from the dashboard if a build didn't trigger as expected.
        </p>
      </div>
    </section>

    <div class="pt-8 border-t border-slate-200 dark:border-zinc-800 flex justify-between">
      <a
        href="/docs/cloud/build-and-release"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-zinc-800 transition"
      >
        <span>Previous: Build & Release Pipeline</span>
      </a>
      <a
        href="/docs/cloud/hosting-and-automation"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Hosting, Observability & Automation</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
