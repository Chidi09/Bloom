---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Key, ArrowRight, ShieldCheck, Zap } from 'lucide-preact';

const authBaseCode = `// lib/features/auth/auth_service.dart
import 'package:bloom_framework/bloom.dart';

class UserProfile {
  final String id;
  final String email;
  UserProfile({required this.id, required this.email});
}

class AuthService extends BloomAuthBase<UserProfile> {
  Future<void> login(String email, String password) async {
    // Perform remote API call
    final user = UserProfile(id: '123', email: email);
    // Sets reactive signals: isAuthenticated.value = true, user.value = user
    setUser(user);
  }

  Future<void> logout() async {
    setUser(null); // Triggers route guard redirection automatically
  }
}`;
---

<DocsLayout
  title="Authentication & Sessions"
  description="Reactive authentication management, session lifecycles, and automated route guard integration."
  currentSlug="data-authentication"
  category="Data & Cache"
  toc={[
    { id: 'auth-base', title: 'BloomAuthBase Interface' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-zinc-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink-500/10 border border-pink-500/20 text-pink-400 text-xs font-mono font-bold">
        <Key className="w-3.5 h-3.5" />
        Auth System
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Authentication & Sessions
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Manage user sessions, tokens, and role-based permissions with reactive signals connected to filesystem routing guards.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="auth-base" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        BloomAuthBase Interface
      </h2>
      <CodeBlock code={authBaseCode} lang="dart" filename="lib/features/auth/auth_service.dart" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-zinc-800 flex justify-between">
      <a
        href="/docs/data/storage-adapters"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-zinc-800 transition"
      >
        <span>Previous: Storage Adapters</span>
      </a>
      <a
        href="/docs/data/repositories"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Repositories</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
