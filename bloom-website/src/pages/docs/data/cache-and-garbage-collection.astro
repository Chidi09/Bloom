---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Database, ArrowRight, ShieldCheck, Cpu } from 'lucide-preact';

const gcConfigCode = `// Global Cache Configuration in Bootstrapper
final queryClient = BloomQueryClient(
  defaultStaleTime: const Duration(minutes: 5),
  defaultGcTime: const Duration(hours: 1),
  maxMemoryCacheSize: 50 * 1024 * 1024, // 50MB bound
);`;
---

<DocsLayout
  title="Cache & Garbage Collection"
  description="Memory bounds, key normalization, and automatic TTL timers in Bloom Data."
  currentSlug="data-cache-and-garbage-collection"
  category="Data & Cache"
  toc={[
    { id: 'gc-config', title: 'Cache Lifecycle & Limits' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono font-bold">
        <Database className="w-3.5 h-3.5" />
        Cache Memory
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Cache & Garbage Collection
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Automatic TTL eviction and memory limits prevent memory leaks in long-running mobile apps.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="gc-config" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Cache Lifecycle &amp; Limits
      </h2>
      <CodeBlock code={gcConfigCode} lang="dart" filename="lib/app/boot.dart" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/data/mutations"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Mutations & Rollback</span>
      </a>
      <a
        href="/docs/data/http-client"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: HTTP Client</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
