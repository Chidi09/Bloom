---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Database, Zap, ArrowRight, RefreshCw, ShieldCheck } from 'lucide-preact';

const queryDetailsCode = `// lib/features/feed/feed_controller.dart
import 'package:bloom_framework/bloom.dart';
import '../services/api_service.dart';

class FeedController extends BloomController {
  late final feedQuery = createQuery<List<Post>>(
    queryKey: ['feed', 'latest'],
    queryFn: () => inject<ApiService>().fetchFeed(),
    // Keep data fresh in memory for 2 minutes before background refetch
    staleTime: const Duration(minutes: 2),
    // Garbage collect unused cache keys after 30 minutes of no subscribers
    gcTime: const Duration(minutes: 30),
    // Auto refetch when window or mobile app regains focus
    refetchOnWindowFocus: true,
  );

  void invalidateFeed() {
    feedQuery.invalidate();
  }
}`;
---

<DocsLayout
  title="Queries & SWR Caching"
  description="Declarative server state management with automatic background refetching and TTL garbage collection."
  currentSlug="data-queries"
  category="Data & Cache"
  toc={[
    { id: 'definition', title: 'Defining Queries' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink-500/10 border border-pink-500/20 text-pink-400 text-xs font-mono font-bold">
        <Database className="w-3.5 h-3.5" />
        Queries
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Queries & SWR Caching
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Declarative server state management inspired by TanStack Query and SWR for Flutter.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="definition" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Defining Queries
      </h2>
      <CodeBlock code={queryDetailsCode} lang="dart" filename="lib/features/feed/feed_controller.dart" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/framework/data"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Data Overview</span>
      </a>
      <a
        href="/docs/data/mutations"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Mutations & Rollback</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
