---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Smartphone, ArrowRight, QrCode, Zap } from 'lucide-preact';

const pairingCmd = `# 1. Start dev server with QR pairing enabled
bloom dev --qr

# 2. Scan the terminal QR code with the Bloom Go mobile app
# Your Flutter app opens wirelessly on physical device in < 1 second!`;
---

<DocsLayout
  title="Bloom Go Companion"
  description="Wireless Expo-style test shell for instant physical device testing via QR code."
  currentSlug="dev-bloom-go"
  category="Developer Experience"
  toc={[
    { id: 'wireless-pairing', title: 'Wireless QR Pairing' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-zinc-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono font-bold">
        <Smartphone className="w-3.5 h-3.5" />
        Mobile Shell
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Bloom Go Companion
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Test your application on physical iOS and Android devices without plugging in USB cables or creating Xcode certificates.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="wireless-pairing" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Wireless QR Pairing
      </h2>
      <CodeBlock code={pairingCmd} lang="bash" filename="Terminal" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-zinc-800 flex justify-between">
      <a
        href="/docs/cli/doctor"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-zinc-800 transition"
      >
        <span>Previous: bloom doctor</span>
      </a>
      <a
        href="/docs/dev-experience/dev-server"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Dev Server</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
