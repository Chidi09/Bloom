---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Send, ArrowRight, ShieldCheck, Terminal } from 'lucide-preact';

const otaDeployWorkflow = `# Check update availability silently
final ota = BloomOTA();
if (await ota.checkForUpdate()) {
  await ota.downloadUpdate();
}`;
---

<DocsLayout
  title="OTA Code Push Deployments"
  description="Shorebird cloud-powered bytecode patches delivering instant updates directly to users."
  currentSlug="dev-ota-deployments"
  category="Developer Experience"
  toc={[
    { id: 'workflow', title: 'Runtime Client Integration' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-zinc-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink-500/10 border border-pink-500/20 text-pink-400 text-xs font-mono font-bold">
        <Send className="w-3.5 h-3.5" />
        Cloud OTA
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        OTA Code Push Deployments
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Deliver instant fixes over the air directly to physical devices.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="workflow" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Runtime Client Integration
      </h2>
      <CodeBlock code={otaDeployWorkflow} lang="dart" filename="lib/app/boot.dart" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-zinc-800 flex justify-between">
      <a
        href="/docs/dev-experience/devtools-extensions"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-zinc-800 transition"
      >
        <span>Previous: DevTools Extensions</span>
      </a>
      <a
        href="/docs/adapters/supabase"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Supabase Adapter</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
