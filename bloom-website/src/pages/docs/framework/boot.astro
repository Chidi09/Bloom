---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Cpu, Zap, ArrowRight, ShieldCheck, CheckCircle2, Layers } from 'lucide-preact';

const mainDartCode = `// lib/main.dart
import 'package:flutter/material.dart';
import 'package:bloom_framework/bloom.dart';
import 'app/boot.dart';
import 'app/app.dart';

void main() async {
  // Deterministic 10-step boot orchestration
  await Bloom.boot(
    bootstrapper: AppBootstrapper(),
    app: const App(),
  );
}`;

const bootstrapperCode = `// lib/app/boot.dart
import 'package:bloom_framework/bloom.dart';
import '../services/api_service.dart';
import '../services/auth_service.dart';

class AppBootstrapper implements BloomBootstrapper {
  @override
  Future<void> onBoot(BloomContainer container) async {
    // 1. Register base singletons
    container.provideSingleton<BloomConfig>((c) => BloomConfig.fromEnvironment());
    
    // 2. Register typed services with lazy instantiation
    container.provideLazySingleton<ApiService>((c) => ApiService(
      baseUrl: c.inject<BloomConfig>().apiBaseUrl,
    ));

    // 3. Register asynchronous services
    final auth = AuthService();
    await auth.initializeSession();
    container.provideInstance<AuthService>(auth);
  }

  @override
  void onError(Object error, StackTrace stack) {
    BloomLogger.error('Boot sequence failed: \$error', error: error, stackTrace: stack);
  }
}`;

const lifecyclePhases = [
  { step: '01', title: 'WidgetsFlutterBinding Initialization', desc: 'Ensures the Flutter engine communication channel is established synchronously.' },
  { step: '02', title: 'Environment & Config Loading', desc: 'Parses .env and compiles compile-time String.fromEnvironment variables into BloomConfig.' },
  { step: '03', title: 'BloomContainer Dependency Setup', desc: 'Instantiates the hierarchical DI container and registers framework singletons.' },
  { step: '04', title: 'User Bootstrapper Execution', desc: 'Executes your custom AppBootstrapper.onBoot(container) hook.' },
  { step: '05', title: 'Router Compilation & Guards', desc: 'Loads generated routes.g.dart, sets up route authentication guards and redirect handlers.' },
  { step: '06', title: 'Data Cache Rehydration', desc: 'Restores persisted SQLite/Hive SWR cache keys for instant offline startup.' },
  { step: '07', title: 'Native Autolink Verification', desc: 'Verifies native platform plugins and config signatures generated by prebuild.' },
  { step: '08', title: 'Error Boundary Hooks', desc: 'Connects FlutterError.onError and PlatformDispatcher.onError to BloomLogger.' },
  { step: '09', title: 'App Shell Assembly', desc: 'Wraps the root widget with BloomTheme, ToastProvider, and Watch contexts.' },
  { step: '10', title: 'runApp Launch', desc: 'Executes runApp() on the Flutter engine with smooth first-frame rendering.' },
];
---

<DocsLayout
  title="Boot & Lifecycle"
  description="Learn about Bloom's deterministic 10-step boot orchestration and lifecycle hooks."
  currentSlug="framework-boot"
  category="Framework Architecture"
  toc={[
    { id: 'entrypoint', title: 'Application Entrypoint' },
    { id: 'bootstrapper', title: 'BloomBootstrapper Interface' },
    { id: 'sequence', title: '10-Step Deterministic Sequence' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-zinc-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono font-bold">
        <Cpu className="w-3.5 h-3.5" />
        Deterministic Runtime
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Boot & Lifecycle
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Bloom eliminates race conditions and scattered initialization boilerplate by orchestrating a deterministic 10-step boot sequence before the first frame renders.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="entrypoint" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Application Entrypoint
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Instead of calling <code class="font-mono text-purple-400">runApp()</code> directly with fragmented <code class="font-mono text-purple-400">await init()</code> calls, pass your bootstrapper to <code class="font-mono text-purple-400">Bloom.boot()</code>:
      </p>
      <CodeBlock code={mainDartCode} lang="dart" filename="lib/main.dart" />
    </section>

    <!-- Section 2 -->
    <section id="bootstrapper" class="space-y-4 pt-6 border-t border-slate-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        BloomBootstrapper Interface
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Implement <code class="font-mono text-purple-400">BloomBootstrapper</code> to configure services, asynchronous database connections, and auth sessions:
      </p>
      <CodeBlock code={bootstrapperCode} lang="dart" filename="lib/app/boot.dart" />
    </section>

    <!-- Section 3 -->
    <section id="sequence" class="space-y-4 pt-6 border-t border-slate-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        The 10-Step Deterministic Sequence
      </h2>
      <div class="grid grid-cols-1 gap-3 pt-2">
        {lifecyclePhases.map((phase) => (
          <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 flex items-start gap-4">
            <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold font-mono text-xs shrink-0">
              {phase.step}
            </div>
            <div class="space-y-1">
              <h3 class="text-sm font-bold text-white font-mono">{phase.title}</h3>
              <p class="text-xs text-slate-400 leading-relaxed">{phase.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-zinc-800 flex justify-between">
      <a
        href="/docs/framework/quickstart"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-zinc-800 transition"
      >
        <span>Previous: 5-Minute Quickstart</span>
      </a>
      <a
        href="/docs/framework/routing"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Filesystem Routing</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
