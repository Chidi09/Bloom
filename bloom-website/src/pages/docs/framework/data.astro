---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Database, Zap, ArrowRight, RefreshCw, ShieldCheck, CheckCircle2, Cpu, Layers, Radio } from 'lucide-preact';

const queryCode = `// lib/features/posts/posts_controller.dart
import 'package:bloom_framework/bloom.dart';
import '../services/api_service.dart';

class PostsController extends BloomController {
  late final postsQuery = createQuery<List<Post>>(
    queryKey: ['posts', 'feed'],
    queryFn: () => inject<ApiService>().fetchPosts(),
    staleTime: const Duration(minutes: 5),
    gcTime: const Duration(hours: 1),
    persister: inject<BloomStorageAdapter>(), // Native SQLite / SecureStorage persistence
  );

  void refreshPosts() {
    postsQuery.refetch();
  }
}`;

const mutationCode = `// Optimistic Mutation with Automatic Rollback
late final addPostMutation = createMutation<Post, String>(
  mutationFn: (newTitle) => inject<ApiService>().createPost(newTitle),
  optimisticKey: ['posts', 'feed'],
  optimisticData: (newTitle, previousPosts) {
    // 1. Optimistically update local signal cache immediately
    final optimisticPost = Post(id: 'temp-\${DateTime.now()}', title: newTitle);
    return [...(previousPosts ?? []), optimisticPost];
  },
  onError: (error, newTitle, rollbackData) {
    // 2. Automatic rollback if network request fails
    logger.error('Post creation failed, rolling back cache', error: error);
  },
  invalidateKeys: [['posts', 'feed']], // 3. Revalidate from server on success
  offlineQueue: true, // 4. Enqueue mutation for background replay if offline
);`;

const uiConsumptionCode = `// In your Flutter Widget
Watch((context) {
  final state = controller.postsQuery;

  if (state.isLoading.value) {
    return const Center(child: CircularProgressIndicator());
  }

  if (state.isError.value) {
    return Center(child: Text('Error: \${state.error.value}'));
  }

  final posts = state.data.value ?? [];
  return ListView.builder(
    itemCount: posts.length,
    itemBuilder: (context, i) => ListTile(title: Text(posts[i].title)),
  );
})`;

const realtimeBridgeCode = `// Live Query Invalidation via WebSockets
class LiveListController extends BloomController {
  late final tasksQuery = createQuery<List<Task>>(
    queryKey: ['lists', listId, 'tasks'],
    queryFn: () => inject<TaskApi>().fetchTasks(listId),
  );

  @override
  void onInit() {
    // Automatically refetches tasksQuery when backend broadcasts to this channel
    inject<BloomRealtimeClient>().invalidateQueriesOnBroadcast(
      channel: 'lists:\$listId',
      key: ['lists', listId, 'tasks'],
    );
  }
}`;
---

<DocsLayout
  title="Data Layer & Caching"
  description="Signals-driven SWR caching, request deduplication, optimistic mutations, offline queues, and TanStack Query comparison."
  currentSlug="framework-data"
  category="Framework Architecture"
  toc={[
    { id: 'comparison', title: 'Bloom Data vs. TanStack Query' },
    { id: 'queries', title: 'Declarative Queries (SWR)' },
    { id: 'mutations', title: 'Optimistic Mutations & Rollback' },
    { id: 'ui', title: 'Fine-Grained Signals Reactivity' },
    { id: 'realtime-bridge', title: 'Native Realtime Query Bridge' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-zinc-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink-500/10 border border-pink-500/20 text-pink-600 dark:text-pink-400 text-xs font-mono font-bold">
        <Database className="w-3.5 h-3.5" />
        Async Server State
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Data Layer &amp; Caching
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Bloom Data brings TanStack Query semantics to Flutter with a zero-cost <strong>Fine-Grained Signals reactivity model</strong>, automatic SWR caching, in-flight deduplication, and native SQLite offline persistence.
      </p>
    </div>

    <!-- Section: Comparison -->
    <section id="comparison" class="space-y-6">
      <div class="flex items-center gap-2">
        <Cpu className="w-5 h-5 text-purple-500" />
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
          Bloom Data vs. TanStack Query (React Query)
        </h2>
      </div>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        While TanStack Query relies on React component-level hook reruns and JavaScript runtime type erasure, Bloom Data is built on compile-time Dart generics, zero-rebuild Signals, and integrated mobile offline persistence:
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left border-collapse rounded-2xl overflow-hidden border border-slate-200 dark:border-zinc-800">
          <thead class="bg-slate-100 dark:bg-zinc-900 text-slate-900 dark:text-white font-mono uppercase text-[11px]">
            <tr>
              <th class="p-3.5 border-b border-slate-200 dark:border-zinc-800">Feature</th>
              <th class="p-3.5 border-b border-slate-200 dark:border-zinc-800 text-purple-600 dark:text-purple-400">Bloom Data (Flutter)</th>
              <th class="p-3.5 border-b border-slate-200 dark:border-zinc-800 text-slate-500">TanStack Query (React / JS)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-zinc-800 bg-white/50 dark:bg-zinc-950/30">
            <tr>
              <td class="p-3.5 font-bold text-slate-900 dark:text-white">Reactivity Engine</td>
              <td class="p-3.5 text-emerald-600 dark:text-emerald-400 font-semibold">Fine-Grained Signals (0 full widget rebuilds)</td>
              <td class="p-3.5 text-slate-500">Component Hooks (Entire component re-runs)</td>
            </tr>
            <tr>
              <td class="p-3.5 font-bold text-slate-900 dark:text-white">Type Safety</td>
              <td class="p-3.5 text-emerald-600 dark:text-emerald-400 font-semibold">Compile-Time Reified Dart Generics</td>
              <td class="p-3.5 text-slate-500">TypeScript (Erased at runtime)</td>
            </tr>
            <tr>
              <td class="p-3.5 font-bold text-slate-900 dark:text-white">Bulk Cache Writes</td>
              <td class="p-3.5 font-mono text-emerald-600 dark:text-emerald-400 font-bold">84 ms (119k ops/sec) 🥇</td>
              <td class="p-3.5 font-mono text-slate-500">132 ms (75k ops/sec)</td>
            </tr>
            <tr>
              <td class="p-3.5 font-bold text-slate-900 dark:text-white">In-Flight Deduplication</td>
              <td class="p-3.5 font-mono text-emerald-600 dark:text-emerald-400 font-bold">23 ms resolution (1k calls / 50 keys) 🥇</td>
              <td class="p-3.5 font-mono text-slate-500">34 ms resolution</td>
            </tr>
            <tr>
              <td class="p-3.5 font-bold text-slate-900 dark:text-white">Offline Persistence</td>
              <td class="p-3.5 text-emerald-600 dark:text-emerald-400 font-semibold">Native SQLite &amp; SecureStorage adapter</td>
              <td class="p-3.5 text-slate-500">Requires external persist plugins</td>
            </tr>
            <tr>
              <td class="p-3.5 font-bold text-slate-900 dark:text-white">Realtime Invalidation</td>
              <td class="p-3.5 text-emerald-600 dark:text-emerald-400 font-semibold">Native RealtimeQueryBridge</td>
              <td class="p-3.5 text-slate-500">Manual socket.on boilerplate wiring</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 1 -->
    <section id="queries" class="space-y-4 pt-6 border-t border-slate-200 dark:border-zinc-800">
      <div class="flex items-center gap-2">
        <RefreshCw className="w-5 h-5 text-blue-500" />
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
          Declarative Queries (SWR)
        </h2>
      </div>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Define queries inside your controller with declarative stale and garbage collection timeouts:
      </p>
      <CodeBlock code={queryCode} lang="dart" filename="lib/features/posts/posts_controller.dart" />
    </section>

    <!-- Section 2 -->
    <section id="mutations" class="space-y-4 pt-6 border-t border-slate-200 dark:border-zinc-800">
      <div class="flex items-center gap-2">
        <Zap className="w-5 h-5 text-yellow-500" />
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
          Optimistic Mutations &amp; Rollback
        </h2>
      </div>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Mutate server state optimistically for instantaneous user feedback with safe automatic rollback if network requests fail:
      </p>
      <CodeBlock code={mutationCode} lang="dart" filename="Optimistic Mutation Pattern" />
    </section>

    <!-- Section 3 -->
    <section id="ui" class="space-y-4 pt-6 border-t border-slate-200 dark:border-zinc-800">
      <div class="flex items-center gap-2">
        <Layers className="w-5 h-5 text-indigo-500" />
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
          Fine-Grained Signals Reactivity
        </h2>
      </div>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Wrap only the leaf UI nodes with <code class="font-mono text-purple-400">Watch</code>. Unlike React hooks, parent layouts and sibling widgets never re-render when query signals update:
      </p>
      <CodeBlock code={uiConsumptionCode} lang="dart" filename="Widget Consumption" />
    </section>

    <!-- Section 4 -->
    <section id="realtime-bridge" class="space-y-4 pt-6 border-t border-slate-200 dark:border-zinc-800">
      <div class="flex items-center gap-2">
        <Radio className="w-5 h-5 text-pink-500" />
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
          Native Realtime Query Bridge
        </h2>
      </div>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Connect channel broadcasts directly to query cache invalidation. When the server pushes an event, Bloom automatically schedules a background revalidation:
      </p>
      <CodeBlock code={realtimeBridgeCode} lang="dart" filename="lib/features/tasks/tasks_controller.dart" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-zinc-800 flex justify-between">
      <a
        href="/docs/framework/di"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-zinc-800 transition"
      >
        <span>Previous: Dependency Injection</span>
      </a>
      <a
        href="/docs/framework/native"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Prebuild &amp; Native Sync</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
