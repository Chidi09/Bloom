---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Database, Zap, ArrowRight, RefreshCw, ShieldCheck, CheckCircle2 } from 'lucide-preact';

const queryCode = `// lib/features/posts/posts_controller.dart
import 'package:bloom_framework/bloom.dart';
import '../services/api_service.dart';

class PostsController extends BloomController {
  late final postsQuery = createQuery<List<Post>>(
    queryKey: ['posts', 'feed'],
    queryFn: () => inject<ApiService>().fetchPosts(),
    staleTime: const Duration(minutes: 5),
    gcTime: const Duration(hours: 1),
  );

  void refreshPosts() {
    postsQuery.refetch();
  }
}`;

const mutationCode = `// Optimistic Mutation with Rollback
late final addPostMutation = createMutation<Post, String>(
  mutationFn: (newTitle) => inject<ApiService>().createPost(newTitle),
  onMutate: (newTitle) async {
    // 1. Snapshot previous cache
    final previousPosts = postsQuery.data.value;

    // 2. Optimistically update UI immediately
    final optimisticPost = Post(id: 'temp-\${DateTime.now()}', title: newTitle);
    postsQuery.setData([...(previousPosts ?? []), optimisticPost]);

    // Return context for rollback
    return {'previous': previousPosts};
  },
  onError: (error, newTitle, context) {
    // 3. Rollback on failure
    if (context?['previous'] != null) {
      postsQuery.setData(context!['previous'] as List<Post>);
    }
  },
  onSettled: (data, error, variables, context) {
    // 4. Invalidate to sync server state
    invalidateQueries(['posts']);
  },
);`;

const uiConsumptionCode = `// In your Flutter Widget
Watch((context) {
  final state = controller.postsQuery;

  if (state.isLoading.value) {
    return const Center(child: CircularProgressIndicator());
  }

  if (state.isError.value) {
    return Center(child: Text('Error: \${state.error.value}'));
  }

  final posts = state.data.value ?? [];
  return ListView.builder(
    itemCount: posts.length,
    itemBuilder: (context, i) => ListTile(title: Text(posts[i].title)),
  );
})`;
---

<DocsLayout
  title="Data Layer & Caching"
  description="TanStack-style declarative queries, SWR caching, and optimistic mutations with automatic rollback."
  currentSlug="framework-data"
  category="Framework Architecture"
  toc={[
    { id: 'queries', title: 'Declarative Queries (SWR)' },
    { id: 'mutations', title: 'Optimistic Mutations & Rollback' },
    { id: 'ui', title: 'UI Consumption with Watch' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink-500/10 border border-pink-500/20 text-pink-400 text-xs font-mono font-bold">
        <Database className="w-3.5 h-3.5" />
        Async Server State
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Data Layer & Caching
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Bloom Data provides TanStack Query semantics for Flutter. Automatic stale-while-revalidate (SWR) caching, garbage collection, and optimistic mutation rollbacks keep your UI instant and resilient.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="queries" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Declarative Queries (SWR)
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Define queries inside your controller with declarative stale and garbage collection timeouts:
      </p>
      <CodeBlock code={queryCode} lang="dart" filename="lib/features/posts/posts_controller.dart" />
    </section>

    <!-- Section 2 -->
    <section id="mutations" class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Optimistic Mutations &amp; Rollback
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Mutate server state optimistically for instantaneous user feedback with safe automatic rollback if network requests fail:
      </p>
      <CodeBlock code={mutationCode} lang="dart" filename="Optimistic Mutation Pattern" />
    </section>

    <!-- Section 3 -->
    <section id="ui" class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        UI Consumption with Watch
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Queries expose reactive signals for <code class="font-mono text-purple-400">isLoading</code>, <code class="font-mono text-purple-400">data</code>, and <code class="font-mono text-purple-400">isError</code>:
      </p>
      <CodeBlock code={uiConsumptionCode} lang="dart" filename="Widget Consumption" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/framework/di"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Dependency Injection</span>
      </a>
      <a
        href="/docs/framework/native"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Prebuild & Native Sync</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
