---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { Cpu, Layers, ArrowRight, Code2 } from 'lucide-preact';

const diCode = `// lib/app/boot.dart
import 'package:bloom_framework/bloom.dart';
import '../services/api_service.dart';
import '../features/auth/auth_controller.dart';

class AppBootstrapper implements BloomBootstrapper {
  @override
  Future<void> onBoot(BloomContainer container) async {
    // 1. Eager Singleton (initialized at app boot)
    container.provideSingleton<ApiService>((c) => ApiService());

    // 2. Lazy Singleton (initialized on first inject<T>() call)
    container.provideLazySingleton<AuthController>(
      (c) => AuthController(api: c.resolve<ApiService>()),
    );

    // 3. Factory (new instance returned on every resolution)
    container.provideFactory<UuidService>((c) => UuidService());
  }
}`;

const injectCode = `// Inside any widget or controller:
final auth = inject<AuthController>();
final api = inject<ApiService>();`;
---

<DocsLayout
  title="Dependency Injection"
  description="Lightweight, type-safe dependency injection container with eager, lazy, and factory lifetimes."
  currentSlug="framework-di"
  category="Framework & DX"
  toc={[
    { id: 'container', title: 'BloomContainer & Lifetimes' },
    { id: 'inject', title: 'Resolving with inject<T>()' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Dependency Injection
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Bloom includes an ultra-fast, zero-reflection Dependency Injection (DI) container that powers application startup, controller lifecycle, and mockable testing.
      </p>
    </div>

    <!-- BloomContainer -->
    <section id="container" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">BloomContainer & Lifetimes</h2>
      <div class="relative rounded-2xl bg-black/90 border border-slate-800 p-5 font-mono text-xs text-slate-200 overflow-x-auto">
        <pre class="leading-relaxed"><code>{diCode}</code></pre>
      </div>
    </section>

    <!-- Resolving -->
    <section id="inject" class="space-y-4 pt-4 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Resolving Dependencies</h2>
      <div class="relative rounded-2xl bg-black/90 border border-slate-800 p-5 font-mono text-xs text-slate-200 overflow-x-auto">
        <pre class="leading-relaxed"><code>{injectCode}</code></pre>
      </div>
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/framework/signals"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Signals & State</span>
      </a>
      <a
        href="/docs/framework/data"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Data Layer</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
