---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Terminal, Zap, ArrowRight, Code2, Cpu, CheckCircle2 } from 'lucide-preact';

const step1Code = `bloom create quickstart_app
cd quickstart_app`;

const step2Code = `// lib/features/counter/counter_controller.dart
import 'package:bloom_framework/bloom.dart';

class CounterController extends BloomController {
  late final count = createSignal<int>(0, debugLabel: 'counter.count');

  void increment() {
    count.value++;
  }

  void decrement() {
    if (count.value > 0) {
      count.value--;
    }
  }

  void reset() {
    count.value = 0;
  }
}`;

const step3Code = `// lib/routes/counter.dart
import 'package:flutter/material.dart';
import 'package:bloom_framework/bloom.dart';
import '../features/counter/counter_controller.dart';

class CounterRoute extends StatelessWidget {
  const CounterRoute({super.key});

  @override
  Widget build(BuildContext context) {
    // Resolve controller via Bloom DI
    final controller = inject<CounterController>();

    return Scaffold(
      appBar: AppBar(
        title: const Text('Bloom Counter'),
        actions: [
          IconButton(
            icon: const Icon(Icons.refresh),
            onPressed: controller.reset,
          ),
        ],
      ),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Text(
              'Current Count:',
              style: TextStyle(fontSize: 18, color: Colors.grey),
            ),
            const SizedBox(height: 8),
            // Rebuilds ONLY this text widget when controller.count updates
            Watch((context) => Text(
              '\${controller.count.value}',
              style: const TextStyle(fontSize: 56, fontWeight: FontWeight.bold),
            )),
            const SizedBox(height: 24),
            Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                FilledButton.tonal(
                  onPressed: controller.decrement,
                  child: const Icon(Icons.remove),
                ),
                const SizedBox(width: 16),
                FilledButton(
                  onPressed: controller.increment,
                  child: const Icon(Icons.add),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }
}`;

const step4Code = `// lib/app/boot.dart
import 'package:bloom_framework/bloom.dart';
import '../features/counter/counter_controller.dart';

class AppBootstrapper implements BloomBootstrapper {
  @override
  Future<void> onBoot(BloomContainer container) async {
    // Register CounterController as a lazy singleton
    container.provideSingleton<CounterController>((c) => CounterController());
  }
}`;

const step5Code = `bloom dev`;
---

<DocsLayout
  title="5-Minute Quickstart"
  description="Build and run your first full-stack reactive Bloom application in under five minutes."
  currentSlug="framework-quickstart"
  category="Framework Architecture"
  toc={[
    { id: 'create', title: '1. Create New Project' },
    { id: 'controller', title: '2. Signals Controller' },
    { id: 'route', title: '3. Filesystem Route' },
    { id: 'boot', title: '4. Register in Bootstrapper' },
    { id: 'run', title: '5. Dev Server & Hot Reload' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono font-bold">
        <Zap className="w-3.5 h-3.5" />
        Rapid Onboarding
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        5-Minute Quickstart
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Build a reactive full-stack Bloom application with file-based routing, Signals state management, and dependency injection in under five minutes.
      </p>
    </div>

    <!-- Step 1 -->
    <section id="create" class="space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold font-mono text-sm">
          1
        </div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
          Create a New Project
        </h2>
      </div>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Run <code class="font-mono text-purple-400">bloom create</code> to scaffold a modern Bloom application:
      </p>
      <CodeBlock code={step1Code} lang="bash" filename="Terminal" />
    </section>

    <!-- Step 2 -->
    <section id="controller" class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold font-mono text-sm">
          2
        </div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
          Add a Controller with Signals Reactivity
        </h2>
      </div>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Controllers extend <code class="font-mono text-purple-400">BloomController</code> and manage fine-grained reactive signals:
      </p>
      <CodeBlock code={step2Code} lang="dart" filename="lib/features/counter/counter_controller.dart" />
    </section>

    <!-- Step 3 -->
    <section id="route" class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold font-mono text-sm">
          3
        </div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
          Create a Filesystem Route
        </h2>
      </div>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Create <code class="font-mono text-purple-400">lib/routes/counter.dart</code>. Bloom automatically generates typed routing definitions in <code class="font-mono text-purple-400">lib/app/routes.g.dart</code>:
      </p>
      <CodeBlock code={step3Code} lang="dart" filename="lib/routes/counter.dart" />
    </section>

    <!-- Step 4 -->
    <section id="boot" class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold font-mono text-sm">
          4
        </div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
          Register Controller in Bootstrapper
        </h2>
      </div>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Open <code class="font-mono text-purple-400">lib/app/boot.dart</code> and register dependencies inside <code class="font-mono text-purple-400">onBoot</code>:
      </p>
      <CodeBlock code={step4Code} lang="dart" filename="lib/app/boot.dart" />
    </section>

    <!-- Step 5 -->
    <section id="run" class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold font-mono text-sm">
          5
        </div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
          Launch Developer Server
        </h2>
      </div>
      <CodeBlock code={step5Code} lang="bash" filename="Terminal" />
      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 space-y-2">
        <div class="font-bold text-slate-900 dark:text-white font-mono">Interactive Keyboard Controls</div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] font-mono">
          <li><span class="px-2 py-0.5 bg-slate-200 dark:bg-slate-800 rounded font-bold text-purple-400">r</span> Trigger Hot Reload</li>
          <li><span class="px-2 py-0.5 bg-slate-200 dark:bg-slate-800 rounded font-bold text-purple-400">R</span> Trigger Hot Restart</li>
          <li><span class="px-2 py-0.5 bg-slate-200 dark:bg-slate-800 rounded font-bold text-purple-400">w</span> Wireless QR Pairing</li>
          <li><span class="px-2 py-0.5 bg-slate-200 dark:bg-slate-800 rounded font-bold text-purple-400">d</span> Open Flutter DevTools</li>
        </ul>
      </div>
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/introduction"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Introduction</span>
      </a>
      <a
        href="/docs/framework/boot"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Boot & Lifecycle</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
