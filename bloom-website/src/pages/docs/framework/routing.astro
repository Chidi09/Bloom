---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Workflow, Zap, ArrowRight, FolderTree, ShieldCheck, CheckCircle2 } from 'lucide-preact';

const directoryTree = `lib/routes/
├── index.dart                # / (Home Route)
├── about.dart                # /about
├── settings.dart             # /settings
├── users/
│   ├── index.dart            # /users
│   └── [id].dart             # /users/:id (Dynamic Route)
└── (auth)/                   # Route Group (omitted from URL)
    ├── login.dart            # /login
    └── register.dart         # /register`;

const dynamicRouteCode = `// lib/routes/users/[id].dart
import 'package:flutter/material.dart';
import 'package:bloom_framework/bloom.dart';

class UserProfileRoute extends StatelessWidget {
  final String id;
  const UserProfileRoute({super.key, required this.id});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text('User #\$id')),
      body: Center(
        child: Text(
          'Viewing Profile for ID: \$id',
          style: const TextStyle(fontSize: 18),
        ),
      ),
    );
  }
}`;

const guardCode = `// lib/app/guards.dart
import 'package:bloom_framework/bloom.dart';
import '../services/auth_service.dart';

class AuthGuard extends BloomRouteGuard {
  @override
  Future<String?> redirect(BuildContext context, BloomRouteState state) async {
    final auth = inject<AuthService>();
    final isLoggedIn = auth.isAuthenticated.value;
    final isAuthRoute = state.matchedLocation.startsWith('/login') || 
                        state.matchedLocation.startsWith('/register');

    if (!isLoggedIn && !isAuthRoute) {
      return '/login?redirect=\${Uri.encodeComponent(state.matchedLocation)}';
    }

    if (isLoggedIn && isAuthRoute) {
      return '/dashboard';
    }

    return null; // Allow navigation
  }
}`;

const navigationCode = `// Programmatic Navigation Helpers
context.bloom.push('/users/42');
context.bloom.replace('/dashboard');
context.bloom.pop();

// Type-Safe Named Routes Generated by Bloom
AppRoutes.userProfile(id: '42').go(context);`;
---

<DocsLayout
  title="Filesystem Routing"
  description="Next.js-style file-based routing that compiles into typed GoRouter definitions."
  currentSlug="framework-routing"
  category="Framework Architecture"
  toc={[
    { id: 'conventions', title: 'File & Directory Conventions' },
    { id: 'dynamic-routes', title: 'Dynamic Routes [id].dart' },
    { id: 'route-guards', title: 'Authentication Guards' },
    { id: 'navigation', title: 'Programmatic Navigation' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-zinc-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono font-bold">
        <Workflow className="w-3.5 h-3.5" />
        Zero-Boilerplate Navigation
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Filesystem Routing
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Bloom brings the intuitive filesystem routing of Next.js and SvelteKit to Flutter, compiling your directory tree into high-performance, type-safe <code class="font-mono text-purple-400">go_router</code> routes.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="conventions" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        File & Directory Conventions
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Every Dart file placed inside <code class="font-mono text-purple-400">lib/routes/</code> automatically becomes an accessible URL route:
      </p>
      <CodeBlock code={directoryTree} lang="bash" filename="lib/routes structure" />
    </section>

    <!-- Section 2 -->
    <section id="dynamic-routes" class="space-y-4 pt-6 border-t border-slate-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Dynamic Routes ([id].dart)
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Enclose parameter names in brackets like <code class="font-mono text-purple-400">[id].dart</code>. Bloom automatically parses the route parameters and passes them into your widget constructor:
      </p>
      <CodeBlock code={dynamicRouteCode} lang="dart" filename="lib/routes/users/[id].dart" />
    </section>

    <!-- Section 3 -->
    <section id="route-guards" class="space-y-4 pt-6 border-t border-slate-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Authentication & Route Guards
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Guards intercept navigation attempts and perform deterministic redirects based on reactive auth signals:
      </p>
      <CodeBlock code={guardCode} lang="dart" filename="lib/app/guards.dart" />
    </section>

    <!-- Section 4 -->
    <section id="navigation" class="space-y-4 pt-6 border-t border-slate-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Programmatic Navigation
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Navigate with context extensions or type-safe generated route helpers:
      </p>
      <CodeBlock code={navigationCode} lang="dart" filename="Navigation API" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-zinc-800 flex justify-between">
      <a
        href="/docs/framework/boot"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-zinc-800 transition"
      >
        <span>Previous: Boot & Lifecycle</span>
      </a>
      <a
        href="/docs/framework/signals"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Signals Reactivity</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
