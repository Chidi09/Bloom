---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { ShieldCheck, Zap, ArrowRight, CheckCircle2, Layers } from 'lucide-preact';

const conventions = [
  { rule: 'Feature-Driven Folder Structure', desc: 'Group domain models, controllers, and specific widgets inside lib/features/<name>/, keeping lib/routes/ lightweight for page composition.' },
  { rule: 'Never Call setState in Reactive Widgets', desc: 'Use fine-grained Watch((context) => ...) wrappers around leaf nodes rather than making entire routes StatefulWidget.' },
  { rule: 'Query Key Immutability', desc: 'Construct query keys with deterministic lists like [\'entity\', id, filter] so cache hits and invalidations match reliably.' },
  { rule: 'Controller Lifecycle Discipline', desc: 'Instantiate signals with createSignal and avoid storing raw mutable variables outside of signals in controllers.' },
  { rule: 'Idempotent Prebuild Runs', desc: 'Never manually edit generated native manifests; declare permissions in bloom.yaml and run bloom prebuild in CI.' },
];
---

<DocsLayout
  title="Architectural Best Practices"
  description="Proven conventions and architectural rules for enterprise Flutter apps using Bloom."
  currentSlug="guides-best-practices"
  category="Engineering Guides"
  toc={[
    { id: 'rules', title: 'Core Architectural Conventions' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-bold">
        <ShieldCheck className="w-3.5 h-3.5" />
        Production Standards
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Architectural Best Practices
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Conventions followed by high-scale teams building performant, maintainable Flutter apps with Bloom.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="rules" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Core Architectural Conventions
      </h2>
      <div class="grid grid-cols-1 gap-4 pt-2">
        {conventions.map((item, i) => (
          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-1.5">
            <div class="flex items-center gap-2 text-purple-400 font-bold font-mono text-sm">
              <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
              <span>{item.rule}</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed pl-6">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/guides/cookbook"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Cookbook & Recipes</span>
      </a>
      <a
        href="/docs/guides/migration"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Migration Guide</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
