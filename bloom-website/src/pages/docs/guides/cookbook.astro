---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { BookOpen, Zap, ArrowRight, CheckCircle2, ShieldCheck } from 'lucide-preact';

const recipe1Code = `// Recipe: Offline-First Synchronized Cache
class CartController extends BloomController {
  late final cartQuery = createQuery<Cart>(
    queryKey: ['cart', 'current'],
    queryFn: () => inject<CartApi>().getCart(),
    staleTime: const Duration(minutes: 10),
    // Persists query cache automatically into SQLite
    persister: inject<BloomStorageAdapter>(),
  );

  late final checkoutMutation = createMutation<Order, Cart>(
    mutationFn: (cart) => inject<OrderApi>().placeOrder(cart),
    // Queues mutations for background sync if offline
    offlineQueue: true,
  );
}`;

const recipe2Code = `// Recipe: Dynamic Multi-Theme Switcher
class ThemeController extends BloomController {
  late final activePreset = createSignal<BloomStylePreset>(BloomStylePreset.nova);
  late final isDarkMode = createSignal<bool>(true);

  void setPreset(BloomStylePreset preset) {
    activePreset.value = preset;
  }

  void toggleDarkMode() {
    isDarkMode.value = !isDarkMode.value;
  }
}`;
---

<DocsLayout
  title="Cookbook & Recipes"
  description="Practical, end-to-end recipes for building production apps with Bloom."
  currentSlug="guides-cookbook"
  category="Engineering Guides"
  toc={[
    { id: 'offline-cart', title: '1. Offline-First Cart & Mutations' },
    { id: 'theme-switcher', title: '2. Dynamic Multi-Theme Switcher' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono font-bold">
        <BookOpen className="w-3.5 h-3.5" />
        Production Patterns
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Cookbook & Recipes
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Copy-pasteable architecture recipes for real-world application workflows.
      </p>
    </div>

    <!-- Recipe 1 -->
    <section id="offline-cart" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        1. Offline-First Cart &amp; Mutations
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Persist queries to local storage and queue mutations automatically when offline:
      </p>
      <CodeBlock code={recipe1Code} lang="dart" filename="Cart Controller Recipe" />
    </section>

    <!-- Recipe 2 -->
    <section id="theme-switcher" class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        2. Dynamic Multi-Theme Switcher
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Switch between Nova, Vega, Maia, and Dark/Light modes at runtime:
      </p>
      <CodeBlock code={recipe2Code} lang="dart" filename="Theme Switcher Recipe" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/framework/adapters"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Backend Adapters</span>
      </a>
      <a
        href="/docs/guides/best-practices"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Architectural Best Practices</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
