---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { BookOpen, Sparkles, ArrowRight, Code2 } from 'lucide-preact';

const recipe1Code = `// lib/features/notes/notes_controller.dart
import 'package:bloom_framework/bloom.dart';
import '../../models/note.dart';

class NotesController extends BloomController {
  final BloomHttpClient http;

  // Stale-while-revalidate Query
  late final notesQuery = createQuery<List<Note>>(
    key: ['notes', 'list'],
    fetcher: () async {
      final res = await http.get<List<dynamic>>('/rest/v1/notes?select=*');
      return res.map((e) => Note.fromJson(e as Map<String, dynamic>)).toList();
    },
    staleTime: const Duration(minutes: 5),
  );

  // Optimistic Mutation with Rollback
  late final addNoteMutation = createMutation<Note, String>(
    mutationFn: (text) async {
      final res = await http.post<Map<String, dynamic>>('/rest/v1/notes', body: {'content': text});
      return Note.fromJson(res);
    },
    onMutate: (text) {
      final prev = notesQuery.data.value ?? [];
      final temp = Note(id: 'temp_\${DateTime.now().millisecondsSinceEpoch}', content: text);
      notesQuery.setData([...prev, temp]);
      return prev;
    },
    onError: (err, text, rollback) {
      notesQuery.setData(rollback as List<Note>);
    },
    onSettled: (data, err, text, rollback) {
      BloomData.invalidateQueries(['notes']);
    },
  );

  NotesController(this.http);
}`;

const recipe2Code = `# 1. Deploy instantaneous patch to staging channel
bloom deploy patch --channel staging --flavor staging

# 2. Promote patch to production fleet
bloom deploy patch --channel production --flavor production`;

const recipe3Code = `# bloom.yaml
plugins:
  - secure-storage
  - camera
  - notifications:
      android_channel_id: updates

# Run prebuild to inject permissions into AndroidManifest.xml & Info.plist
bloom prebuild`;
---

<DocsLayout
