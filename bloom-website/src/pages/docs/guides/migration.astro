---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { RefreshCw, Zap, ArrowRight, ShieldCheck, CheckCircle2 } from 'lucide-preact';

const riverpodDiff = `// BEFORE (Riverpod StateNotifier + ConsumerWidget)
final counterProvider = StateNotifierProvider<CounterNotifier, int>((ref) => CounterNotifier());

class CounterWidget extends ConsumerWidget {
  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final count = ref.watch(counterProvider);
    return Text('\$count');
  }
}

// AFTER (Bloom Controller + Signal + Watch)
class CounterController extends BloomController {
  late final count = createSignal<int>(0);
}

class CounterWidget extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    final controller = inject<CounterController>();
    return Watch((context) => Text('\${controller.count.value}'));
  }
}`;
---

<DocsLayout
  title="Migration Guide"
  description="Migrate from Riverpod, BLoC, or standard GoRouter to Bloom with step-by-step side-by-side code diffs."
  currentSlug="guides-migration"
  category="Engineering Guides"
  toc={[
    { id: 'riverpod', title: 'Migrating from Riverpod' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono font-bold">
        <RefreshCw className="w-3.5 h-3.5" />
        Zero-Friction Adoption
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Migration Guide
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        How to incrementally migrate existing Flutter projects to Bloom without full rewrites.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="riverpod" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Migrating from Riverpod
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Replace <code class="font-mono text-purple-400">StateNotifierProvider</code> and <code class="font-mono text-purple-400">ConsumerWidget</code> with simple <code class="font-mono text-purple-400">BloomController</code> and <code class="font-mono text-purple-400">Watch</code> wrappers:
      </p>
      <CodeBlock code={riverpodDiff} lang="dart" filename="Riverpod vs Bloom Comparison" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/guides/best-practices"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Architectural Best Practices</span>
      </a>
      <a
        href="/docs/guides/testing"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Testing & DevTools</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
