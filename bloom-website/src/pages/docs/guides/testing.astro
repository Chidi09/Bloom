---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { ShieldCheck, Zap, ArrowRight, CheckCircle2 } from 'lucide-preact';

const unitTestCode = `// test/features/counter_controller_test.dart
import 'package:flutter_test/flutter_test.dart';
import 'package:quickstart_app/features/counter/counter_controller.dart';

void main() {
  test('CounterController increments count signal', () {
    final controller = CounterController();
    expect(controller.count.value, equals(0));

    controller.increment();
    expect(controller.count.value, equals(1));
  });
}`;

const widgetTestCode = `// test/routes/counter_test.dart
import 'package:flutter_test/flutter_test.dart';
import 'package:bloom_framework/bloom.dart';
import 'package:quickstart_app/routes/counter.dart';
import 'package:quickstart_app/features/counter/counter_controller.dart';

void main() {
  testWidgets('CounterRoute displays incremented value on tap', (tester) async {
    // Setup isolated test container
    final container = BloomContainer();
    final controller = CounterController();
    container.provideInstance<CounterController>(controller);

    await tester.pumpWidget(
      BloomScope(
        container: container,
        child: const MaterialApp(home: CounterRoute()),
      ),
    );

    expect(find.text('0'), findsOneWidget);

    await tester.tap(find.byIcon(Icons.add));
    await tester.pump(); // Fast synchronous rebuild

    expect(find.text('1'), findsOneWidget);
  });
}`;
---

<DocsLayout
  title="Testing & DevTools"
  description="Fast synchronous unit tests, mockable DI containers, and widget tests for Bloom apps."
  currentSlug="guides-testing"
  category="Engineering Guides"
  toc={[
    { id: 'unit-testing', title: 'Controller Unit Testing' },
    { id: 'widget-testing', title: 'Widget Testing with BloomScope' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono font-bold">
        <ShieldCheck className="w-3.5 h-3.5" />
        High Confidence Testing
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Testing & DevTools
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Because Bloom signals and controllers are pure Dart classes without Flutter UI dependencies, unit tests execute synchronously in milliseconds.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="unit-testing" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Controller Unit Testing
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Test controllers with standard Dart <code class="font-mono text-purple-400">flutter_test</code>:
      </p>
      <CodeBlock code={unitTestCode} lang="dart" filename="test/features/counter_controller_test.dart" />
    </section>

    <!-- Section 2 -->
    <section id="widget-testing" class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Widget Testing with BloomScope
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Supply mock services into isolated test containers with <code class="font-mono text-purple-400">BloomScope</code>:
      </p>
      <CodeBlock code={widgetTestCode} lang="dart" filename="test/routes/counter_test.dart" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/guides/migration"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Migration Guide</span>
      </a>
      <a
        href="/docs/guides/troubleshooting"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Troubleshooting & FAQ</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
