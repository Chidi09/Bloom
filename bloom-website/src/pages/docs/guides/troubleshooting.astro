---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { HelpCircle, AlertTriangle, ArrowRight, Code2 } from 'lucide-preact';
---

<DocsLayout
  title="Troubleshooting & FAQ"
  description="Common questions, diagnostic commands, and debugging tips for the Bloom platform."
  currentSlug="guides-troubleshooting"
  category="Guides & Recipes"
  toc={[
    { id: 'doctor', title: '1. Running bloom doctor' },
    { id: 'routing-issues', title: '2. Filesystem Route Not Updating' },
    { id: 'signals-issues', title: '3. Signal Rebuilds Not Firing' },
    { id: 'ota-issues', title: '4. OTA Patch Not Downloading' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Troubleshooting & FAQ
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Quick diagnostic solutions for common environment, routing, state management, and build issues.
      </p>
    </div>

    <!-- Doctor -->
    <section id="doctor" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        1. Running bloom doctor
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Run <code class="font-mono text-purple-400">bloom doctor</code> to perform an automated diagnostic check of Flutter, Dart SDK, Android Studio, Xcode, and Shorebird CLI:
      </p>
      <div class="relative rounded-2xl bg-black/90 border border-slate-800 p-4 font-mono text-xs text-purple-300">
        <code>bloom doctor</code>
      </div>
    </section>

    <!-- Routing issues -->
    <section id="routing-issues" class="space-y-4 pt-4 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        2. Filesystem Route Not Updating
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        If you created a new file in <code class="font-mono text-purple-400">lib/routes/</code> while the dev server was offline, force a route regeneration:
      </p>
      <div class="relative rounded-2xl bg-black/90 border border-slate-800 p-4 font-mono text-xs text-purple-300">
        <code>bloom generate routes</code>
      </div>
    </section>

    <!-- Signals issues -->
    <section id="signals-issues" class="space-y-4 pt-4 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        3. Signal Rebuilds Not Firing
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Make sure you are reading <code class="font-mono text-purple-400">signal.value</code> inside a <code class="font-mono text-purple-400">Watch((context) => ...)</code> builder or a <code class="font-mono text-purple-400">WatchMixin</code> widget.
      </p>
    </section>

    <!-- OTA issues -->
    <section id="ota-issues" class="space-y-4 pt-4 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        4. OTA Patch Not Downloading
      </h2>
      <ul class="list-disc list-inside space-y-2 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
        <li>Verify that the release version numbers match: A patch built for <code class="font-mono text-purple-400">1.0.0+1</code> can only be applied to a baseline binary built for <code class="font-mono text-purple-400">1.0.0+1</code>.</li>
        <li>Ensure the target channel (<code class="font-mono text-purple-400">staging</code> or <code class="font-mono text-purple-400">production</code>) matches between the client app and the deploy command.</li>
      </ul>
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/guides/testing"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Testing & DevTools</span>
      </a>
      <a
        href="/ui"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Explore UI Components</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
