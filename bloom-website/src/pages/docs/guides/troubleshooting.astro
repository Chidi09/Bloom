---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { HelpCircle, Zap, ArrowRight, ShieldCheck, Terminal } from 'lucide-preact';

const doctorCmd = `bloom doctor`;

const faqs = [
  {
    q: 'Why is my new route in lib/routes/ not resolving?',
    a: 'Run bloom dev or bloom generate to trigger AST route generation. Bloom will compile the new route into lib/app/routes.g.dart automatically.',
  },
  {
    q: 'How do I pass parameters to modal dialogs?',
    a: 'Use BloomDialog.show(context, builder: (ctx) => MyDialog(param: value)) or pass route query parameters in the URL scheme.',
  },
  {
    q: 'Can I use Bloom UI components in a non-Bloom Flutter app?',
    a: 'Yes! Install bloom_ui from pub.dev and import the components directly. Bloom UI has zero framework runtime dependencies and works in any standard Flutter project.',
  },
  {
    q: 'What should I do if native permissions fail on iOS?',
    a: 'Ensure your permission string in bloom.yaml is declared with a descriptive message, then run bloom prebuild to re-sync ios/Runner/Info.plist.',
  },
];
---

<DocsLayout
  title="Troubleshooting & FAQ"
  description="Common issues, troubleshooting diagnostics, and frequently asked questions for Bloom developers."
  currentSlug="guides-troubleshooting"
  category="Engineering Guides"
  toc={[
    { id: 'doctor', title: 'Running Diagnostics (bloom doctor)' },
    { id: 'faqs', title: 'Frequently Asked Questions' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-zinc-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono font-bold">
        <HelpCircle className="w-3.5 h-3.5" />
        Diagnostics & Solutions
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Troubleshooting & FAQ
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Quick answers and diagnostic tooling to resolve environment, routing, and build issues.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="doctor" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Running Diagnostics (bloom doctor)
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Run <code class="font-mono text-purple-400">bloom doctor</code> to verify Dart SDK, Flutter toolchains, Android SDK, and Xcode setups:
      </p>
      <CodeBlock code={doctorCmd} lang="bash" filename="Terminal" />
    </section>

    <!-- Section 2 -->
    <section id="faqs" class="space-y-4 pt-6 border-t border-slate-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4 pt-2">
        {faqs.map((faq) => (
          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2">
            <h3 class="font-bold text-white font-mono text-sm text-purple-300">{faq.q}</h3>
            <p class="text-xs text-slate-400 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-zinc-800 flex justify-between">
      <a
        href="/docs/guides/testing"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-zinc-800 transition"
      >
        <span>Previous: Testing & DevTools</span>
      </a>
      <a
        href="/ui"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Component Gallery</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
