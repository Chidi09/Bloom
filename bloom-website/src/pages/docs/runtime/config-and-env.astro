---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { Sliders, ArrowRight, ShieldCheck, Cpu } from 'lucide-preact';

const envFileCode = `# .env
API_BASE_URL=https://api.bloom.dev/v1
ENABLE_ANALYTICS=true
AUTH_DOMAIN=auth.bloom.dev
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0`;

const configDartCode = `// lib/app/config.dart
import 'package:bloom_framework/bloom.dart';

class AppConfig extends BloomConfig {
  late final String apiBaseUrl = getString('API_BASE_URL', defaultValue: 'http://localhost:8080');
  late final bool enableAnalytics = getBool('ENABLE_ANALYTICS', defaultValue: false);
  late final String authDomain = getString('AUTH_DOMAIN');
  late final String? sentryDsn = getOptionalString('SENTRY_DSN');

  AppConfig.fromEnvironment() : super.fromEnvironment();
}`;

const accessConfigCode = `// Injected anywhere via DI
final config = inject<AppConfig>();
print(config.apiBaseUrl); // Type-safe string access`;
---

<DocsLayout
  title="Config & Environment"
  description="Type-safe environment variable parsing, compile-time String.fromEnvironment flags, and runtime .env loading."
  currentSlug="runtime-config-and-env"
  category="Framework Architecture"
  toc={[
    { id: 'env-file', title: '.env Configuration' },
    { id: 'typed-class', title: 'Typed BloomConfig Class' },
    { id: 'usage', title: 'Dependency Injection Access' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono font-bold">
        <Sliders className="w-3.5 h-3.5" />
        Type-Safe Configuration
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Config & Environment
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Manage API base URLs, feature flags, and secret keys across development, staging, and production environments with zero runtime crashes.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="env-file" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        .env Configuration
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Define environment variables in root <code class="font-mono text-purple-400">.env</code> files:
      </p>
      <CodeBlock code={envFileCode} lang="bash" filename=".env" />
    </section>

    <!-- Section 2 -->
    <section id="typed-class" class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Typed BloomConfig Class
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Subclass <code class="font-mono text-purple-400">BloomConfig</code> to define type-safe accessors with fallbacks:
      </p>
      <CodeBlock code={configDartCode} lang="dart" filename="lib/app/config.dart" />
    </section>

    <!-- Section 3 -->
    <section id="usage" class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Dependency Injection Access
      </h2>
      <CodeBlock code={accessConfigCode} lang="dart" filename="Usage Example" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/framework/boot"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Boot & Lifecycle</span>
      </a>
      <a
        href="/docs/runtime/logging"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Structured Logging</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
