---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { ShieldCheck, ArrowRight, CheckCircle2, Cpu } from 'lucide-preact';

const harnessCode = `// test/test_helper.dart
import 'package:flutter_test/flutter_test.dart';
import 'package:bloom_framework/bloom.dart';

BloomContainer createTestContainer({
  AuthService? mockAuth,
  ApiService? mockApi,
}) {
  final container = BloomContainer();
  if (mockAuth != null) container.provideInstance<AuthService>(mockAuth);
  if (mockApi != null) container.provideInstance<ApiService>(mockApi);
  return container;
}`;
---

<DocsLayout
  title="Bloom Testing Harness"
  description="Test harness architecture, mock container scoping, and fast synchronous test runners."
  currentSlug="testing-harness"
  category="Testing & Diagnostics"
  toc={[
    { id: 'harness-setup', title: 'Test Container Harness' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-zinc-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono font-bold">
        <ShieldCheck className="w-3.5 h-3.5" />
        Test Architecture
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Bloom Testing Harness
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        Build isolated test environments with mock dependencies and deterministic state resets.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="harness-setup" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Test Container Harness
      </h2>
      <CodeBlock code={harnessCode} lang="dart" filename="test/test_helper.dart" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-zinc-800 flex justify-between">
      <a
        href="/docs/adapters/serverpod"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-zinc-800 transition"
      >
        <span>Previous: Serverpod Adapter</span>
      </a>
      <a
        href="/docs/testing/recipes"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Testing Recipes</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
