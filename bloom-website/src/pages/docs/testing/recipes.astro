---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/common/CodeBlock.astro';
import { ShieldCheck, ArrowRight, CheckCircle2, Cpu } from 'lucide-preact';

const widgetRecipeCode = `// test/routes/feed_route_test.dart
import 'package:flutter_test/flutter_test.dart';
import 'package:bloom_framework/bloom.dart';
import 'package:my_app/routes/feed.dart';

void main() {
  testWidgets('FeedRoute renders post items after query completes', (tester) async {
    final container = createTestContainer(
      mockApi: MockApiService(fixtures: [Post(id: '1', title: 'Hello World')]),
    );

    await tester.pumpWidget(
      BloomScope(
        container: container,
        child: const MaterialApp(home: FeedRoute()),
      ),
    );

    await tester.pump();
    expect(find.text('Hello World'), findsOneWidget);
  });
}`;
---

<DocsLayout
  title="Testing Recipes"
  description="Practical test recipes for controller unit tests, widget interaction tests, and integration flows."
  currentSlug="testing-recipes"
  category="Testing & Diagnostics"
  toc={[
    { id: 'widget-recipe', title: 'Widget Test Recipe' },
  ]}
>
  <div class="space-y-12">
    <!-- Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono font-bold">
        <ShieldCheck className="w-3.5 h-3.5" />
        Test Recipes
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Testing Recipes
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        End-to-end testing patterns for signals, controllers, and filesystem routes.
      </p>
    </div>

    <!-- Section 1 -->
    <section id="widget-recipe" class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Widget Test Recipe
      </h2>
      <CodeBlock code={widgetRecipeCode} lang="dart" filename="test/routes/feed_route_test.dart" />
    </section>

    <!-- Next Page Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between">
      <a
        href="/docs/testing/harness"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-800 transition"
      >
        <span>Previous: Testing Harness</span>
      </a>
      <a
        href="/docs/transparency/platform-capabilities"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-500 transition shadow-lg"
      >
        <span>Next: Platform Capabilities</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </div>
</DocsLayout>
