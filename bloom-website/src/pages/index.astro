---
import Layout from '../layouts/Layout.astro';
import Section from '../components/common/Section.astro';
import GlassPanel from '../components/common/GlassPanel.astro';
import TechMarquee from '../components/common/TechMarquee.astro';
import HeroVideoBg from '../components/common/HeroVideoBg.astro';
import HubFAQ from '../components/common/HubFAQ.astro';
import { CommunityShowcase } from '../components/interactive/CommunityShowcase';
import { OrchestrationPipeline } from '../components/interactive/OrchestrationPipeline';
import { ChapterCards } from '../components/interactive/ChapterCards';
import { FeatureGridShowcase } from '../components/interactive/FeatureGridShowcase';
import { CLIToolingExplorer } from '../components/interactive/CLIToolingExplorer';
import { FolderTree, RefreshCw, Send, Terminal, Code, Sliders, Box, ArrowRight, CheckCircle2, Sparkles, Cpu, Layers, ShieldCheck, Zap, Server, Globe, FileCode2 } from 'lucide-preact';

const colors = ['#FF4B8B', '#FF884D', '#20C9B0', '#3B82F6', '#8B5CF6'];
const fallingPetals = Array.from({ length: 25 }).map((_, i) => {
  const size = Math.random() * 45 + 45; // 45px to 90px (former petal size range)
  const left = Math.random() * 100; // 0% to 100%
  const duration = Math.random() * 12 + 12; // 12s to 24s (slow & smooth)
  const delay = Math.random() * -24; // negative delay to start immediately in loop
  const startX = (Math.random() * 60 - 30) + 'px';
  const endX = (Math.random() * 120 - 60) + 'px';
  const maxOpacity = Math.random() * 0.4 + 0.2; // 0.2 to 0.6
  const rot = (Math.random() * 720 - 360) + 'deg';
  const color = colors[i % colors.length];
  return { size, left, duration, delay, startX, endX, maxOpacity, rot, color };
});
---

<Layout
  title="Bloom — BUILD • SHIP • BLOOM | The Application Platform for Dart & Flutter"
  description="Bloom is the opinionated application platform for Dart & Flutter. Architecture, CLI, Signals state, GoRouter generation, Shorebird OTA, and Bloom UI."
  hue="hub"
  petalHighlight="all"
  nextChapterTitle="BUILD — Framework & DX"
  nextChapterLink="/build"
  nextChapterSubtitle="Explore opinionated file-based routing, reactive signals, and state controllers for Flutter."
>
  <!-- Hero Section with Hardware-Accelerated Petal Burst -->
  <Section reveal={false} className="pt-16 pb-16 lg:pt-24 lg:pb-20 relative">
    <!-- Falling Petals Background (Hardware Accelerated) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10 select-none">
      {fallingPetals.map((petal) => (
        <div
          class="falling-petal"
          style={`
            left: ${petal.left}%;
            width: ${petal.size}px;
            height: ${petal.size}px;
            color: ${petal.color};
            animation-duration: ${petal.duration}s;
            animation-delay: ${petal.delay}s;
            --start-x: ${petal.startX};
            --end-x: ${petal.endX};
            --max-opacity: ${petal.maxOpacity};
            --rot: ${petal.rot};
          `}
        >
          <svg viewBox="0 0 200 200" fill="none" class="w-full h-full opacity-70">
            <path d="M100 20 C130 20 145 60 125 90 C110 100 90 100 75 90 C55 60 70 20 100 20 Z" fill="currentColor" />
          </svg>
        </div>
      ))}
    </div>

    <div class="text-center max-w-4xl mx-auto space-y-6 relative z-10 min-h-[250px] flex flex-col items-center justify-center">
      
      <!-- Announcement Pill -->
      <a href="/docs/introduction" class="inline-flex flex-wrap items-center justify-center gap-2 px-4 py-1.5 rounded-full glass-panel shadow-sm text-xs font-medium hover:scale-105 transition cursor-pointer group mb-2 max-w-[90vw] text-center">
        <span class="flex h-2 w-2 relative shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-slate-600 dark:text-slate-300">bloom_ui v0.1.0 published on pub.dev • 60+ shadcn primitives for Flutter</span>
        <span class="font-bold text-purple-600 dark:text-purple-400 group-hover:text-purple-300 flex items-center gap-1 shrink-0">
          Explore docs <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
        </span>
      </a>

      <!-- Typewriter Hero Header -->
      <h1 class="text-4xl sm:text-6xl lg:text-8xl font-black tracking-tighter leading-[1] text-slate-900 dark:text-white relative">
        <span id="heroTypewriter" class="text-sweep typing-cursor"></span>
      </h1>

      <p id="heroSub" class="text-slate-600 dark:text-slate-400 text-base sm:text-xl max-w-2xl mx-auto font-normal leading-relaxed opacity-0 transition-opacity duration-1000 mt-6 px-2">
        The opinionated application platform for Dart &amp; Flutter. Standardizing architecture, signals state, go_router generation, Shorebird OTA, and Bloom UI.
      </p>

      <!-- Install CLI Bar -->
      <div id="heroCmd" class="pt-6 max-w-xl mx-auto opacity-0 transition-opacity duration-1000 delay-300 w-full px-2 sm:px-0 space-y-4">
        <div
          onclick="navigator.clipboard.writeText('dart pub global activate bloom_cli'); window.dispatchEvent(new CustomEvent('bloom:toast', { detail: { title: 'Command Copied', message: 'Run in terminal to install CLI.', type: 'emerald' } }))"
          class="relative group cursor-pointer w-full"
        >
          <div class="absolute -inset-1 bg-slate-200/70 dark:bg-white/10 rounded-2xl blur opacity-40 group-hover:opacity-70 transition duration-500"></div>
          <div class="relative glass-panel p-3 sm:p-4 rounded-2xl flex items-center justify-between gap-2 sm:gap-4 overflow-hidden">
            <div class="flex items-center gap-2 sm:gap-3 font-mono text-xs sm:text-sm overflow-hidden text-left min-w-0">
              <span class="text-slate-500 dark:text-slate-400 font-bold shrink-0">$</span>
              <span class="text-slate-800 dark:text-slate-200 font-semibold truncate">dart pub global activate bloom_cli</span>
            </div>
            <button class="px-3 sm:px-4 py-2 bg-white dark:bg-zinc-900 group-hover:bg-slate-900 group-hover:text-white rounded-xl text-xs font-mono font-bold text-slate-700 dark:text-slate-200 dark:group-hover:text-white transition-colors flex items-center gap-1.5 shrink-0 border border-slate-200 dark:border-zinc-800 shadow-sm">
              <Terminal className="w-3.5 h-3.5 sm:w-4 sm:h-4" strokeWidth={1.75} />
              <span class="hidden sm:inline">Copy</span>
            </button>
          </div>
        </div>

        <!-- Quick Links -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <a
            href="/ui"
            class="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs shadow-md transition flex items-center gap-1.5"
          >
            <Sparkles className="w-3.5 h-3.5" />
            <span>Components (60+)</span>
          </a>
          <a
            href="/docs/introduction"
            class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-zinc-950 hover:bg-slate-200 dark:hover:bg-zinc-800 text-slate-900 dark:text-white font-bold text-xs border border-slate-200 dark:border-zinc-800 shadow-sm transition flex items-center gap-1.5"
          >
            <span>Documentation</span>
          </a>
          <a
            href="/blocks"
            class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-zinc-950 hover:bg-slate-200 dark:hover:bg-zinc-800 text-slate-900 dark:text-white font-bold text-xs border border-slate-200 dark:border-zinc-800 shadow-sm transition flex items-center gap-1.5"
          >
            <span>Blocks</span>
          </a>
          <a
            href="/themes"
            class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-zinc-950 hover:bg-slate-200 dark:hover:bg-zinc-800 text-slate-900 dark:text-white font-bold text-xs border border-slate-200 dark:border-zinc-800 shadow-sm transition flex items-center gap-1.5"
          >
            <span>Theme Studio</span>
          </a>
        </div>
      </div>
    </div>
  </Section>

  <!-- SVG Brand Logo Marquee -->
  <TechMarquee />

  <!-- Platform Metrics Band -->
  <Section id="metrics" className="py-14 lg:py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-0 divide-y-0 md:divide-x divide-slate-200 dark:divide-slate-800 max-w-6xl mx-auto">
      <div class="text-center space-y-1.5 px-4">
        <div class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">142</div>
        <div class="text-[11px] font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400">Edge CDN nodes</div>
      </div>
      <div class="text-center space-y-1.5 px-4">
        <div class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">1.2s</div>
        <div class="text-[11px] font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400">OTA patch broadcast</div>
      </div>
      <div class="text-center space-y-1.5 px-4">
        <div class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">150KB</div>
        <div class="text-[11px] font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400">Avg delta patch</div>
      </div>
      <div class="text-center space-y-1.5 px-4">
        <div class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">60fps</div>
        <div class="text-[11px] font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400">Impeller rendering</div>
      </div>
    </div>
    <p class="text-center text-[11px] font-mono uppercase tracking-widest text-slate-400 dark:text-slate-500 mt-10">
      RSA-2048 Signed Patches &nbsp;·&nbsp; Deterministic Builds &nbsp;·&nbsp; Typed Route Safety
    </p>
  </Section>

  <!-- Ecosystem Orchestration Section -->
  <Section id="orchestration">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full glass-panel text-xs font-mono font-bold text-slate-600 dark:text-slate-300">
        <Sparkles className="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" strokeWidth={2} />
        Executive Strategy
      </div>
      <h2 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Make the good parts of Dart & Flutter<br />
        <span class="text-gradient-silver">feel like one cohesive framework.</span>
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed">
        Bloom delegates mature low-level infrastructure (Flutter rendering, go_router, signals, Shorebird OTA) while owning the end-to-end developer experience.
      </p>
    </div>

    {/* Interactive 5-Step Orchestration Pipeline */}
    <OrchestrationPipeline client:visible />

    {/* Interactive Chapter Spotlights (BUILD • SHIP • BLOOM) */}
    <div class="mt-20">
      <ChapterCards client:visible />
    </div>
  </Section>

  <!-- Feature Showcase Grid -->
  <Section id="feature-showcase">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
        Everything you need to ship Flutter apps
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        One cohesive platform across architecture, delivery, and UI — no glue code required.
      </p>
    </div>

    {/* Interactive 6-Feature Micro-Interactive Showcase */}
    <FeatureGridShowcase client:visible />
  </Section>

  <!-- CLI Command Matrix Section -->
  <Section id="cli-matrix">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
        Bloom CLI Tooling Matrix
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        One unified CLI orchestrating Dart, Flutter, build generators, and deployment channels.
      </p>
    </div>

    {/* Interactive CLI Terminal Explorer */}
    <CLIToolingExplorer client:visible />
  </Section>

  <!-- Performance & Dart Advantage (SEO & Benchmarks) -->
  <Section id="performance-truth" className="pt-8 pb-16">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-mono font-bold">
        <Zap className="w-3.5 h-3.5" />
        Verified Hardware Benchmarks (8 vCPUs, Linux x64)
      </div>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        Why Pure Dart &amp; Bloom Destroy JavaScript at Scale
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg leading-relaxed">
        For years, developers underestimated Dart as a client-only language. In real-world multi-core benchmarks, Bloom’s zero-cost AOT abstractions, native isolates, and pure Dart ORM consistently outpace the dominant Node.js, Fastify, and NestJS ecosystems while consuming <strong>30x less memory</strong>.
      </p>
    </div>

    <!-- 4-Pillar Performance Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
      
      <!-- Card 1: Realtime WebSockets -->
      <div class="p-6 rounded-3xl glass-panel border border-slate-200 dark:border-zinc-800 space-y-4 relative overflow-hidden group hover:border-pink-500/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono font-bold text-pink-500 uppercase tracking-wider">Realtime WebSockets</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-pink-500/10 text-pink-400 border border-pink-500/20">78k msgs/s</span>
        </div>
        <div class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          2x Faster Than Fastify
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          50,000 fan-out messages delivered in <strong>640 ms</strong> across 1,000 active sockets at <strong>3.70 MB RAM</strong>. Fastify &amp; NestJS took 1,260 ms at 115 MB RAM.
        </p>
        <div class="pt-2 border-t border-slate-200 dark:border-zinc-800/80 flex items-center justify-between text-[11px] font-mono">
          <span class="text-slate-500">Memory with 1k Sockets:</span>
          <span class="font-bold text-emerald-500">3.7 MB vs 114 MB</span>
        </div>
      </div>

      <!-- Card 2: Native SQLite ORM -->
      <div class="p-6 rounded-3xl glass-panel border border-slate-200 dark:border-zinc-800 space-y-4 relative overflow-hidden group hover:border-purple-500/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono font-bold text-purple-500 uppercase tracking-wider">SQLite Native ORM</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-purple-500/10 text-purple-400 border border-purple-500/20">12.5k ops/s</span>
        </div>
        <div class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          12.7x Faster Than Prisma
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          5,000 point lookups completed in <strong>400 ms</strong>. Prisma took 5,089 ms and Drizzle took 731 ms. Bulk 2,300+ row update finished in <strong>2 ms</strong>.
        </p>
        <div class="pt-2 border-t border-slate-200 dark:border-zinc-800/80 flex items-center justify-between text-[11px] font-mono">
          <span class="text-slate-500">5k Point Lookups:</span>
          <span class="font-bold text-emerald-500">400ms vs 5,089ms</span>
        </div>
      </div>

      <!-- Card 3: HTTP Concurrency -->
      <div class="p-6 rounded-3xl glass-panel border border-slate-200 dark:border-zinc-800 space-y-4 relative overflow-hidden group hover:border-blue-500/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono font-bold text-blue-500 uppercase tracking-wider">HTTP Concurrency</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20">9.1k req/s</span>
        </div>
        <div class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          3.6x Throughput of NestJS
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Under 1,000 concurrent HTTP keep-alive connections, Bloom maintained <strong>29.3 ms p99 latency</strong> with zero spikes. NestJS spiked to 1,120 ms p99.
        </p>
        <div class="pt-2 border-t border-slate-200 dark:border-zinc-800/80 flex items-center justify-between text-[11px] font-mono">
          <span class="text-slate-500">p99 Latency under 1k Conn:</span>
          <span class="font-bold text-emerald-500">29ms vs 1,120ms</span>
        </div>
      </div>

      <!-- Card 4: SWR Query Layer -->
      <div class="p-6 rounded-3xl glass-panel border border-slate-200 dark:border-zinc-800 space-y-4 relative overflow-hidden group hover:border-emerald-500/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono font-bold text-emerald-500 uppercase tracking-wider">Frontend Query SWR</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">119k ops/s</span>
        </div>
        <div class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          1.5x TanStack Query
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          10,000 bulk cache writes resolved in <strong>84 ms</strong> with zero full widget rebuilds via fine-grained reactive Signals. TanStack Query took 132 ms.
        </p>
        <div class="pt-2 border-t border-slate-200 dark:border-zinc-800/80 flex items-center justify-between text-[11px] font-mono">
          <span class="text-slate-500">1k Request Deduplication:</span>
          <span class="font-bold text-emerald-500">23ms vs 34ms</span>
        </div>
      </div>

    </div>
  </Section>

  <!-- Community & Testimonials -->
  <Section id="community">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
        Loved by Flutter developers
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        Built by Flutter developers, for Flutter developers. Join the conversation.
      </p>
    </div>

    <CommunityShowcase client:visible />
  </Section>

  <!-- FAQ Section for SEO & Developer Discovery -->
  <Section id="faq" className="pt-8 pb-20">
    <HubFAQ />
  </Section>

  <!-- Hero Typewriter Script with Safe Re-entrancy -->
  <script is:inline>
    let typewriterTimer = null;

    function runTypewriter() {
      const target = document.getElementById('heroTypewriter');
      if (!target) return;

      if (target.dataset.typing === 'true') return;
      target.dataset.typing = 'true';

      if (typewriterTimer) clearTimeout(typewriterTimer);
      target.innerHTML = '';
      target.classList.add('typing-cursor');

      const heroSub = document.getElementById('heroSub');
      const heroCmd = document.getElementById('heroCmd');

      if (heroSub) heroSub.classList.add('opacity-0');
      if (heroCmd) heroCmd.classList.add('opacity-0');

      const words = ["Build.", "Ship.", "Bloom."];
      let wordIdx = 0;
      let charIdx = 0;

      function type() {
        if (wordIdx < words.length) {
          if (charIdx < words[wordIdx].length) {
            target.innerHTML += words[wordIdx].charAt(charIdx);
            charIdx++;
            typewriterTimer = setTimeout(type, 70);
          } else {
            if (wordIdx === words.length - 1) {
              target.classList.remove('typing-cursor');
              target.dataset.typing = 'false';
              setTimeout(() => {
                if (heroSub) heroSub.classList.remove('opacity-0');
                if (heroCmd) heroCmd.classList.remove('opacity-0');
              }, 300);
            } else {
              typewriterTimer = setTimeout(() => {
                target.innerHTML += "&nbsp;";
                wordIdx++;
                charIdx = 0;
                type();
              }, 350);
            }
          }
        }
      }
      typewriterTimer = setTimeout(type, 200);
    }

    document.addEventListener('DOMContentLoaded', runTypewriter);
    document.addEventListener('astro:page-load', runTypewriter);
  </script>
</Layout>

<style>
  .falling-petal {
    position: absolute;
    top: -5%;
    will-change: transform, opacity;
    animation: fall-and-sway linear infinite;
    pointer-events: none;
  }
  
  @keyframes fall-and-sway {
    0% {
      transform: translate3d(var(--start-x), -5vh, 0) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: var(--max-opacity);
    }
    90% {
      opacity: var(--max-opacity);
    }
    100% {
      transform: translate3d(var(--end-x), 105vh, 0) rotate(var(--rot));
      opacity: 0;
    }
  }

  /* Support reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .falling-petal {
      animation: none !important;
      display: none;
    }
  }
</style>
