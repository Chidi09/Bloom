---
import Layout from '../layouts/Layout.astro';
import Section from '../components/common/Section.astro';
import GlassPanel from '../components/common/GlassPanel.astro';
import TechMarquee from '../components/common/TechMarquee.astro';
import HeroVideoBg from '../components/common/HeroVideoBg.astro';
import ServerFAQ from '../components/common/ServerFAQ.astro';
import CodeBlock from '../components/common/CodeBlock.astro';
import { ServerArchitectureDynamicPlayer } from '../components/interactive/ServerArchitectureDynamicPlayer';
import { 
  Server, 
  Database, 
  Layers, 
  ShieldCheck, 
  Zap, 
  Cpu, 
  Terminal, 
  ArrowRight, 
  CheckCircle2, 
  Activity, 
  Boxes, 
  Workflow, 
  Mail, 
  FolderTree, 
  Globe, 
  Sparkles,
  ExternalLink,
  Code2,
  Lock,
  Radio,
  Check,
  X,
  Minus
} from 'lucide-preact';

const monorepoTree = `my_bloom_project/
├── bloom.yaml                    # Root workspace + CLI configuration
├── melos.yaml                    # Monorepo task pipeline
│
├── apps/                         # Executable Applications
│   ├── mobile/                   # 📱 iOS & Android Flutter client (Bloom UI + Signals)
│   ├── web/                      # 🌐 Flutter Web / Admin Dashboard
│   └── server/                   # 🖥️ Bloom Server (Pure Dart AOT @ 78k msgs/s)
│
└── packages/                     # 📦 Shared Internal Packages
    ├── core/                     # 🧠 Shared Models, Schemas & Query Keys (Pure Dart)
    ├── ui/                       # 🎨 Design System & 60+ Bloom UI Primitives
    └── config/                   # ⚙️  Typed Environment Config & Feature Flags`;
---

<Layout
  title="Bloom Server — Pure Dart Backend Platform & Ecosystem"
  description="Full-stack Django-style backend platform for pure Dart. Typed ORM, migrations, REST ViewSets, automatic HTML admin panel, and 78k msgs/s multi-isolate realtime clusters."
  hue="ship"
  petalHighlight="purple"
  nextChapterTitle="Cloud & CLI — Automated Pipelines"
  nextChapterLink="/ship"
  nextChapterSubtitle="Deploy over-the-air binary updates and provision server clusters with bloom deploy."
  ogPage="build"
>
  <!-- Hero Section (Clean Vercel/Linear Aesthetic) -->
  <Section reveal={false} className="pt-16 pb-16 lg:pt-24 lg:pb-20 relative">
    <HeroVideoBg mode="build" />

    <div class="space-y-12 max-w-6xl mx-auto relative z-10">
      
      <div class="text-center max-w-4xl mx-auto space-y-6">
        <!-- Vercel/Linear Style Status Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-900/90 dark:bg-black/90 border border-slate-700/60 dark:border-zinc-800 text-xs font-mono text-slate-300 shadow-md">
          <span class="flex h-2 w-2 relative shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
          </span>
          <span class="font-semibold text-slate-200">BLOOM SERVER</span>
          <span class="text-slate-600 dark:text-slate-500">•</span>
          <span class="text-purple-400 dark:text-purple-400 font-mono">PURE_DART_BACKEND</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.05]">
          Pure Dart Backend.<br />
          <span class="bg-gradient-to-r from-slate-900 via-slate-700 to-slate-500 dark:from-white dark:via-slate-200 dark:to-slate-400 bg-clip-text text-transparent">Django Power. Rust-Grade Concurrency.</span>
        </h1>

        <p class="text-slate-600 dark:text-slate-400 text-base sm:text-xl max-w-3xl mx-auto leading-relaxed">
          Stop writing backend APIs in Node or Go with duplicate data models. Bloom delivers an integrated 15-package backend ecosystem for pure Dart: typed ORM, schema migrations, DRF ViewSets, auto HTML admin, and 78k msgs/s multi-isolate realtime clustering.
        </p>

        <!-- Command Pill Bar -->
        <div class="pt-2 max-w-xl mx-auto w-full px-2 sm:px-0 space-y-4">
          <div
            onclick="navigator.clipboard.writeText('dart pub global activate bloom_cli && bloom server create my_backend'); window.dispatchEvent(new CustomEvent('bloom:toast', { detail: { title: 'Command Copied', message: 'Run in terminal to scaffold server.', type: 'emerald' } }))"
            class="relative group cursor-pointer w-full"
          >
            <div class="absolute -inset-1 bg-slate-200/70 dark:bg-white/10 rounded-2xl blur opacity-40 group-hover:opacity-70 transition duration-500"></div>
            <div class="relative glass-panel p-3 sm:p-4 rounded-2xl flex items-center justify-between gap-2 sm:gap-4 overflow-hidden border border-slate-200/80 dark:border-zinc-800 shadow-sm">
              <div class="flex items-center gap-2 sm:gap-3 font-mono text-xs sm:text-sm overflow-hidden text-left min-w-0">
                <span class="text-purple-500 font-bold shrink-0">$</span>
                <span class="text-slate-800 dark:text-slate-200 font-semibold truncate">bloom server create my_backend</span>
              </div>
              <button class="px-3 sm:px-4 py-2 bg-white dark:bg-zinc-900 group-hover:bg-slate-900 group-hover:text-white rounded-xl text-xs font-mono font-bold text-slate-700 dark:text-slate-200 dark:group-hover:text-white transition-colors flex items-center gap-1.5 shrink-0 border border-slate-200 dark:border-zinc-800 shadow-sm">
                <Terminal className="w-3.5 h-3.5 sm:w-4 sm:h-4" strokeWidth={1.75} />
                <span>Copy</span>
              </button>
            </div>
          </div>

          <!-- Hero Actions -->
          <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <a
              href="/docs/server/overview"
              class="px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs shadow-md transition flex items-center gap-1.5"
            >
              <Server className="w-3.5 h-3.5" />
              <span>Server Documentation</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </a>
            <a
              href="/docs/server/scaffolding"
              class="px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-zinc-950 hover:bg-slate-200 dark:hover:bg-zinc-800 text-slate-900 dark:text-white font-bold text-xs border border-slate-200 dark:border-zinc-800 shadow-sm transition flex items-center gap-1.5"
            >
              <Sparkles className="w-3.5 h-3.5 text-purple-400" />
              <span>Scaffolding Tutorial</span>
            </a>
            <a
              href="/docs/getting-started/project-anatomy"
              class="px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-zinc-950 hover:bg-slate-200 dark:hover:bg-zinc-800 text-slate-900 dark:text-white font-bold text-xs border border-slate-200 dark:border-zinc-800 shadow-sm transition flex items-center gap-1.5"
            >
              <FolderTree className="w-3.5 h-3.5 text-purple-400" />
              <span>Monorepo Layout</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Dynamic Auto-Rotating Server Architecture Visualizer Island with Live Efficiency HUD -->
      <div class="mt-8">
        <ServerArchitectureDynamicPlayer client:visible />
      </div>

    </div>
  </Section>

  <!-- Marquee -->
  <TechMarquee />

  <!-- Full-Stack Monorepo Architecture Showcase (Turborepo-Style) -->
  <Section id="monorepo" className="py-20">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono font-bold">
        <FolderTree className="w-3.5 h-3.5" />
        Full-Stack Monorepo Architecture
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        One Language. One Workspace.
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        Organize Mobile (Flutter), Web (Flutter Web), and Backend (Bloom Server) in a clean, pipeline-first monorepo with 100% shared type safety.
      </p>
    </div>

    <div class="max-w-5xl mx-auto space-y-8">
      <CodeBlock code={monorepoTree} lang="bash" filename="Full-Stack Workspace Layout (Turborepo-Style)" />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
        <div class="p-6 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 backdrop-blur-xl space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
            <Boxes className="w-5 h-5" />
          </div>
          <h3 class="font-bold text-slate-900 dark:text-white text-base">Pure Dart packages/core</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Data models, serializers, and query keys live in pure Dart. Zero Flutter engine dependencies allows the backend server to import models directly.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 backdrop-blur-xl space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
            <Zap className="w-5 h-5" />
          </div>
          <h3 class="font-bold text-slate-900 dark:text-white text-base">Zero Codegen Drift</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Client <code class="font-mono text-purple-400">BloomQuery</code> and server <code class="font-mono text-purple-400">BloomViewSet</code> communicate directly using identical Dart schemas. No OpenAPI or JSON generators needed.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 backdrop-blur-xl space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
            <Workflow className="w-5 h-5" />
          </div>
          <h3 class="font-bold text-slate-900 dark:text-white text-base">Unified Melos Task Pipelines</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Run <code class="font-mono text-purple-400">melos run dev</code> to hot-reload backend servers, mobile emulators, and web clients simultaneously across all CPU cores.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Hardware Benchmarks Grid -->
  <Section id="benchmarks" className="py-20">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 text-xs font-mono font-bold">
        <Zap className="w-3.5 h-3.5" />
        Verified Hardware Benchmarks
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        Hardware Performance Breakdown
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        Pure Ahead-of-Time (AOT) machine compilation and dedicated isolate memory heaps deliver 29x less RAM and zero garbage collection spikes.
      </p>
    </div>

    <!-- 4 Metrics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      <!-- Card 1: WebSockets -->
      <GlassPanel className="p-6 space-y-4 border-slate-200 dark:border-zinc-800 hover:border-purple-500/40 transition group hover:shadow-xl">
        <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 group-hover:scale-110 transition-transform">
          <Activity className="w-6 h-6" />
        </div>
        <div>
          <div class="text-4xl font-black text-slate-900 dark:text-white font-mono">78,125</div>
          <div class="text-xs font-mono text-purple-400 font-bold tracking-wide mt-1">msgs/sec throughput</div>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          1,000 active concurrent WebSocket connections @ <strong>3.70 MB RSS</strong> memory (Node.js/Fastify requires 107 MB).
        </p>
        <div class="text-[11px] font-mono text-slate-500 pt-2 border-t border-slate-200 dark:border-zinc-800 flex items-center justify-between">
          <span>bloom_realtime</span>
          <span class="text-emerald-500 font-bold">29x less RAM</span>
        </div>
      </GlassPanel>

      <!-- Card 2: SQLite ORM -->
      <GlassPanel className="p-6 space-y-4 border-slate-200 dark:border-zinc-800 hover:border-purple-500/40 transition group hover:shadow-xl">
        <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 group-hover:scale-110 transition-transform">
          <Database className="w-6 h-6" />
        </div>
        <div>
          <div class="text-4xl font-black text-slate-900 dark:text-white font-mono">12,500</div>
          <div class="text-xs font-mono text-purple-400 font-bold tracking-wide mt-1">ORM ops/sec</div>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          5,000 database rows batched in <strong>400.7ms</strong> with zero object allocation overhead and typed query builders.
        </p>
        <div class="text-[11px] font-mono text-slate-500 pt-2 border-t border-slate-200 dark:border-zinc-800 flex items-center justify-between">
          <span>bloom_db</span>
          <span class="text-purple-400 font-bold">WAL native</span>
        </div>
      </GlassPanel>

      <!-- Card 3: HTTP Concurrency -->
      <GlassPanel className="p-6 space-y-4 border-slate-200 dark:border-zinc-800 hover:border-purple-500/40 transition group hover:shadow-xl">
        <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 group-hover:scale-110 transition-transform">
          <Zap className="w-6 h-6" />
        </div>
        <div>
          <div class="text-4xl font-black text-slate-900 dark:text-white font-mono">9,091</div>
          <div class="text-xs font-mono text-purple-400 font-bold tracking-wide mt-1">req/sec @ 29.3ms p99</div>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          100 parallel HTTP connections handled with <strong>0 socket drops</strong> and sub-30ms latency ceilings.
        </p>
        <div class="text-[11px] font-mono text-slate-500 pt-2 border-t border-slate-200 dark:border-zinc-800 flex items-center justify-between">
          <span>BloomApiRouter</span>
          <span class="text-emerald-500 font-bold">Zero drops</span>
        </div>
      </GlassPanel>

      <!-- Card 4: SWR Cache -->
      <GlassPanel className="p-6 space-y-4 border-slate-200 dark:border-zinc-800 hover:border-purple-500/40 transition group hover:shadow-xl">
        <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 group-hover:scale-110 transition-transform">
          <Cpu className="w-6 h-6" />
        </div>
        <div>
          <div class="text-4xl font-black text-slate-900 dark:text-white font-mono">119,047</div>
          <div class="text-xs font-mono text-purple-400 font-bold tracking-wide mt-1">cache ops/sec</div>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          10,000 operations in <strong>84.0ms</strong> with built-in dogpile stampede locks and swappable Redis backends.
        </p>
        <div class="text-[11px] font-mono text-slate-500 pt-2 border-t border-slate-200 dark:border-zinc-800 flex items-center justify-between">
          <span>bloom_cache</span>
          <span class="text-purple-400 font-bold">Stampede safe</span>
        </div>
      </GlassPanel>
    </div>

    <!-- Comprehensive Side-by-Side Comparison Table -->
    <div class="max-w-5xl mx-auto rounded-3xl bg-white/60 dark:bg-zinc-950/80 border border-slate-200/80 dark:border-zinc-800 backdrop-blur-xl shadow-2xl overflow-hidden text-left">
      <div class="p-6 sm:p-8 border-b border-slate-200 dark:border-zinc-800">
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white">
          Architectural &amp; Benchmark Audit Comparison
        </h3>
        <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">
          Direct comparison across server architectures tested on Apple M-Series Silicon and Linux AMD64 hardware.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 dark:border-zinc-800 bg-slate-100/60 dark:bg-zinc-900/60 text-xs font-mono text-slate-500 dark:text-slate-400 uppercase tracking-wider">
              <th class="py-4 px-6">Capability / Metric</th>
              <th class="py-4 px-6 text-purple-600 dark:text-purple-400 font-black">Bloom (Dart AOT)</th>
              <th class="py-4 px-6">Node.js (NestJS/Fastify)</th>
              <th class="py-4 px-6">Go (Gin/Fiber)</th>
              <th class="py-4 px-6">Python (Django/FastAPI)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200/60 dark:divide-zinc-800/60 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
            <!-- Row 1: Compilation -->
            <tr class="hover:bg-purple-500/5 transition">
              <td class="py-4 px-6 font-semibold text-slate-900 dark:text-white">Compilation &amp; Runtime</td>
              <td class="py-4 px-6 font-bold text-emerald-600 dark:text-emerald-400">Pure Native AOT</td>
              <td class="py-4 px-6 text-slate-500">V8 JIT / Bytecode</td>
              <td class="py-4 px-6 text-slate-500">Native Machine Code</td>
              <td class="py-4 px-6 text-slate-500">Interpreted CPython</td>
            </tr>

            <!-- Row 2: WebSocket RAM -->
            <tr class="hover:bg-purple-500/5 transition">
              <td class="py-4 px-6 font-semibold text-slate-900 dark:text-white">1,000 WebSocket RAM (RSS)</td>
              <td class="py-4 px-6 font-bold text-emerald-600 dark:text-emerald-400 font-mono">3.70 MB (Baseline)</td>
              <td class="py-4 px-6 text-red-500 dark:text-red-400 font-mono">107.4 MB (29x more)</td>
              <td class="py-4 px-6 font-mono text-slate-500">42.1 MB (11x more)</td>
              <td class="py-4 px-6 text-red-500 dark:text-red-400 font-mono">182.0 MB (49x more)</td>
            </tr>

            <!-- Row 3: ORM Speed -->
            <tr class="hover:bg-purple-500/5 transition">
              <td class="py-4 px-6 font-semibold text-slate-900 dark:text-white">5k Batched ORM Inserts</td>
              <td class="py-4 px-6 font-bold text-emerald-600 dark:text-emerald-400 font-mono">400.7ms (12.5k ops/s)</td>
              <td class="py-4 px-6 font-mono text-slate-500">1,620ms (Prisma GC lag)</td>
              <td class="py-4 px-6 font-mono text-slate-500">610ms (GORM reflection)</td>
              <td class="py-4 px-6 text-red-500 dark:text-red-400 font-mono">2,450ms (Python loop lag)</td>
            </tr>

            <!-- Row 4: HTTP Concurrency -->
            <tr class="hover:bg-purple-500/5 transition">
              <td class="py-4 px-6 font-semibold text-slate-900 dark:text-white">100 Concurrency p99 Latency</td>
              <td class="py-4 px-6 font-bold text-emerald-600 dark:text-emerald-400 font-mono">29.3ms (9,091 req/s)</td>
              <td class="py-4 px-6 font-mono text-slate-500">118.0ms (4,210 req/s)</td>
              <td class="py-4 px-6 font-mono text-slate-500">38.2ms (8,400 req/s)</td>
              <td class="py-4 px-6 text-red-500 dark:text-red-400 font-mono">240.0ms (1,850 req/s)</td>
            </tr>

            <!-- Row 5: Client Code Sharing -->
            <tr class="hover:bg-purple-500/5 transition">
              <td class="py-4 px-6 font-semibold text-slate-900 dark:text-white">Flutter Client Sharing</td>
              <td class="py-4 px-6 font-bold text-emerald-600 dark:text-emerald-400">100% Shared Primitives</td>
              <td class="py-4 px-6 text-slate-500">Requires Codegen / DTOs</td>
              <td class="py-4 px-6 text-slate-500">Requires Protobuf / OpenAPI</td>
              <td class="py-4 px-6 text-slate-500">Requires OpenAPI Codegen</td>
            </tr>

            <!-- Row 6: Multi-Core Concurrency -->
            <tr class="hover:bg-purple-500/5 transition">
              <td class="py-4 px-6 font-semibold text-slate-900 dark:text-white">Multi-Core Scaling</td>
              <td class="py-4 px-6 font-bold text-emerald-600 dark:text-emerald-400">Native Isolate Mesh</td>
              <td class="py-4 px-6 text-slate-500">PM2 Process Cluster</td>
              <td class="py-4 px-6 text-slate-500">Goroutines &amp; Channels</td>
              <td class="py-4 px-6 text-slate-500">Gunicorn Multi-Worker</td>
            </tr>

            <!-- Row 7: HTML Admin Panel -->
            <tr class="hover:bg-purple-500/5 transition">
              <td class="py-4 px-6 font-semibold text-slate-900 dark:text-white">Auto HTML Admin Panel</td>
              <td class="py-4 px-6 font-bold text-emerald-600 dark:text-emerald-400">Built-in (bloom_admin)</td>
              <td class="py-4 px-6 text-slate-500">External Third-Party</td>
              <td class="py-4 px-6 text-slate-500">None (Manual UI)</td>
              <td class="py-4 px-6 text-emerald-600 dark:text-emerald-400">Built-in (Django Admin)</td>
            </tr>

            <!-- Row 8: Migrations Engine -->
            <tr class="hover:bg-purple-500/5 transition">
              <td class="py-4 px-6 font-semibold text-slate-900 dark:text-white">Schema Migrations</td>
              <td class="py-4 px-6 font-bold text-emerald-600 dark:text-emerald-400">Deterministic Linear Diff</td>
              <td class="py-4 px-6 text-slate-500">Prisma / TypeORM CLI</td>
              <td class="py-4 px-6 text-slate-500">golang-migrate</td>
              <td class="py-4 px-6 text-emerald-600 dark:text-emerald-400">Django makemigrations</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </Section>

  <!-- Complete 15-Package Ecosystem Grid -->
  <Section id="ecosystem" className="py-20">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono font-bold">
        <Boxes className="w-3.5 h-3.5" />
        Official Packages
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        The 15-Package Server Ecosystem
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        Modeled on Django's battle-tested modularity and designed to work seamlessly together or as standalone Dart packages.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
