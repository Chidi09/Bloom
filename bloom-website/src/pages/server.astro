<!-- Client Tab Switcher Script for Architecture Explorer -->
<script is:inline>
  function setupServerTabSwitcher() {
    const tabButtons = document.querySelectorAll('#server-tab-buttons .tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');
    if (!tabButtons.length) return;

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');

        // Update button states
        tabButtons.forEach((b) => {
          if (b === btn) {
            b.classList.add('bg-zinc-800', 'text-white', 'border', 'border-zinc-700');
            b.classList.remove('text-slate-400', 'hover:bg-zinc-900');
          } else {
            b.classList.remove('bg-zinc-800', 'text-white', 'border', 'border-zinc-700');
            b.classList.add('text-slate-400', 'hover:bg-zinc-900');
          }
        });

        // Show target panel
        tabPanels.forEach((panel) => {
          if (panel.id === `tab-panel-${targetTab}`) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupServerTabSwitcher);
  } else {
    setupServerTabSwitcher();
  }

  document.addEventListener('astro:page-load', setupServerTabSwitcher);
</script>
