---
import Layout from '../layouts/Layout.astro';
import Section from '../components/common/Section.astro';
import GlassPanel from '../components/common/GlassPanel.astro';
import TechMarquee from '../components/common/TechMarquee.astro';
import HeroVideoBg from '../components/common/HeroVideoBg.astro';
import ServerFAQ from '../components/common/ServerFAQ.astro';
import { ServerArchitecturePlayground } from '../components/interactive/ServerArchitecturePlayground';
import { 
  Server, 
  Database, 
  Layers, 
  ShieldCheck, 
  Zap, 
  Cpu, 
  Terminal, 
  ArrowRight, 
  CheckCircle2, 
  Activity, 
  Flame, 
  Boxes, 
  Workflow, 
  Mail, 
  FolderTree, 
  Globe, 
  Sparkles,
  ExternalLink,
  Code2,
  Lock,
  Radio
} from 'lucide-preact';

const colors = ['#FF4B8B', '#EC4899', '#8B5CF6', '#20C9B0', '#3B82F6'];
const fallingPetals = Array.from({ length: 20 }).map((_, i) => {
  const size = Math.random() * 40 + 40;
  const left = Math.random() * 100;
  const duration = Math.random() * 12 + 12;
  const delay = Math.random() * -24;
  const startX = (Math.random() * 60 - 30) + 'px';
  const endX = (Math.random() * 120 - 60) + 'px';
  const maxOpacity = Math.random() * 0.35 + 0.15;
  const rot = (Math.random() * 720 - 360) + 'deg';
  const color = colors[i % colors.length];
  return { size, left, duration, delay, startX, endX, maxOpacity, rot, color };
});
---

<Layout
  title="Bloom Server — Pure Dart Backend Platform & Ecosystem"
  description="Full-stack Django-style backend ecosystem for pure Dart. Typed ORM, migrations, REST ViewSets, automatic HTML admin panel, and 78k msgs/s multi-isolate realtime clusters."
  hue="bloom"
  petalHighlight="pink"
  nextChapterTitle="Cloud & CLI — Automated Pipelines"
  nextChapterLink="/ship"
  nextChapterSubtitle="Deploy over-the-air binary updates and provision server clusters with bloom deploy."
  ogPage="bloom"
>
  <!-- Hero Section -->
  <Section reveal={false} className="pt-16 pb-16 lg:pt-24 lg:pb-20 relative">
    <!-- Falling Petals Background -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10 select-none">
      {fallingPetals.map((petal) => (
        <div
          class="falling-petal"
          style={`
            left: ${petal.left}%;
            width: ${petal.size}px;
            height: ${petal.size}px;
            color: ${petal.color};
            animation-duration: ${petal.duration}s;
            animation-delay: ${petal.delay}s;
            --start-x: ${petal.startX};
            --end-x: ${petal.endX};
            --max-opacity: ${petal.maxOpacity};
            --rot: ${petal.rot};
          `}
        >
          <svg viewBox="0 0 200 200" fill="none" class="w-full h-full opacity-70">
            <path d="M100 20 C130 20 145 60 125 90 C110 100 90 100 75 90 C55 60 70 20 100 20 Z" fill="currentColor" />
          </svg>
        </div>
      ))}
    </div>

    <HeroVideoBg mode="bloom" />

    <div class="text-center max-w-5xl mx-auto space-y-6 relative z-10">

      <!-- Announcement Pill -->
      <a href="/docs/server/overview" class="inline-flex flex-wrap items-center justify-center gap-2 px-4 py-1.5 rounded-full glass-panel shadow-sm text-xs font-medium hover:scale-105 transition cursor-pointer group mb-2 max-w-[90vw] text-center border-pink-500/30">
        <span class="flex h-2 w-2 relative shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pink-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-pink-500"></span>
        </span>
        <span class="text-slate-600 dark:text-slate-300">Bloom Server v0.2.0 Ecosystem Released on pub.dev</span>
        <span class="font-bold text-pink-600 dark:text-pink-400 group-hover:text-pink-300 flex items-center gap-1 shrink-0">
          Read Server Guide <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
        </span>
      </a>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-8xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.05]">
        Pure Dart Backend.<br />
        <span class="bg-gradient-to-r from-pink-500 via-purple-500 to-cyan-400 bg-clip-text text-transparent">Django Architecture. Rust Concurrency.</span>
      </h1>

      <p class="text-slate-600 dark:text-slate-400 text-lg sm:text-xl max-w-3xl mx-auto leading-relaxed font-normal">
        Stop writing backend APIs in Node or Go with duplicate data schemas. Bloom delivers an integrated 15-package backend ecosystem for pure Dart: typed ORM, schema migrations, DRF ViewSets, auto HTML admin, and 78k msgs/s multi-isolate realtime clustering.
      </p>

      <!-- Quick Command Bar -->
      <div class="pt-4 max-w-xl mx-auto w-full px-2 sm:px-0 space-y-4">
        <div
          onclick="navigator.clipboard.writeText('dart pub global activate bloom_cli && bloom server create my_server'); window.dispatchEvent(new CustomEvent('bloom:toast', { detail: { title: 'Command Copied', message: 'Run in terminal to scaffold server.', type: 'emerald' } }))"
          class="relative group cursor-pointer w-full"
        >
          <div class="absolute -inset-1 bg-pink-500/20 rounded-2xl blur opacity-40 group-hover:opacity-70 transition duration-500"></div>
          <div class="relative glass-panel p-3 sm:p-4 rounded-2xl flex items-center justify-between gap-2 sm:gap-4 overflow-hidden border border-pink-500/30">
            <div class="flex items-center gap-2 sm:gap-3 font-mono text-xs sm:text-sm overflow-hidden text-left min-w-0">
              <span class="text-pink-500 font-bold shrink-0">$</span>
              <span class="text-slate-800 dark:text-slate-200 font-semibold truncate">bloom server create my_backend</span>
            </div>
            <button class="px-3 sm:px-4 py-2 bg-pink-600 text-white rounded-xl text-xs font-mono font-bold transition-transform hover:scale-105 flex items-center gap-1.5 shrink-0 shadow-md">
              <Terminal className="w-3.5 h-3.5 sm:w-4 sm:h-4" strokeWidth={1.75} />
              <span>Copy</span>
            </button>
          </div>
        </div>

        <!-- Hero Actions -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <a
            href="/docs/server/overview"
            class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white font-bold text-xs shadow-md transition flex items-center gap-1.5"
          >
            <Server className="w-3.5 h-3.5" />
            <span>Server Documentation</span>
            <ArrowRight className="w-3.5 h-3.5" />
          </a>
          <a
            href="/docs/server/scaffolding"
            class="px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-zinc-950 hover:bg-slate-200 dark:hover:bg-zinc-800 text-slate-900 dark:text-white font-bold text-xs border border-slate-200 dark:border-zinc-800 shadow-sm transition flex items-center gap-1.5"
          >
            <Sparkles className="w-3.5 h-3.5 text-purple-400" />
            <span>Scaffolding Tutorial</span>
          </a>
          <a
            href="/docs/server/orm-and-migrations"
            class="px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-zinc-950 hover:bg-slate-200 dark:hover:bg-zinc-800 text-slate-900 dark:text-white font-bold text-xs border border-slate-200 dark:border-zinc-800 shadow-sm transition flex items-center gap-1.5"
          >
            <Database className="w-3.5 h-3.5 text-pink-400" />
            <span>ORM &amp; Migrations</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Interactive Server Architecture Visualizer / Code Switcher -->
    <div class="mt-14 relative z-10">
      <ServerArchitecturePlayground client:visible />
    </div>
  </Section>

  <!-- Marquee -->
  <TechMarquee />

  <!-- Hardware Benchmarks Grid -->
  <Section id="benchmarks" className="py-20">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 text-xs font-mono font-bold">
        <Zap className="w-3.5 h-3.5" />
        Hardware Benchmarked on Apple M-Series &amp; Linux AMD64
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        Why Pure Dart Destroys Node.js at Scale
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        Pure Ahead-of-Time (AOT) machine compilation and dedicated isolate memory heaps deliver 29x less RAM and sub-millisecond tail latencies.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Card 1: WebSockets -->
      <GlassPanel className="p-6 space-y-4 border-pink-500/20 hover:border-pink-500/40 transition group hover:shadow-xl hover:shadow-pink-500/5">
        <div class="w-12 h-12 rounded-2xl bg-pink-500/10 border border-pink-500/20 flex items-center justify-center text-pink-500 group-hover:scale-110 transition-transform">
          <Activity className="w-6 h-6" />
        </div>
        <div>
          <div class="text-4xl font-black text-slate-900 dark:text-white font-mono">78,125</div>
          <div class="text-xs font-mono text-pink-500 font-bold tracking-wide mt-1">msgs/sec throughput</div>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          1,000 active concurrent WebSocket connections @ <strong>3.70 MB RSS</strong> memory (Node.js/Fastify requires 107 MB).
        </p>
        <div class="text-[11px] font-mono text-slate-500 pt-2 border-t border-slate-200 dark:border-zinc-800 flex items-center justify-between">
          <span>bloom_realtime</span>
          <span class="text-emerald-500 font-bold">29x less RAM</span>
        </div>
      </GlassPanel>

      <!-- Card 2: SQLite ORM -->
      <GlassPanel className="p-6 space-y-4 border-purple-500/20 hover:border-purple-500/40 transition group hover:shadow-xl hover:shadow-purple-500/5">
        <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-500 group-hover:scale-110 transition-transform">
          <Database className="w-6 h-6" />
        </div>
        <div>
          <div class="text-4xl font-black text-slate-900 dark:text-white font-mono">12,500</div>
          <div class="text-xs font-mono text-purple-400 font-bold tracking-wide mt-1">ORM ops/sec</div>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          5,000 database rows batched in <strong>400.7ms</strong> with zero object allocation overhead and typed query builders.
        </p>
        <div class="text-[11px] font-mono text-slate-500 pt-2 border-t border-slate-200 dark:border-zinc-800 flex items-center justify-between">
          <span>bloom_db</span>
          <span class="text-purple-400 font-bold">WAL native</span>
        </div>
      </GlassPanel>

      <!-- Card 3: HTTP Concurrency -->
      <GlassPanel className="p-6 space-y-4 border-cyan-500/20 hover:border-cyan-500/40 transition group hover:shadow-xl hover:shadow-cyan-500/5">
        <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 group-hover:scale-110 transition-transform">
          <Zap className="w-6 h-6" />
        </div>
        <div>
          <div class="text-4xl font-black text-slate-900 dark:text-white font-mono">9,091</div>
          <div class="text-xs font-mono text-cyan-400 font-bold tracking-wide mt-1">req/sec @ 29.3ms p99</div>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          100 parallel HTTP connections handled with <strong>0 socket drops</strong> and sub-30ms latency ceilings.
        </p>
        <div class="text-[11px] font-mono text-slate-500 pt-2 border-t border-slate-200 dark:border-zinc-800 flex items-center justify-between">
          <span>BloomApiRouter</span>
          <span class="text-cyan-400 font-bold">Zero drops</span>
        </div>
      </GlassPanel>

      <!-- Card 4: SWR Cache -->
      <GlassPanel className="p-6 space-y-4 border-amber-500/20 hover:border-amber-500/40 transition group hover:shadow-xl hover:shadow-amber-500/5">
        <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
          <Cpu className="w-6 h-6" />
        </div>
        <div>
          <div class="text-4xl font-black text-slate-900 dark:text-white font-mono">119,047</div>
          <div class="text-xs font-mono text-amber-400 font-bold tracking-wide mt-1">cache ops/sec</div>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          10,000 operations in <strong>84.0ms</strong> with built-in dogpile stampede locks and swappable Redis backends.
        </p>
        <div class="text-[11px] font-mono text-slate-500 pt-2 border-t border-slate-200 dark:border-zinc-800 flex items-center justify-between">
          <span>bloom_cache</span>
          <span class="text-amber-400 font-bold">Lock-free LRU</span>
        </div>
      </GlassPanel>
    </div>
  </Section>

  <!-- Complete 15-Package Ecosystem Grid -->
  <Section id="ecosystem" className="py-20">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono font-bold">
        <Boxes className="w-3.5 h-3.5" />
        Official Packages
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        The 15-Package Server Ecosystem
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        Modeled on Django's battle-tested modularity and designed to work seamlessly together or as standalone Dart packages.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 1. bloom_framework -->
      <a href="/docs/framework/quickstart" class="p-5 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 hover:border-purple-500/40 backdrop-blur-xl transition group hover:shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-purple-600 dark:text-purple-400 group-hover:underline">bloom_framework</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">v0.2.2</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Core foundational primitives, request/response models, and unified client-server pipeline.</p>
      </a>

      <!-- 2. bloom_db -->
      <a href="/docs/server/orm-and-migrations" class="p-5 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 hover:border-purple-500/40 backdrop-blur-xl transition group hover:shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-purple-600 dark:text-purple-400 group-hover:underline">bloom_db</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">v0.1.0</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Declarative typed ORM with compile-time query safety for SQLite and PostgreSQL.</p>
      </a>

      <!-- 3. bloom_migrate -->
      <a href="/docs/server/orm-and-migrations" class="p-5 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 hover:border-purple-500/40 backdrop-blur-xl transition group hover:shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-purple-600 dark:text-purple-400 group-hover:underline">bloom_migrate</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">v0.1.0</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Automatic schema diffing and linear migration execution engine without manual SQL.</p>
      </a>

      <!-- 4. bloom_rest -->
      <a href="/docs/server/rest-api" class="p-5 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 hover:border-pink-500/40 backdrop-blur-xl transition group hover:shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-pink-600 dark:text-pink-400 group-hover:underline">bloom_rest</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">v0.1.0</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">DRF-style REST layer with ViewSets, serializers, pagination, filters, and throttle rules.</p>
      </a>

      <!-- 5. bloom_admin -->
      <a href="/docs/server/admin-panel" class="p-5 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 hover:border-pink-500/40 backdrop-blur-xl transition group hover:shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-pink-600 dark:text-pink-400 group-hover:underline">bloom_admin</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">v0.1.0</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Zero-config server-rendered HTML administration interface for your database models.</p>
      </a>

      <!-- 6. bloom_realtime -->
      <a href="/docs/server/realtime" class="p-5 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 hover:border-cyan-500/40 backdrop-blur-xl transition group hover:shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-cyan-600 dark:text-cyan-400 group-hover:underline">bloom_realtime</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">v0.2.0</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">High-throughput WebSocket pub/sub with multi-isolate clustering (78,125 msgs/s).</p>
      </a>

      <!-- 7. bloom_cache -->
      <a href="/docs/server/caching" class="p-5 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 hover:border-amber-500/40 backdrop-blur-xl transition group hover:shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-amber-600 dark:text-amber-400 group-hover:underline">bloom_cache</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">v0.1.0</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Memory LRU, Database, and Redis backends with cache stampede prevention locks.</p>
      </a>

      <!-- 8. bloom_auth_server -->
      <a href="/docs/server/auth" class="p-5 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 hover:border-purple-500/40 backdrop-blur-xl transition group hover:shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-purple-600 dark:text-purple-400 group-hover:underline">bloom_auth_server</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">v0.1.0</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Session and JWT authentication server with bcrypt password hashing and RBAC.</p>
      </a>

      <!-- 9. bloom_jobs -->
      <a href="/docs/server/jobs-mail-and-storage" class="p-5 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 hover:border-purple-500/40 backdrop-blur-xl transition group hover:shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-purple-600 dark:text-purple-400 group-hover:underline">bloom_jobs</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">v0.1.0</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Asynchronous background worker queue with retries, cron, and concurrency controls.</p>
      </a>

      <!-- 10. bloom_mail -->
      <a href="/docs/server/jobs-mail-and-storage" class="p-5 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 hover:border-purple-500/40 backdrop-blur-xl transition group hover:shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-purple-600 dark:text-purple-400 group-hover:underline">bloom_mail</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">v0.1.0</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Transactional email engine with SMTP, SendGrid, and Postmark delivery backends.</p>
      </a>

      <!-- 11. bloom_storage -->
      <a href="/docs/server/jobs-mail-and-storage" class="p-5 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 hover:border-purple-500/40 backdrop-blur-xl transition group hover:shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-purple-600 dark:text-purple-400 group-hover:underline">bloom_storage</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">v0.1.0</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Swappable file storage abstraction (Local disk, AWS S3, Cloudflare R2, MinIO).</p>
      </a>

      <!-- 12. bloom_security -->
      <a href="/docs/server/i18n-and-security" class="p-5 rounded-2xl bg-white/60 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-zinc-800 hover:border-purple-500/40 backdrop-blur-xl transition group hover:shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-purple-600 dark:text-purple-400 group-hover:underline">bloom_security</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">v0.1.0</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Security headers, CSRF token validation, CORS, and rate-limiting middleware.</p>
      </a>
    </div>
  </Section>

  <!-- Server FAQ Section -->
  <Section id="faq" className="py-20">
    <ServerFAQ />
  </Section>

  <!-- Final Call to Action -->
  <Section className="pb-24">
