---
import Layout from '../layouts/Layout.astro';
import Section from '../components/common/Section.astro';
import GlassPanel from '../components/common/GlassPanel.astro';
import { TerminalDeploy } from '../components/interactive/TerminalDeploy';
import { VercelShipDashboard } from '../components/interactive/VercelShipDashboard';
import { OTAReleasePlayground } from '../components/interactive/OTAReleasePlayground';
import { WirelessQRVisualizer } from '../components/interactive/WirelessQRVisualizer';
import { ProgrammaticUpdateExplorer } from '../components/interactive/ProgrammaticUpdateExplorer';
import { EnterpriseOTATopology } from '../components/interactive/EnterpriseOTATopology';
import HeroVideoBg from '../components/common/HeroVideoBg.astro';
import { Box, ShieldCheck, Zap, ArrowRight, CheckCircle2, Globe, Lock, QrCode, Wifi, Building2, ScrollText, Cpu, GitBranch, Rocket, Settings2, KeyRound, FileKey, Route, Activity, Workflow, Store, CreditCard, ExternalLink } from 'lucide-preact';
---

<Layout
  title="SHIP — Bloom Cloud OTA & Deploy Pipeline"
  description="Integrated Shorebird over-the-air (OTA) updates, remote build farm, preview channels, and cryptographic patch signing for Flutter."
  hue="ship"
  petalHighlight="blue"
  nextChapterTitle="BLOOM — UI Studio & Tokens"
  nextChapterLink="/bloom"
  nextChapterSubtitle="Customize design tokens, color swatches, radii, and preview production-ready Flutter components."
  ogPage="ship"
>
  <!-- Hero Section (Vercel / Linear Aesthetic) -->
  <Section reveal={false} className="pt-16 pb-16 lg:pt-24 lg:pb-20 relative">
    <HeroVideoBg mode="ship" />
    <div class="space-y-12 max-w-6xl mx-auto relative z-10">
      
      <div class="text-center max-w-3xl mx-auto space-y-6">
        <!-- Vercel/Linear Style Status Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-900/90 dark:bg-black/90 border border-slate-700/60 dark:border-zinc-800 text-xs font-mono text-slate-300 shadow-md">
          <span class="flex h-2 w-2 relative shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-slate-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-slate-500"></span>
          </span>
          <span class="font-semibold text-slate-200">CHAPTER 02</span>
          <span class="text-slate-600 dark:text-slate-500">•</span>
          <span class="text-slate-400 dark:text-slate-400 font-mono">OTA_DEPLOY_PIPELINE</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.05]">
          Ship instantly.<br />
          <span class="bg-gradient-to-r from-slate-900 via-slate-700 to-slate-500 dark:from-white dark:via-slate-200 dark:to-slate-400 bg-clip-text text-transparent">Shorebird-Powered OTA.</span>
        </h1>

        <p class="text-slate-600 dark:text-slate-400 text-base sm:text-xl max-w-2xl mx-auto leading-relaxed">
          Bloom Cloud compiles Dart AOT bytecode patches and deploys directly to physical iOS & Android devices in milliseconds—bypassing App Store queues completely.
        </p>
      </div>

      <!-- High-End Interactive Vercel / Linear Deployment Dashboard Island -->
      <div>
        <VercelShipDashboard client:visible />
      </div>

    </div>
  </Section>

  <!-- Configuration & CLI Orchestration -->
  <Section id="ship-cli">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
        Declarative Release Management
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        Manage deployment environments, channel promotions, and rollout rules directly in config or via the CLI.
      </p>
    </div>

    {/* Interactive OTA Release Playground */}
    <OTAReleasePlayground client:visible />
  </Section>

  <!-- Wireless Dev & QR Install Workflows -->
  <Section id="dev-workflows">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
        Wireless Development &amp; Instant QR Installs
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        Eliminate tethering friction with wireless device pairing and instant QR build previews.
      </p>
    </div>

    {/* Interactive Wireless Pairing & QR Visualizer */}
    <WirelessQRVisualizer client:visible />
  </Section>

  <!-- Programmatic Update API -->
  <Section id="ota-api">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
        Programmatic Update API
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        Manage silent background downloads, force critical updates, and display custom download indicators.
      </p>
    </div>

    {/* Interactive Programmatic Update API Explorer */}
    <ProgrammaticUpdateExplorer client:visible />
  </Section>

  <!-- Enterprise Architecture Section -->
  <Section id="ota-architecture">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
        Enterprise-Grade OTA Architecture
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        How Bloom updates reach millions of devices securely without app store resubmission.
      </p>
    </div>

    {/* Interactive Enterprise OTA Topology Map */}
    <EnterpriseOTATopology client:visible />
  </Section>

  <!-- Full Platform Overview -->
  <Section id="cloud-platform" className="pt-8">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-900/90 dark:bg-black/90 border border-slate-700/60 dark:border-zinc-800 text-xs font-mono text-slate-300 shadow-md mb-2">
        <span class="font-semibold text-slate-200">BEYOND PATCHES</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
        One Dashboard, The Whole Release Lifecycle
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg">
        OTA patching is one piece. Bloom Cloud is a full delivery platform&mdash;from source to store to your users&rsquo; devices.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-8">
      <GlassPanel variant="interactive" className="p-8">
        <Building2 className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Organizations &amp; Projects</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Multi-tenant hierarchy&mdash;organizations own projects, projects own apps. Every team, client, or product line stays cleanly isolated.
        </p>
      </GlassPanel>

      <GlassPanel variant="interactive" className="p-8">
        <ShieldCheck className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Role-Based Access Control</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Owner, Admin, Developer, and Release Manager roles gate who can approve releases, touch secrets, or manage billing.
        </p>
      </GlassPanel>

      <GlassPanel variant="interactive" className="p-8">
        <ScrollText className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Audit Log &amp; Compliance</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Every build, approval, secret rotation, and rollback is recorded in a searchable, filterable audit trail.
        </p>
      </GlassPanel>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-8">
      <GlassPanel variant="interactive" className="p-8">
        <Cpu className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Remote Build Farm</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Compile iOS, Android, and Web artifacts in the cloud&mdash;no local toolchain, no waiting on a laptop. Live stage-by-stage logs.
        </p>
      </GlassPanel>

      <GlassPanel variant="interactive" className="p-8">
        <GitBranch className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Release Approvals &amp; Rollback</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Staged rollout percentages, gated approvals for Release Managers, changelog diffing, and one-click rollback to any prior version.
        </p>
      </GlassPanel>

      <GlassPanel variant="interactive" className="p-8">
        <Rocket className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Multi-Target Deployments</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Ship the same release to TestFlight, Google Play, and the Web from one pipeline&mdash;with live platform-specific status tracking.
        </p>
      </GlassPanel>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-8">
      <GlassPanel variant="interactive" className="p-8">
        <Settings2 className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Environments</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Pin SDK versions, flavors, and feature flags per environment&mdash;production, staging, and preview stay independently configured.
        </p>
      </GlassPanel>

      <GlassPanel variant="interactive" className="p-8">
        <KeyRound className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Secrets Vault</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Versioned, write-only secrets storage. Plaintext values are never re-rendered after save&mdash;reveal is a fresh, on-demand fetch.
        </p>
      </GlassPanel>

      <GlassPanel variant="interactive" className="p-8">
        <FileKey className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Signing Identity Management</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Keystores, certificates, provisioning profiles, and API keys in one place, with expiry warnings before they lapse.
        </p>
      </GlassPanel>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-8">
      <GlassPanel variant="interactive" className="p-8">
        <Route className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Git Connections</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Connect GitHub, GitLab, or Bitbucket. Branch-to-environment deploy policies and full webhook delivery logs with replay.
        </p>
      </GlassPanel>

      <GlassPanel variant="interactive" className="p-8">
        <Globe className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Web Hosting &amp; Custom Domains</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Host your Flutter Web build directly. Add custom domains with copy-paste DNS records and automatic SSL verification.
        </p>
      </GlassPanel>

      <GlassPanel variant="interactive" className="p-8">
        <Activity className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Observability</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Release health, crash-free rate, and deployment status in real time&mdash;know a rollout is unhealthy before your users complain.
        </p>
      </GlassPanel>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <GlassPanel variant="interactive" className="p-8">
        <Workflow className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Workflow Automation</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Custom pipelines with triggers and approval gates&mdash;chain builds, tests, and deployments into a repeatable release process.
        </p>
      </GlassPanel>

      <GlassPanel variant="interactive" className="p-8">
        <Store className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Template Marketplace</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Buy production-ready app templates or publish your own with seller payouts&mdash;versioned, reviewed, and ready to fork.
        </p>
      </GlassPanel>

      <GlassPanel variant="interactive" className="p-8">
        <CreditCard className="w-8 h-8 text-slate-500 dark:text-slate-400 mb-4" strokeWidth={1.75} />
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Team &amp; Billing</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Usage-based plans, itemized invoices, and seat management scoped per organization&mdash;no surprise overages.
        </p>
      </GlassPanel>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-12">
      <a
        href="https://cloud.bloom.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-sm hover:opacity-90 transition shadow-lg"
      >
        <span>Open Cloud Dashboard</span>
        <ExternalLink className="w-4 h-4" />
      </a>
      <a
        href="/docs/cloud/overview"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-slate-100 dark:bg-zinc-900 text-slate-900 dark:text-white font-bold text-sm hover:bg-slate-200 dark:hover:bg-zinc-800 transition"
      >
        <span>Read the Platform Docs</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>
  </Section>
</Layout>
