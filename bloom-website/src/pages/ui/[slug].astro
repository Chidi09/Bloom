---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/common/Section.astro';
import { ComponentViewer } from '../../components/interactive/ComponentViewer';
import { UI_REGISTRY, UI_CATEGORIES, type UIComponentDoc } from '../../lib/ui-registry';
import { 
  ChevronRight, 
  Terminal, 
  Code2, 
  Sparkles, 
  ArrowLeft, 
  ArrowRight,
  Layers,
  ExternalLink
} from 'lucide-preact';

export function getStaticPaths() {
  return UI_REGISTRY.map((comp) => ({
    params: { slug: comp.slug },
    props: { component: comp },
  }));
}

interface Props {
  component: UIComponentDoc;
}

const { component } = Astro.props;

// Find next and previous components
const currentIndex = UI_REGISTRY.findIndex((c) => c.slug === component.slug);
const prevComp = currentIndex > 0 ? UI_REGISTRY[currentIndex - 1] : null;
const nextComp = currentIndex < UI_REGISTRY.length - 1 ? UI_REGISTRY[currentIndex + 1] : null;
---

<Layout
  title={`${component.title} — Bloom UI Documentation`}
  description={component.description}
  hue="bloom"
  petalHighlight="all"
  nextChapterTitle="Bloom UI Components"
  nextChapterLink="/ui"
  nextChapterSubtitle="Explore all 60+ primitives"
  ogPage="bloom"
>
  <Section reveal={false} className="pt-8 pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb Bar -->
    <nav class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400 mb-8">
      <a href="/" class="hover:text-purple-400 transition">Hub</a>
      <ChevronRight className="w-3 h-3" />
      <a href="/ui" class="hover:text-purple-400 transition">Bloom UI</a>
      <ChevronRight className="w-3 h-3" />
      <span class="text-slate-400">{component.category}</span>
      <ChevronRight className="w-3 h-3" />
      <span class="text-white font-bold">{component.title}</span>
    </nav>

    <!-- Main 2-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Left Sidebar: Component Navigation Tree -->
      <aside class="hidden lg:block lg:col-span-3 space-y-8 sticky top-24 self-start max-h-[calc(100vh-8rem)] overflow-y-auto pr-4">
        {UI_CATEGORIES.map((cat) => {
          const items = UI_REGISTRY.filter((c) => c.category === cat);
          return (
            <div class="space-y-2">
              <h3 class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider">
                {cat}
              </h3>
              <ul class="space-y-1">
                {items.map((item) => (
                  <li>
                    <a
                      href={`/ui/${item.slug}`}
                      class={`block px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                        item.slug === component.slug
                          ? 'bg-purple-600/10 text-purple-400 border border-purple-500/20 font-bold'
                          : 'text-slate-400 hover:text-white hover:bg-slate-900/50'
                      }`}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </aside>

      <!-- Main Content Area -->
      <main class="lg:col-span-9 space-y-10">
        <!-- Component Header -->
        <div class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
              {component.title}
            </h1>
            <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-purple-500/10 text-purple-400 border border-purple-500/20">
              {component.name}
            </span>
          </div>

          <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg leading-relaxed max-w-3xl">
            {component.description}
          </p>

          <!-- CLI Quick Copy -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 font-mono text-xs text-purple-300">
              <Terminal className="w-3.5 h-3.5" />
              <code>{component.cliCommand}</code>
              <button
                onclick={`navigator.clipboard.writeText('${component.cliCommand}'); window.dispatchEvent(new CustomEvent('bloom:toast', { detail: { title: 'Command Copied', message: 'Ready to run in terminal.', type: 'emerald' } }))`}
                class="ml-2 text-slate-400 hover:text-white"
                title="Copy Command"
              >
                📋
              </button>
            </div>

            <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 font-mono text-xs text-pink-300">
              <code>package: {component.pubPackage}</code>
            </div>
          </div>
        </div>

        <!-- Interactive Viewer with Mobile & Web Previews -->
        <div class="space-y-4">
          <ComponentViewer client:load component={component} />
        </div>

        <!-- Prev / Next Navigation Footer -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-10 border-t border-slate-200 dark:border-slate-800">
          {prevComp ? (
            <a
              href={`/ui/${prevComp.slug}`}
              class="flex items-center gap-3 p-4 rounded-2xl bg-slate-950/60 border border-slate-800 hover:border-purple-500/50 transition group"
            >
              <ArrowLeft className="w-4 h-4 text-purple-400 transform group-hover:-translate-x-1 transition-transform" />
              <div>
                <div class="text-[10px] font-mono text-slate-500 uppercase">Previous Component</div>
                <div class="text-sm font-bold text-white group-hover:text-purple-300 transition">
                  {prevComp.title}
                </div>
              </div>
            </a>
          ) : <div />}

          {nextComp ? (
            <a
              href={`/ui/${nextComp.slug}`}
              class="flex items-center justify-between p-4 rounded-2xl bg-slate-950/60 border border-slate-800 hover:border-purple-500/50 transition group text-right"
            >
              <div>
                <div class="text-[10px] font-mono text-slate-500 uppercase">Next Component</div>
                <div class="text-sm font-bold text-white group-hover:text-purple-300 transition">
                  {nextComp.title}
                </div>
              </div>
              <ArrowRight className="w-4 h-4 text-purple-400 transform group-hover:translate-x-1 transition-transform" />
            </a>
          ) : <div />}
        </div>
      </main>

    </div>
  </Section>
</Layout>
