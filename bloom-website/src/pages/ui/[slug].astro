---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/common/CodeBlock.astro';
import { ComponentViewer } from '../../components/interactive/ComponentViewer';
import { UI_REGISTRY, type UIComponentDoc } from '../../lib/ui-registry';
import { 
  Terminal, 
  Code2, 
  Sparkles, 
  ArrowLeft, 
  ArrowRight,
  Layers,
  ExternalLink,
  Copy
} from 'lucide-preact';

export function getStaticPaths() {
  return UI_REGISTRY.map((comp) => ({
    params: { slug: comp.slug },
    props: { component: comp },
  }));
}

interface Props {
  component: UIComponentDoc;
}

const { component } = Astro.props;

// Find next and previous components
const currentIndex = UI_REGISTRY.findIndex((c) => c.slug === component.slug);
const prevComp = currentIndex > 0 ? UI_REGISTRY[currentIndex - 1] : null;
const nextComp = currentIndex < UI_REGISTRY.length - 1 ? UI_REGISTRY[currentIndex + 1] : null;
---

<DocsLayout
  title={component.title}
  description={component.description}
  currentSlug={component.slug}
  category={component.category}
  toc={[
    { id: 'preview', title: 'Interactive Preview' },
    { id: 'installation', title: 'Installation' },
    { id: 'usage', title: 'Usage' },
    { id: 'api', title: 'API & Properties' },
  ]}
>
  <div class="space-y-12 min-w-0">
    <!-- Component Header -->
    <div id="overview" class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          {component.title}
        </h1>
        <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">
          {component.name}
        </span>
      </div>

      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg leading-relaxed max-w-3xl">
        {component.description}
      </p>

      <!-- CLI Quick Copy & Pub link -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 font-mono text-xs text-purple-300">
          <Terminal className="w-3.5 h-3.5" />
          <code>{component.cliCommand}</code>
          <button
            onclick={`navigator.clipboard.writeText('${component.cliCommand}'); window.dispatchEvent(new CustomEvent('bloom:toast', { detail: { title: 'Command Copied', message: 'Ready to run in terminal.', type: 'emerald' } }))`}
            class="ml-2 text-slate-400 hover:text-white p-1 rounded-md transition"
            title="Copy Command"
          >
            <Copy className="w-3.5 h-3.5" />
          </button>
        </div>

        <a
          href="https://pub.dev/packages/bloom_ui"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 font-mono text-xs text-pink-300 hover:text-white transition"
        >
          <span>package: {component.pubPackage}</span>
          <ExternalLink className="w-3 h-3" />
        </a>
      </div>
    </div>

    <!-- Interactive Viewer with Mobile & Web Previews -->
    <div id="preview" class="space-y-4">
      <ComponentViewer client:load component={component} />
    </div>

    <!-- Usage Code Section -->
    <section id="usage" class="space-y-4 pt-4 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Usage
      </h2>
      <CodeBlock code={component.usageCode} lang="dart" filename={`${component.name}.dart`} />
    </section>

    <!-- Prev / Next Navigation Footer -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-10 border-t border-slate-200 dark:border-slate-800">
      {prevComp ? (
        <a
          href={`/ui/${prevComp.slug}`}
          class="flex items-center gap-3 p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 hover:border-purple-500/50 transition group"
        >
          <ArrowLeft className="w-4 h-4 text-purple-500 transform group-hover:-translate-x-1 transition-transform" />
          <div>
            <div class="text-[10px] font-mono text-slate-500 uppercase">Previous Component</div>
            <div class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-purple-400 transition">
              {prevComp.title}
            </div>
          </div>
        </a>
      ) : <div />}

      {nextComp ? (
        <a
          href={`/ui/${nextComp.slug}`}
          class="flex items-center justify-between p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 hover:border-purple-500/50 transition group text-right"
        >
          <div>
            <div class="text-[10px] font-mono text-slate-500 uppercase">Next Component</div>
            <div class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-purple-400 transition">
              {nextComp.title}
            </div>
          </div>
          <ArrowRight className="w-4 h-4 text-purple-500 transform group-hover:translate-x-1 transition-transform" />
        </a>
      ) : <div />}
    </div>
  </div>
</DocsLayout>
