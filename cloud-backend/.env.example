# Bloom Cloud backend — environment configuration
# Generated from src/settings.rs. Placeholders only; never commit real secrets.
# Variables are {PREFIX}_{FIELD}. Commented-out lines are optional (Option<T>).
# Lines with a value shown are the built-in default.

# ----------------------------------------------------------------------
# BloomSettings
# ----------------------------------------------------------------------
# PostgreSQL database connection URL.
BLOOM_DATABASE_URL=CHANGEME
# Redis connection URL for caching, queues, and pub/sub.
BLOOM_REDIS_URL=CHANGEME
# Public URL for the Bloom Cloud API.
BLOOM_API_URL=CHANGEME
# Secret key used for signing and verifying JWT tokens.
BLOOM_JWT_SECRET=CHANGEME
# Timeout in seconds before an uncompleted claimed worker job is returned to the queue.
BLOOM_WORKER_CLAIM_TIMEOUT_SECS=30
# Master key (base64) for AES-256-GCM encryption of secrets and credentials. Consumed by `crate::infra::crypto`.
# BLOOM_ENCRYPTION_MASTER_KEY=
# Active encryption key version, used as the ciphertext version prefix so old ciphertext stays decryptable across key rotations.
BLOOM_ENCRYPTION_KEY_VERSION=v1
# Optional Sentry DSN for error reporting.
# BLOOM_SENTRY_DSN=

# ----------------------------------------------------------------------
# ObjectStorageSettings
# ----------------------------------------------------------------------
# S3/R2 endpoint URL. For R2 this is the account-specific endpoint.
# BLOOM_S3_ENDPOINT=
# Bucket holding build artifacts, logs, and web deploy bundles.
# BLOOM_S3_BUCKET=
# Access key id.
# BLOOM_S3_ACCESS_KEY_ID=
# Secret access key.
# BLOOM_S3_SECRET_ACCESS_KEY=
# Region. R2 uses `auto`.
BLOOM_S3_REGION=auto
# Lifetime in seconds for generated presigned download URLs.
BLOOM_S3_PRESIGN_EXPIRY_SECS=900

# ----------------------------------------------------------------------
# ZeptoMailSettings
# ----------------------------------------------------------------------
# ZeptoMail send-mail API token (the `Zoho-enczapikey ...` value).
# BLOOM_ZEPTOMAIL_API_TOKEN=
# API base URL; differs between the .com and .eu data centres.
BLOOM_ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# Verified sender address.
# BLOOM_ZEPTOMAIL_FROM_ADDRESS=
# Display name on outbound mail.
BLOOM_ZEPTOMAIL_FROM_NAME=Bloom Cloud
# When false, the mailer logs the message instead of sending it. Intended for local development so no real mail leaves the machine.
BLOOM_ZEPTOMAIL_ENABLED=false

# ----------------------------------------------------------------------
# CloudflareSettings
# ----------------------------------------------------------------------
# API token with DNS edit and cache purge scopes.
# BLOOM_CLOUDFLARE_API_TOKEN=
# Zone id for the Bloom-managed apex domain.
# BLOOM_CLOUDFLARE_ZONE_ID=
# Account id, required by the R2 and Pages APIs.
# BLOOM_CLOUDFLARE_ACCOUNT_ID=
# Apex domain under which preview and production app URLs are issued.
# BLOOM_CLOUDFLARE_APEX_DOMAIN=

# ----------------------------------------------------------------------
# CaddySettings
# ----------------------------------------------------------------------
# Caddy admin API endpoint.
BLOOM_CADDY_ADMIN_URL=http://localhost:2019
# Optional bearer token if the admin API is protected.
# BLOOM_CADDY_ADMIN_TOKEN=
# Email used for ACME/Let's Encrypt certificate registration.
# BLOOM_CADDY_ACME_EMAIL=

# ----------------------------------------------------------------------
# BachsSettings
# ----------------------------------------------------------------------
# Bachs secret key, passed to `BachsProvider::new`.
# BLOOM_BACHS_SECRET_KEY=
# Override the API base URL. Unset uses the provider default (`https://api.bachs.io`); use `BachsProvider::sandbox` for test mode.
# BLOOM_BACHS_BASE_URL=
# Secret used to verify inbound webhook signatures. Webhooks whose signature does not verify must be rejected before any state change.
# BLOOM_BACHS_WEBHOOK_SECRET=
# When false, Bachs is not offered as a payment method.
BLOOM_BACHS_ENABLED=false

# ----------------------------------------------------------------------
# PaystackSettings
# ----------------------------------------------------------------------
# Paystack secret key, passed to `PaystackProvider::new`.
# BLOOM_PAYSTACK_SECRET_KEY=
# Override the API base URL; unset uses the provider default.
# BLOOM_PAYSTACK_BASE_URL=
# Secret used to verify inbound webhook signatures.
# BLOOM_PAYSTACK_WEBHOOK_SECRET=
# When false, Paystack is not offered as a payment method.
BLOOM_PAYSTACK_ENABLED=false

# ----------------------------------------------------------------------
# ShorebirdSettings
# ----------------------------------------------------------------------
# Shorebird API base URL.
BLOOM_SHOREBIRD_API_URL=https://api.shorebird.dev
# Shorebird auth token used by the deploy worker to publish patches.
# BLOOM_SHOREBIRD_API_TOKEN=

# ----------------------------------------------------------------------
# GooglePlaySettings
# ----------------------------------------------------------------------
# Android Publisher API base URL.
BLOOM_GPLAY_API_URL=https://androidpublisher.googleapis.com
# Path to a platform-level service-account JSON, when one is used.
# BLOOM_GPLAY_SERVICE_ACCOUNT_JSON_PATH=

# ----------------------------------------------------------------------
# TestFlightSettings
# ----------------------------------------------------------------------
# App Store Connect API base URL.
BLOOM_TESTFLIGHT_API_URL=https://api.appstoreconnect.apple.com
# Issuer id for the App Store Connect API key.
# BLOOM_TESTFLIGHT_ISSUER_ID=
# Key id for the App Store Connect API key.
# BLOOM_TESTFLIGHT_KEY_ID=
# Private key (PEM) for the App Store Connect API key.
# BLOOM_TESTFLIGHT_PRIVATE_KEY=

# ----------------------------------------------------------------------
# GitHubSettings
# ----------------------------------------------------------------------
# GitHub App id.
# BLOOM_GITHUB_APP_ID=
# GitHub App private key (PEM) used to mint installation tokens.
# BLOOM_GITHUB_APP_PRIVATE_KEY=
# OAuth client id, for "Connect GitHub" in the dashboard.
# BLOOM_GITHUB_OAUTH_CLIENT_ID=
# OAuth client secret.
# BLOOM_GITHUB_OAUTH_CLIENT_SECRET=
# Shared secret used to verify inbound webhook signatures. Webhooks whose signature does not verify must be rejected.
# BLOOM_GITHUB_WEBHOOK_SECRET=
# API base URL; override for GitHub Enterprise.
BLOOM_GITHUB_API_URL=https://api.github.com

# ----------------------------------------------------------------------
# GoogleAuthSettings
# ----------------------------------------------------------------------
# OAuth 2.0 client id.
# BLOOM_GOOGLE_AUTH_CLIENT_ID=
# OAuth 2.0 client secret.
# BLOOM_GOOGLE_AUTH_CLIENT_SECRET=
# Redirect URI registered with Google; must match exactly.
# BLOOM_GOOGLE_AUTH_REDIRECT_URI=
# When false, Google sign-in is not offered.
BLOOM_GOOGLE_AUTH_ENABLED=false
