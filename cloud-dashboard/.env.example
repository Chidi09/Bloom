# Origin only — the BFF proxy route appends /api/v1 itself (see src/app/api/bff/[...path]/route.ts)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# "enabled" runs MSW in the browser instead of hitting the BFF/backend — see src/mocks/.
NEXT_PUBLIC_API_MOCKING=disabled
