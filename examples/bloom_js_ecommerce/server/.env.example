# Application Environment (local | development | production)
APP_ENV=local

# HTTP Server Port
PORT=8080

# PostgreSQL Database Connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bloom_ecommerce

# Authentication Signing Secret (minimum 32 characters for HMAC-SHA256)
BLOOM_AUTH_SECRET=bloom-super-secure-jwt-signing-secret-key-32chars
