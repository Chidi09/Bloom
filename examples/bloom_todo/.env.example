# .env.example — bloom_todo environment configuration template
#
# Copy this file to .env (for local development) and fill in real values.
# Never commit .env to version control.
#
#   cp .env.example .env
#
# For CI/CD, inject these as encrypted environment variables / secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string used by the Drift ORM on the server.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://bloom_todo:changeme@localhost:5432/bloom_todo_dev

# ── Cache / Pub-Sub ───────────────────────────────────────────────────────────

# Redis connection string for session caching, rate limiting, and real-time
# pub-sub between server instances.
# Format: redis://[:<password>@]<host>:<port>[/<db>]
REDIS_URL=redis://localhost:6379/0

# ── Authentication ────────────────────────────────────────────────────────────

# HS256 secret used to sign and verify JSON Web Tokens.
# Minimum 32 characters; generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Number of hours before an issued JWT access token expires.
JWT_EXPIRY_HOURS=24

# ── OTA Updates (Shorebird) ───────────────────────────────────────────────────

# Authentication token for the Shorebird CLI. Obtain from:
# https://console.shorebird.dev -> Account -> API Keys
SHOREBIRD_TOKEN=your_shorebird_token_here

# ── Email (SendGrid) ──────────────────────────────────────────────────────────

# SendGrid API key used to send transactional email (welcome, password reset,
# task reminders, etc.).
# https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.replace_with_your_sendgrid_api_key

# ── Push Notifications ────────────────────────────────────────────────────────

# Firebase Cloud Messaging server key for Android/Web push notifications.
# Found in the Firebase console -> Project Settings -> Cloud Messaging.
FCM_SERVER_KEY=AAAA_replace_with_your_fcm_server_key

# Absolute path to the Apple Push Notification Service (.p8) certificate
# used for iOS push notifications via the APNs HTTP/2 provider API.
APNS_CERT_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# Apple Developer Team ID and APNs Key ID (required alongside APNS_CERT_PATH).
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_KEY_ID=YOUR_APNS_KEY_ID

# ── Application URLs ──────────────────────────────────────────────────────────

# Public base URL of the web/mobile app (used in emails, deep links, etc.).
APP_URL=http://localhost:3000

# Public base URL of the Bloom API server.
API_URL=http://localhost:8080

# ── Error Tracking (Sentry) ───────────────────────────────────────────────────

# Sentry Data Source Name. Obtain from: https://sentry.io -> Project -> Settings
# Leave empty to disable Sentry in development.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Payments (Stripe) ─────────────────────────────────────────────────────────

# Stripe secret key for server-side payment processing (subscriptions, etc.).
# Use sk_test_... keys for development and sk_live_... for production.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key

# Stripe webhook signing secret used to verify incoming webhook payloads.
# Obtain from: https://dashboard.stripe.com/webhooks -> Endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# ── Feature Flags (optional) ──────────────────────────────────────────────────

# Set to 'true' to enable the experimental AI-powered task suggestions feature.
FEATURE_AI_SUGGESTIONS=false

# ── Logging ───────────────────────────────────────────────────────────────────

# Minimum log level for the server. One of: debug | info | warning | error
LOG_LEVEL=debug
