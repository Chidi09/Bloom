# .gitignore — bloom_todo monorepo
# Covers: Dart, Flutter, Bloom framework, Melos, Docker, IDE, and OS files.

# ── Secrets & Environment ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.keystore
google-services.json
GoogleService-Info.plist

# ── Dart ──────────────────────────────────────────────────────────────────────
.dart_tool/
.packages
build/
doc/api/

# Generated files — excluded workspace-wide; opt-in per-package via local
# .gitignore overrides if the package owner chooses to commit them.
*.g.dart
*.freezed.dart
*.gr.dart
*.gen.dart
*.mocks.dart
*.config.dart

# Coverage reports
coverage/
lcov.info

# ── pubspec.lock ──────────────────────────────────────────────────────────────
# Lock files for *apps* are excluded (CI rebuilds from scratch).
# Lock files for *packages* ARE committed for reproducible dependency baselines.
apps/mobile/pubspec.lock
apps/web/pubspec.lock
apps/server/pubspec.lock

# ── Flutter ───────────────────────────────────────────────────────────────────
/apps/mobile/android/local.properties
/apps/mobile/android/.gradle/
/apps/mobile/android/app/debug/
/apps/mobile/android/app/profile/
/apps/mobile/android/app/release/
/apps/mobile/android/captures/
/apps/mobile/android/key.properties

/apps/mobile/ios/.symlinks/
/apps/mobile/ios/Flutter/flutter_export_environment.sh
/apps/mobile/ios/Pods/
/apps/mobile/ios/Runner.xcworkspace/
/apps/mobile/ios/Flutter/ephemeral/
/apps/mobile/ios/Flutter/App.framework
/apps/mobile/ios/Flutter/Flutter.framework
/apps/mobile/ios/Flutter/Flutter.podspec
/apps/mobile/ios/Flutter/Generated.xcconfig

/apps/web/build/

# ── Melos ─────────────────────────────────────────────────────────────────────
.melos_tool/
melos_overrides.yaml
**/pubspec_overrides.yaml

# ── Shorebird ─────────────────────────────────────────────────────────────────
.shorebird/

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml
.docker/

# ── IDEs & Editors ────────────────────────────────────────────────────────────
# VS Code — keep recommended extensions and launch configs
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws
out/
.fleet/

# Vim / Neovim
*.swp
*.swo
*~
.vim/

# Emacs
*#
.\#*

# ── Operating System ──────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# ── Node / npm (tooling scripts) ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json

# ── Logs & Temp ───────────────────────────────────────────────────────────────
*.log
*.tmp
*.temp
tmp/
temp/

# ── Test Artefacts ────────────────────────────────────────────────────────────
test-results/
junit*.xml

# ── Miscellaneous ─────────────────────────────────────────────────────────────
*.orig
*.bak
.sass-cache/
